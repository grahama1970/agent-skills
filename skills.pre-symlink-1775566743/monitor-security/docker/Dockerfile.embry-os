FROM python:3.11-slim

LABEL maintainer="embry-os" \
      description="Self-hack container for monitor-security"

# Install system packages for security scanning
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install Python security tools
RUN pip install --no-cache-dir \
    semgrep \
    bandit \
    pip-audit \
    safety \
    gitleaks-py 2>/dev/null || true

# Install Node security tools
RUN npm install -g npm-audit-resolver 2>/dev/null || true

WORKDIR /embry-os

# Copy embry-os source (mounted at build time or via volume)
# In self-hack mode, the source is mounted read-only:
#   docker run -v /path/to/embry-os:/embry-os:ro
COPY . /embry-os/ 2>/dev/null || true

# Default: run semgrep with OWASP rules
CMD ["semgrep", "scan", "--config", "/embry-os/skills/monitor-security/rules/owasp_llm_top10.yaml", "/embry-os"]
