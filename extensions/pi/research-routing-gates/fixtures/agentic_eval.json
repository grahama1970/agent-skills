{
  "version": 2,
  "skill": "research-routing-gates-pi-extension",
  "trials": 2,
  "proof_scope": "Runner-real-world Pi extension scenarios: commands invoke the extension checker script and load the Pi extension hook module, with readback artifacts for each route decision including MVP-first and fast broad-error gates, local ops completion wording that mentions current/today without external-research intent, and guard interlock exemptions for shame notices, continuation prompts, and empty assistant tool turns, and typo status questions, including the exact cross-project status-updates wording that triggered the live retry loop.",
  "claims": {
    "proves": "The fixture runs real command scenarios against the research-routing-gates extension code path: production checker decisions, broad-error fast single-call routing, MVP-first mvp/ artifact gating, local ops completion wording that should not require web research, and a Pi message_end hook simulation with artifact readback, plus guard interlock exemptions that prevent generated shame/research/continuation text and empty tool-call turns from becoming new gate targets.",
    "does_not_prove": "A live Pi /reload has loaded the extension, real browser/provider Ask transport, or semantic quality of model advice."
  },
  "capability_claims": [
    {
      "id": "research_routing.status_plain_spoken_exemption",
      "description": "Plain status questions are not converted into self-rejecting Memory/Ask gate notices.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.skill_selection",
      "description": "The checker distinguishes Brave for narrow current research, Dogpile for comprehensive research, Ask roundtable for side-quest thrash, and Ask compete for isolated MVP candidate choices.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.pi_hook_rejection",
      "description": "The Pi extension hook emits a deterministic rejection and one retry prompt when a required Ask compete gate is missing.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.mvp_first_gate",
      "description": "MVP-first or unproven integration-seam requests require project mvp/ proof artifacts before broad implementation.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.fast_single_before_slow_panel",
      "description": "Broad/generic/ambiguous error escalation requires a fast non-browser low-reasoning Ask/Tau single-call before slow WebGPT or roundtable escalation.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.combined_bash_evidence",
      "description": "A single bash tool call containing Memory, Brave, and triage-error commands records each evidence kind instead of only the first match.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.multi_tool_evidence",
      "description": "A multi_tool_use.parallel wrapper containing nested bash commands records each evidence kind instead of hiding Memory, Brave, or Ask/Tau evidence from the guard.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.guard_interlock_exemption",
      "description": "Generated guard notices, forced retries, continuation prompts, and tool-call-only empty assistant turns are not converted into new research-routing gate failures.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.retry_evidence_window",
      "description": "A generated research-routing retry starts a fresh evidence window while preserving the original user task for route classification.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.concise_retry_receipt",
      "description": "Research-routing follow-up prompts keep full gate JSON in a /tmp receipt and show only missing gates, one next command, and the receipt path in chat.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.status_json_first_meta_exemption",
      "description": "JSON-first status report and research-routing gate design questions are treated as status/meta questions, not as requests for Brave/WebGPT gates because those words appear in the answer.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.meta_questions_skip_memory_first",
      "description": "Meta questions about routing-gate naming or guard design do not require Memory-first evidence and therefore cannot fail from stale scan observations.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "research_routing.guard_purpose_complaints_skip_memory_first",
      "description": "Complaints about the obvious-next-step guard purpose are classified as status/control questions, so stale scans cannot force a Memory-first retry loop.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    }
  ],
