      "evidence_class": "deterministic",
      "supports_claims": [
        "best_practices_react.data_qid_source_verifier"
      ],
      "seams": [
        "react.data_qid_source_contract"
      ],
      "command": [
        "python3",
        "../scripts/verify-data-qid-fixtures.py",
        "--include-sanity",
        "--output",
        "/tmp/best-practices-react-agentic-data-qid.json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "PASS_DATA_QID_FIXTURES"
        ],
        "artifacts": [
          {
            "path": "/tmp/best-practices-react-agentic-data-qid.json",
            "json_pointer": "/status",
            "equals": "PASS_DATA_QID_FIXTURES"
          }
        ]
      }
    },
    {
