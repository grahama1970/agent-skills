        "best_practices_react.openai_operator_surface"
      ],
      "seams": [
        "react.openai_data_qid"
      ],
      "command": [
        "bash",
        "-c",
        "cat > /tmp/check_openai_react.py <<'PYCODE'\nfrom pathlib import Path\ntext='\\n'.join(p.read_text() for p in Path('/home/graham/workspace/experiments/openai-interview/web/src').rglob('*.tsx'))\nassert 'data-qid' in text and 'data-qs-action' in text and 'title=' in text\nprint('OPENAI_REACT_SOURCE_OK')\nPYCODE\npython3 /tmp/check_openai_react.py && cd /home/graham/workspace/experiments/openai-interview/web && npm run --silent test && npm run --silent verify:data-qid && grep -R 'data-qs-action' -n src && grep -R 'title=' -n src"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "OK:",
          "data-qs-action",
          "title="
        ]
      },
      "timeout_seconds": 120
    },
