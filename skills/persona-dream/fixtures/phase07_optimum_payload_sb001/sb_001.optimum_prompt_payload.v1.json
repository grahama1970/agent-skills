    "composition_priority": [
      "1_identity_readability",
      "2_correct_character_roles",
      "3_story_action_waiting_outside_takeoff_path",
      "4_public_reef_break_context",
      "5_lava_reef_and_glare"
    ],
    "identity_slot_map": {
