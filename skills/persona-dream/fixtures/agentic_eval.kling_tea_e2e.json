      "command": [
        "bash",
        "-c",
        "set -euo pipefail\nOUT=/tmp/persona-dream-kling-tea-e2e-agentic-live\nrm -rf \"$OUT\"\nuv run --project .. python ../scripts/eval_kling_tea_e2e.py --out-dir \"$OUT\""
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["PASS_KLING_TEA_E2E"],
        "artifacts": [
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/KlingTeaE2E.RECEIPT.json", "json_pointer": "/status", "equals": "PASS_KLING_TEA_E2E"},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/KlingTeaE2E.RECEIPT.json", "json_pointer": "/live", "equals": true},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/KlingTeaE2E.RECEIPT.json", "json_pointer": "/mocked", "equals": false},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/kling_request.json", "json_pointer": "/model_id", "equals": "fal-ai/kling-video/v3/standard/image-to-video"},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/kling_reference_binding_receipt.json", "json_pointer": "/status", "equals": "PASS_REFERENCE_BOUND_KLING_REQUEST"},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/kling_reference_binding_receipt.json", "json_pointer": "/element_count", "equals": 3},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/kling_dream.mp4", "min_bytes": 100000},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/journal.wav", "min_bytes": 10000},
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-live/dynamic_conversation_receipt.v1.json", "json_pointer": "/status", "equals": "PASS_DYNAMIC_CONVERSATION"}
        ]
      }
    },
    {
      "name": "kling-tea-e2e-dry-run-cannot-pass",
      "type": "adversarial",
      "evidence_class": "adversarial_live_e2e",
      "real_world": true,
      "supports_claims": ["persona_dream.kling_tea_e2e"],
      "command": [
        "bash",
        "-c",
        "set -euo pipefail\nOUT=/tmp/persona-dream-kling-tea-e2e-agentic-dry-run\nrm -rf \"$OUT\"\nuv run --project .. python ../scripts/eval_kling_tea_e2e.py --out-dir \"$OUT\" --dry-run"
      ],
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["BLOCKED_DRY_RUN_NOT_E2E"],
        "artifacts": [
          {"path": "/tmp/persona-dream-kling-tea-e2e-agentic-dry-run/receipts/kling_dream_video.json", "json_pointer": "/status", "equals": "BLOCKED_DRY_RUN_NOT_E2E"}
        ]
