{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/provider_media_lock_receipt.schema.json",
  "title": "Provider Media Lock Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "provider_accessible",
    "live_provider_call_made",
    "media"
  ],
  "properties": {
    "schema": {
      "const": "persona_dream.provider_media_lock_receipt.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["LOCAL_MEDIA_LOCK_READY", "PROVIDER_MEDIA_READY", "BLOCKED"]
    },
    "provider_accessible": {
      "type": "boolean"
    },
    "live_provider_call_made": {
      "const": false
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "local_path", "url_path", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "url_path": {
            "type": "string",
            "pattern": "^/.+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
