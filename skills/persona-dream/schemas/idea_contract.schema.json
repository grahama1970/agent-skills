{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona_dream.idea_contract.v1",
  "type": "object",
  "required": ["schema", "artifact_id", "status", "created_at", "source_mode", "idea", "inputs_considered", "codebase_question_protocol", "selection_policy"],
  "properties": {
    "schema": {"const": "persona_dream.idea_contract.v1"},
    "artifact_id": {"type": "string"},
    "status": {"type": "string"},
    "created_at": {"type": "string"},
    "source_mode": {"enum": ["autonomous_memory_project_synthesis", "human_supplied_seed", "project_agent_supplied_seed"]},
    "idea": {"type": "string", "minLength": 1},
    "inputs_considered": {"type": "array", "minItems": 1},
    "codebase_question_protocol": {"type": "object"},
    "selection_policy": {"type": "array", "minItems": 1}
  }
}
