{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona_dream.voice_candidate_bundle.v1",
  "title": "Persona Dream Voice Candidate Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "created_at",
    "mocked",
    "live",
    "required_characters",
    "search_policy",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "persona_dream.voice_candidate_bundle.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "mocked": {
      "type": "boolean"
    },
    "live": {
      "type": "boolean"
    },
    "required_characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "search_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_first",
        "brave_search_allowed",
        "youtube_ingest_allowed",
        "human_final_curation_required"
      ],
      "properties": {
        "memory_first": {
          "const": true
        },
        "brave_search_allowed": {
          "type": "boolean"
        },
        "youtube_ingest_allowed": {
          "type": "boolean"
        },
        "human_final_curation_required": {
          "type": "boolean"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "character_id",
        "source_kind",
        "source_title",
        "source_provenance_note",
        "rights_note",
        "extracted_audio_path",
        "duration_seconds",
        "speaker_identity_confidence",
        "audio_quality",
        "chatterbox_demo"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "character_id": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "type": "string",
          "enum": ["memory", "provided", "youtube", "local_file", "synthetic"]
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": ["string", "null"]
        },
        "source_path": {
          "type": ["string", "null"]
        },
        "source_provenance_note": {
          "type": "string",
          "minLength": 1
        },
        "rights_note": {
          "type": "string",
          "minLength": 1
        },
        "extracted_audio_path": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transcript_sample": {
          "type": ["string", "null"]
        },
        "speaker_identity_confidence": {
          "type": "string",
          "enum": ["known", "likely", "ambiguous", "unknown", "synthetic"]
        },
        "audio_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snr_label",
            "overlap_detected",
            "music_bed_detected",
            "crowd_noise_detected",
            "compression_issue_detected"
          ],
          "properties": {
            "snr_label": {
              "type": "string",
              "enum": ["excellent", "good", "usable", "poor", "rejected"]
            },
            "overlap_detected": {
              "type": "boolean"
            },
            "music_bed_detected": {
              "type": "boolean"
            },
            "crowd_noise_detected": {
              "type": "boolean"
            },
            "compression_issue_detected": {
              "type": "boolean"
            }
          }
        },
        "chatterbox_demo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demo_text",
            "demo_wav_path",
            "demo_receipt_path",
            "tone",
            "delivery_stage",
            "pace",
            "pause_strategy",
            "chatterbox_tags"
          ],
          "properties": {
            "demo_text": {
              "type": "string",
              "minLength": 1
            },
            "demo_wav_path": {
              "type": "string",
              "minLength": 1
            },
            "demo_receipt_path": {
              "type": "string",
              "minLength": 1
            },
            "tone": {
              "$ref": "#/$defs/tone"
            },
            "delivery_stage": {
              "$ref": "#/$defs/delivery_stage"
            },
            "pace": {
              "$ref": "#/$defs/pace"
            },
            "pause_strategy": {
              "$ref": "#/$defs/pause_strategy"
            },
            "chatterbox_tags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["[chuckle]", "[sigh]", "[gasp]", "[whispering]", "[laugh]"]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "tone": {
      "type": "string",
      "enum": [
        "neutral_warm",
        "calm_precise",
        "careful_concerned",
        "serious_low_energy",
        "memory_confident",
        "memory_uncertain",
        "curious_searching",
        "playful_light",
        "relieved",
        "firm_boundary",
        "identity_clarification",
        "one_at_a_time_interrupt",
        "deflect_calm",
        "grief_safe",
        "wait_presence"
      ]
    },
    "delivery_stage": {
      "type": "string",
      "enum": [
        "setup",
        "slightly_concerned",
        "neutral",
        "positive",
        "satisfied",
        "clarify",
        "boundary",
        "interrupted",
        "deflect",
        "wait"
      ]
    },
    "pace": {
      "type": "string",
      "enum": ["brief", "measured", "slow_careful", "quick_light", "firm_short"]
    },
    "pause_strategy": {
      "type": "string",
      "enum": [
        "short_answer_no_filler",
        "chunk_pause_150_350ms",
        "careful_setup_pause",
        "clarify_direct_no_completion",
        "boundary_stop_then_prompt",
        "wait_filler_then_progress",
        "hum_duck_on_speech"
      ]
    }
  }
}
