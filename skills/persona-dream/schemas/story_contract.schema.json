    "created_at": {"type": "string"},
    "input_idea_contract": {"type": "string"},
    "seed": {"type": "string", "minLength": 1},
    "story": {"type": "string", "minLength": 1},
    "target_duration_s": {"type": "number"},
    "speaking_characters": {"type": "array", "minItems": 1}
  }
}
