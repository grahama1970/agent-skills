{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona_dream.kling_scene_payloads.v1",
  "type": "object",
  "required": ["schema", "artifact_id", "status", "created_at", "provider", "source_storyboard_board", "voice_tag_policy", "panels", "manual_review_required"],
  "properties": {
    "schema": {"const": "persona_dream.kling_scene_payloads.v1"},
    "artifact_id": {"type": "string"},
    "status": {"type": "string"},
    "created_at": {"type": "string"},
    "provider": {"const": "kling"},
    "source_storyboard_board": {"type": "string"},
    "voice_tag_policy": {"type": "object"},
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["panel", "beat_id", "time_range_s", "caption", "shot", "action", "emotional_behavior", "camera", "timing", "dialogue", "provider_text"],
        "properties": {
          "panel": {"type": "integer"},
          "beat_id": {"type": "string"},
          "time_range_s": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          },
          "caption": {"type": "string"},
          "shot": {"type": "string"},
          "action": {"type": "string"},
          "emotional_behavior": {"type": "string", "minLength": 1},
          "camera": {"type": "string", "minLength": 1},
          "timing": {"type": "string", "minLength": 1},
          "dialogue": {"type": "array"},
          "provider_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "manual_review_required": {"type": "boolean"}
  }
}
