{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/storyboard_panel_receipt.schema.json",
  "title": "Storyboard Panel Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "panel_id",
    "status",
    "timing",
    "beat",
    "image",
    "required_visible_entities",
    "required_props",
    "required_environment",
    "required_dynamic_behaviors",
    "continuity_ledger",
    "work_order"
  ],
  "properties": {
    "schema": {
      "const": "persona_dream.storyboard_panel_receipt.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "panel_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["PANEL_READY_FOR_SOURCE_REVIEW", "BLOCKED"]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "beat": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "width", "height"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "required_visible_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_environment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_dynamic_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "continuity_ledger": {
      "type": "string",
      "minLength": 1
    },
    "work_order": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
