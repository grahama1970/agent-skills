{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "persona_dream.tom_candidate.v1",
  "description": "Phase 14 bounded Theory-of-Mind candidate extracted from an accepted Phase 13 interpretation. A candidate is admissible only if a deterministic gate confirms it identifies its subject and target, cites source-memory ids and Watch observation ids that are a subset of its parent accepted interpretation, and carries confidence, emotional intensity, and synthetic origin. LLM proposes; code decides admissibility.",
  "type": "object",
  "required": [
    "schema",
    "candidate_id",
    "parent_interpretation_id",
    "tom_state_type",
    "subject",
    "target",
    "statement",
    "source_memory_refs",
    "watch_observation_refs",
    "confidence",
    "emotional_intensity",
    "synthetic_origin",
    "literal_historical_event"
  ],
  "properties": {
    "schema": { "const": "persona_dream.tom_candidate.v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "parent_interpretation_id": { "type": "string", "minLength": 1 },
    "tom_state_type": {
      "type": "string",
      "enum": [
        "belief",
        "fear",
        "desire",
        "trust",
        "distrust",
        "stance",
        "relationship_state",
        "uncertainty",
        "avoidance",
        "obligation",
        "preference",
        "emotion"
      ]
    },
    "subject": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "source_memory_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "watch_observation_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "emotional_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "alternative_explanation": { "type": "string" },
    "synthetic_origin": { "const": true },
    "literal_historical_event": { "const": false }
  }
}
