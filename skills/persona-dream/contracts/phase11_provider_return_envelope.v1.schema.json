{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/persona-dream/phase11_provider_return_envelope.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "run_id",
    "revision_id",
    "source_revision_id",
    "activation_transaction_id",
    "endpoint",
    "request_id",
    "request_body_sha256",
    "provider_result_sha256",
    "video_url",
    "download_receipt_relative_path",
    "download_receipt_sha256",
    "downloaded_mp4_sha256",
    "poll_count",
    "actual_provider_call_attempts",
    "provider_live",
    "submitted",
    "watch_started"
  ],
  "properties": {
    "schema": {"const": "persona_dream.phase11_provider_return_envelope.v1"},
    "status": {"const": "PASS_PHASE11_PROVIDER_RETURN_RECEIVED"},
    "run_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "source_revision_id": {"type": "string", "minLength": 1},
    "activation_transaction_id": {"type": "string", "pattern": "^activation-[a-f0-9]{32}$"},
    "endpoint": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "request_body_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provider_result_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "video_url": {"type": "string", "pattern": "^https://"},
    "download_receipt_relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|^[A-Za-z]:[\\\\/]|(^|/)\\.\\.(/|$))"}
    },
    "download_receipt_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "downloaded_mp4_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "poll_count": {"type": "integer", "minimum": 1, "maximum": 360},
    "actual_provider_call_attempts": {"const": 1},
    "provider_live": {"const": true},
    "submitted": {"const": true},
    "watch_started": {"const": false}
  },
  "additionalProperties": false
}
