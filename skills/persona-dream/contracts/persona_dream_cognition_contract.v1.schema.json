{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "persona_dream.persona_dream_cognition_contract.v1",
  "description": "Persona/relationship cognition contract consumed by persona-dream phases 13 (self-interpretation), 14 (ToM validation), and 16 (behavior evaluation). It externalizes every persona-specific string - persona id, counterpart ids, relationship descriptors, recall-question templates with slots, protected-identity anchors, and the phase-16 evaluation vocabulary - so the phase source carries no hardcoded persona names. Swapping the fixture that satisfies this schema retargets the cognitive loop to a different persona/relationship lane without editing phase code.",
  "type": "object",
  "required": [
    "schema",
    "contract_id",
    "persona_id",
    "persona_title",
    "default_subject",
    "default_target",
    "counterparts",
    "recall_question_templates",
    "protected_identity_anchors"
  ],
  "properties": {
    "schema": { "const": "persona_dream.persona_dream_cognition_contract.v1" },
    "contract_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "persona_id": { "type": "string", "minLength": 1 },
    "persona_display_name": { "type": "string" },
    "persona_title": { "type": "string", "minLength": 1 },
    "default_subject": { "type": "string", "minLength": 1 },
    "default_target": { "type": "string", "minLength": 1 },
    "counterparts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "relationship_descriptors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "domain": {
      "type": "object",
      "properties": {
        "domain_label": { "type": "string" },
        "activity": { "type": "string" },
        "locus": { "type": "string" },
        "hazard_terms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recall_question_templates": {
      "type": "array",
      "minItems": 1,
      "description": "Recall-question templates with {persona_title} and {counterpart_title} slots filled at runtime.",
      "items": { "type": "string", "minLength": 1 }
    },
    "protected_identity_anchors": {
      "type": "object",
      "required": ["source_memory_ids", "identity_stable_tokens"],
      "properties": {
        "source_memory_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "lineage_probe_memory_id": { "type": "string" },
        "source_memory_key_prefix": { "type": "string" },
        "identity_stable_tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "identity_relationship_anchor_token": { "type": "string" }
      }
    },
    "phase16": {
      "type": "object",
      "required": [
        "dream_key",
        "revision_id",
        "run_id",
        "watch_observation_keys",
        "tom_keys",
        "semantic_recall",
        "user_questions",
        "persona_prompt"
      ],
      "properties": {
        "dream_key": { "type": "string", "minLength": 1 },
        "revision_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "watch_observation_keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tom_keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cognitive_loop_watch_dir": { "type": "string" },
        "dream_markers": { "type": "array", "items": { "type": "string" } },
        "dream_content_tokens": { "type": "array", "items": { "type": "string" } },
        "literal_assertion_patterns": { "type": "array", "items": { "type": "string" } },
        "negate_literal_tokens": { "type": "array", "items": { "type": "string" } },
        "negate_literal_phrases": { "type": "array", "items": { "type": "string" } },
        "semantic_recall": {
          "type": "object",
          "required": ["positive_queries", "negative_query", "grounded_recall_q", "identity_recall_q"],
          "properties": {
            "positive_queries": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
            "negative_query": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
            "grounded_recall_q": { "type": "string", "minLength": 1 },
            "identity_recall_q": { "type": "string", "minLength": 1 }
          }
        },
        "user_questions": {
          "type": "object",
          "required": ["grounded_use", "synthetic_vs_literal", "identity"],
          "properties": {
            "grounded_use": { "type": "string", "minLength": 1 },
            "synthetic_vs_literal": { "type": "string", "minLength": 1 },
            "identity": { "type": "string", "minLength": 1 }
          }
        },
        "persona_prompt": {
          "type": "object",
          "required": [
            "persona_first_person_intro",
            "grounded_use_role_note",
            "synthetic_vs_literal_role_note",
            "identity_role_note"
          ],
          "properties": {
            "persona_first_person_intro": { "type": "string", "minLength": 1 },
            "grounded_use_role_note": { "type": "string", "minLength": 1 },
            "synthetic_vs_literal_role_note": { "type": "string", "minLength": 1 },
            "identity_role_note": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
