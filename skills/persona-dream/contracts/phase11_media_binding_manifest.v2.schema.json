{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/persona-dream/phase11_media_binding_manifest.v2.schema.json",
  "type": "object",
  "required": [
    "schema", "status", "run_id", "revision_id", "activation_transaction_id",
    "media_input_contract_sha256", "role_counts", "storyboard_frames", "element_packs",
    "publication_policy", "blockers", "actual_provider_call_attempts", "provider_live", "submitted"
  ],
  "properties": {
    "schema": {"const": "persona_dream.phase11_media_binding_manifest.v2"},
    "status": {"enum": ["PASS_PHASE11_MEDIA_BINDING_TECHNICAL", "BLOCKED_PROVIDER_GATE"]},
    "run_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "activation_transaction_id": {"type": "string", "pattern": "^activation-[a-f0-9]{32}$"},
    "media_input_contract_sha256": {"$ref": "#/$defs/sha256"},
    "role_counts": {
      "type": "object",
      "required": ["global_start_anchor", "global_end_anchor", "continuity_only", "element_packs"],
      "properties": {
        "global_start_anchor": {"const": 1},
        "global_end_anchor": {"const": 1},
        "continuity_only": {"const": 6},
        "element_packs": {"const": 2}
      }
    },
    "storyboard_frames": {"type": "array", "minItems": 8, "maxItems": 8},
    "element_packs": {"type": "array", "minItems": 2, "maxItems": 2},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "actual_provider_call_attempts": {"const": 0},
    "provider_live": {"const": false},
    "submitted": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
