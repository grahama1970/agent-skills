{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/persona-dream/phase11_attempt_ledger.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "revision_id",
    "activation_transaction_id",
    "endpoint",
    "request_key",
    "request_body_sha256",
    "state",
    "submit_intent_count",
    "actual_provider_call_attempts",
    "request_id",
    "ambiguous_submit",
    "poll_count",
    "created_at",
    "updated_at",
    "history"
  ],
  "properties": {
    "schema": {"const": "persona_dream.phase11_attempt_ledger.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "activation_transaction_id": {"type": "string", "pattern": "^activation-[a-f0-9]{32}$"},
    "endpoint": {"type": "string", "minLength": 1},
    "request_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_body_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "state": {
      "enum": [
        "PREFLIGHT_READY",
        "SUBMIT_INTENT_WRITTEN",
        "SUBMITTED",
        "POLLING",
        "COMPLETED",
        "FAILED",
        "AMBIGUOUS_SUBMIT"
      ]
    },
    "submit_intent_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "actual_provider_call_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
    "request_id": {"type": ["string", "null"]},
    "ambiguous_submit": {"type": "boolean"},
    "poll_count": {"type": "integer", "minimum": 0, "maximum": 360},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event", "at", "actual_provider_call_attempts"],
        "properties": {
          "event": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"},
          "actual_provider_call_attempts": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    },
    "last_error": {"type": "object"},
    "provider_terminal_state": {"type": "string"},
    "provider_return_envelope_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "download_receipt_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "downloaded_mp4_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
