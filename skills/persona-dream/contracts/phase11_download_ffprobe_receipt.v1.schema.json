{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/persona-dream/phase11_download_ffprobe_receipt.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "run_id",
    "revision_id",
    "activation_transaction_id",
    "request_body_sha256",
    "endpoint",
    "request_id",
    "source_url",
    "download_relative_path",
    "downloaded_sha256",
    "size_bytes",
    "content_type",
    "ffprobe",
    "actual_provider_call_attempts"
  ],
  "properties": {
    "schema": {"const": "persona_dream.phase11_download_ffprobe_receipt.v1"},
    "status": {"const": "PASS_PHASE11_PROVIDER_RETURN_DOWNLOADED"},
    "run_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "activation_transaction_id": {"type": "string", "pattern": "^activation-[a-f0-9]{32}$"},
    "request_body_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "endpoint": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "pattern": "^https://"},
    "download_relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|^[A-Za-z]:[\\\\/]|(^|/)\\.\\.(/|$))"}
    },
    "downloaded_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "content_type": {"type": "string", "pattern": "^video/"},
    "ffprobe": {"type": "object"},
    "actual_provider_call_attempts": {"const": 1}
  },
  "additionalProperties": false
}
