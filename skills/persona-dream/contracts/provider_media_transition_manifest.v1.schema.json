{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema", "status", "run_id", "revision_id", "activation_transaction_id",
    "checked_at", "request_asset_count", "entries", "publication_authorization_required",
    "publication_authorization_present", "publication_performed_by_this_command",
    "actual_provider_call_attempts", "provider_live", "submitted"
  ],
  "properties": {
    "schema": {"const": "persona_dream.provider_media_transition_manifest.v1"},
    "status": {"const": "PASS_PROVIDER_MEDIA_TRANSITIONS_TECHNICAL"},
    "run_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "activation_transaction_id": {"type": "string", "pattern": "^activation-[a-f0-9]{32}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "request_asset_count": {"const": 7},
    "entries": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "artifact_id", "json_pointers", "url", "sha256", "publication_authorization",
          "publication_receipt", "public_probe", "teardown_policy"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "json_pointers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/input/"}},
          "url": {"type": "string", "pattern": "^https://"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "publication_authorization": {
            "type": "object",
            "required": ["approval_type", "state"],
            "properties": {
              "approval_type": {"const": "publication_authorization"},
              "state": {"const": "MISSING_HUMAN_APPROVAL"}
            },
            "additionalProperties": false
          },
          "publication_receipt": {"$ref": "#/$defs/file_ref"},
          "public_probe": {"$ref": "#/$defs/file_ref"},
          "teardown_policy": {"$ref": "#/$defs/file_ref"}
        },
        "additionalProperties": false
      }
    },
    "publication_authorization_required": {"const": true},
    "publication_authorization_present": {"const": false},
    "publication_performed_by_this_command": {"const": false},
    "actual_provider_call_attempts": {"const": 0},
    "provider_live": {"const": false},
    "submitted": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|^[A-Za-z]:[\\\\/]|(^|/)\\.\\.(/|$))"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
