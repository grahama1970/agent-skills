{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/persona-dream/phase11_provider_source_snapshot.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "status",
    "provider_id",
    "endpoint",
    "mode",
    "retrieved_at",
    "ttl_seconds",
    "schema_source",
    "pricing_source",
    "actual_provider_call_attempts"
  ],
  "properties": {
    "schema": {
      "const": "persona_dream.phase11_provider_source_snapshot.v1"
    },
    "status": {
      "const": "PASS_PROVIDER_SOURCE_SNAPSHOT"
    },
    "provider_id": {
      "const": "kling"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "standard",
        "pro"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "schema_source": {
      "$ref": "#/$defs/remote_source"
    },
    "pricing_source": {
      "allOf": [
        {
          "$ref": "#/$defs/remote_source"
        },
        {
          "type": "object",
          "required": [
            "currency",
            "usd_per_second_audio_off",
            "duration_seconds",
            "maximum_expected_cost_usd"
          ],
          "properties": {
            "currency": {
              "const": "USD"
            },
            "usd_per_second_audio_off": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration_seconds": {
              "const": 10
            },
            "maximum_expected_cost_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "actual_provider_call_attempts": {
      "const": 0
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "remote_source": {
      "type": "object",
      "required": [
        "requested_url",
        "final_url",
        "http_status",
        "remote_content_sha256",
        "body_relative_path"
      ],
      "properties": {
        "requested_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "final_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "http_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "remote_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_schema": {
          "type": "object"
        },
        "body_relative_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        }
      }
    }
  }
}
