{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona_dream.research.prospective_tom.pctom_archive_manifest.v1",
  "type": "object",
  "required": ["schema", "created_at", "status", "mocked", "live", "fixture_backed", "entries", "entries_sha256", "counts"],
  "properties": {
    "schema": {"type": "string", "const": "persona_dream.research.prospective_tom.pctom_archive_manifest.v1"},
    "status": {"type": "string", "const": "ARCHIVE_MANIFEST_BUILT"},
    "mocked": {"type": "boolean", "const": false},
    "live": {"type": "boolean", "const": false},
    "fixture_backed": {"type": "boolean", "const": true},
    "entries": {"type": "array", "minItems": 1},
    "entries_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "counts": {"type": "object"}
  },
  "additionalProperties": true
}
