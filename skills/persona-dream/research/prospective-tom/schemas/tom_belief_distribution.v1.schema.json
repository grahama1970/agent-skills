{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona_dream.research.prospective_tom.tom_belief_distribution.v1",
  "type": "object",
  "required": [
    "hypothesis_id",
    "episode_id",
    "perspective_order",
    "subject",
    "target",
    "mental_state_type",
    "proposition",
    "distribution",
    "evidence_refs",
    "prediction_horizon",
    "counterfactual",
    "counterfactual_context",
    "abstain",
    "support_status"
  ],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "perspective_order": {"type": "integer", "minimum": 1, "maximum": 2},
    "subject": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "mental_state_type": {
      "type": "string",
      "enum": ["belief", "goal", "desire", "intention", "emotion", "knowledge", "action"]
    },
    "proposition": {"type": "string", "minLength": 1},
    "distribution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "probability"],
        "properties": {
          "value": {"type": "string", "minLength": 1},
          "probability": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      },
      "minItems": 2
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "source_id"],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "social_episode_observation",
              "social_episode_access",
              "memory_residue",
              "synthetic_counterfactual"
            ]
          },
          "source_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "prediction_horizon": {"type": "string", "minLength": 1},
    "counterfactual": {"type": "boolean"},
    "counterfactual_context": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["intervention_id", "synthetic"],
          "properties": {
            "intervention_id": {"type": "string", "minLength": 1},
            "synthetic": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      ]
    },
    "abstain": {"type": "boolean"},
    "support_status": {
      "type": "string",
      "enum": ["supported", "abstained", "pending"]
    }
  },
  "additionalProperties": false
}
