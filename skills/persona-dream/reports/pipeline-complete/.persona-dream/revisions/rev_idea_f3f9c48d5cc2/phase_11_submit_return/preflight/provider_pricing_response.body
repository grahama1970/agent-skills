"},\"_fal_ui_field\":\"video\",\"limit_description\":\"Max file size: 100.0MB, Min duration: 3.0s, Max duration: 20.0s, Timeout: 120.0s\",\"title\":\"Video Url\"},\"sound_effect_prompt\":{\"default\":\"Car tires screech as they accelerate in a drag race\",\"description\":\"Sound effect prompt. Cannot exceed 200 characters.\",\"anyOf\":[{\"maxLength\":200,\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"Sound Effect Prompt\"},\"asmr_mode\":{\"default\":false,\"description\":\"Enable ASMR mode. This mode enhances detailed sound effects and is suitable for highly immersive content scenarios.\",\"type\":\"boolean\",\"title\":\"Asmr Mode\"}},\"required\":[\"video_url\"],\"x-fal-order-properties\":[\"video_url\",\"sound_effect_prompt\",\"background_music_prompt\",\"asmr_mode\"],\"title\":\"VideoToAudioInput\",\"type\":\"object\"},\"ImageToVideoV2MasterOutput\":{\"properties\":{\"video\":{\"$ref\":\"#/components/schemas/File\",\"description\":\"The generated video\",\"examples\":[{\"url\":\"https://v3.fal.media/files/koala/VvGXP5xEhTR9ovGjpulJ7_output.mp4\"}]}},\"required\":[\"video\"],\"x-fal-order-properties\":[\"video\"],\"title\":\"ImageToVideoV2MasterOutput\",\"type\":\"object\"},\"V1TextToVideoRequest\":{\"properties\":{\"prompt\":{\"maxLength\":2500,\"title\":\"Prompt\",\"type\":\"string\",\"examples\":[\"A stylish woman walks down a Tokyo street filled with warm glowing neon and animated city signage. She wears a black leather jacket, a long red dress, and black boots, and carries a black purse.\"]},\"advanced_camera_control\":{\"description\":\"Advanced Camera control parameters\",\"anyOf\":[{\"$ref\":\"#/components/schemas/CameraControl\"},{\"type\":\"null\"}]},\"cfg_scale\":{\"minimum\":0,\"title\":\"Cfg Scale\",\"default\":0.5,\"maximum\":1,\"type\":\"number\",\"description\":\"\\n            The CFG (Classifier Free Guidance) scale is a measure of how close you want\\n            the model to stick to your prompt.\\n        \"},\"camera_control\":{\"descr