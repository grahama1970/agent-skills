ion/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoInput\"}}}},\"description\":\"Generate a video from a start frame image with optional references and elements.\\n\\nThe image defines the first frame of the video. You can optionally add\\nreference images for style/appearance and elements for characters/objects.\",\"operationId\":\"omni_video_reference_to_video_omni_pro_reference_to_video_post\"}},\"/v1.5/pro/text-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/T2VOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"Pro15 Text To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoRequest\"}}}},\"description\":\"Kling 1.5 (pro) Text to Video API.\",\"operationId\":\"pro15_text_to_video_v1_5_pro_text_to_video_post\"}},\"/v3/4k/text-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV3_4kOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"V3 4K Text To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV3_4kRequest\"}}}},\"description\":\"Kling V3 (4k) Text to Video API.\\n\\nThe Kling V3 model with 4k resolution output. Only the Singapore server\\nsupports this mode.\",\"operationId\":\"v3_4k_text_to_video_v3_4k_text_to_video_post\"}},\"/o1/standard/video-to-video/edit\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VEditOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"O1 Std Video To Video Edit\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VEditInput\"}}}},\"description\":\"Modify a video based on the prompt (standard mode).\",\"operationId\":\"o1_std_video_to_video_edit_o1_standard_video_to_video_edit_post\"}},\"/o1/standard/video-to-video/reference\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VReferenceOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"O1 Std Video To Video Reference\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VReferenceInput\"}}}},\"description\":\"Generate a video from a reference video (standard mode).\",\"operationId\":\"o1_std_video_to_video_re