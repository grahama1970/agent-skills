e\\\",\\n  \\\"duration\\\": \\\"5\\\",\\n  \\\"aspect_ratio\\\": \\\"16:9\\\",\\n  \\\"multi_prompt\\\": null,\\n  \\\"shot_type\\\": \\\"customize\\\"\\n}\",\"required\":\"{}\"}},\"ImageToVideoV21MasterRequest\":{\"name\":\"ImageToVideoV21MasterRequest\",\"description\":\"\",\"properties\":{\"prompt\":{\"name\":\"prompt\",\"label\":\"Prompt\",\"type\":\"string\",\"description\":\"\",\"required\":true,\"examples\":[\"Sunlight dapples through budding branches, illuminating a vibrant tapestry of greens and browns as a pair of robins meticulously weave twigs and mud into a cradle of life, their tiny forms a whirlwind of activity against a backdrop of blossoming spring.  The scene unfolds with a gentle, observational pace, allowing the viewer to fully appreciate the intricate details of nest construction, the soft textures of downy feathers contrasted against the rough bark of the branches, the delicate balance of strength and fragility in their creation.\"],\"ui\":{}},\"image_url\":{\"name\":\"image_url\",\"label\":\"Image Url\",\"type\":\"string\",\"description\":\"URL of the image to be used for the video\",\"required\":true,\"examples\":[\"https://v3.fal.media/files/zebra/9Nrm22YyLojSTPJbZYNhh_image.webp\"],\"ui\":{\"field\":\"image\"}},\"duration\":{\"name\":\"duration\",\"label\":\"Duration\",\"type\":{\"kind\":\"enum\",\"values\":[\"5\",\"10\"],\"name\":\"DurationEnum\"},\"description\":\"The duration of the generated video in seconds Default value: `\\\"5\\\"`\",\"required\":false,\"enumValues\":[\"5\",\"10\"],\"defaultValue\":\"5\",\"ui\":{}},\"negative_prompt\":{\"name\":\"negative_prompt\",\"label\":\"Negative Prompt\",\"type\":\"string\",\"description\":\" Default value: `\\\"blur, distort, and low quality\\\"`\",\"required\":false,\"defaultValue\":\"blur, distort, and low quality\",\"ui\":{}},\"cfg_scale\":{\"name\":\"cfg_scale\",\"label\":\"Cfg Scale\",\"type\":\"float\",\"description\":\"The CFG (Classifier Free Guidance) scale is a measure of how close 