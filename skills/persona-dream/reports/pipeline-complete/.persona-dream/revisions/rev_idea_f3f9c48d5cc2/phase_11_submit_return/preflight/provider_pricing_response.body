pe\":\"array\"},{\"type\":\"null\"}],\"examples\":[[\"https://v3b.fal.media/files/b/lion/MKvhFko5_wYnfORYacNII_AgPt8v25Wt4oyKhjnhVK5.png\"]]},\"video_url\":{\"ui\":{\"field\":\"video\"},\"title\":\"Video Url\",\"x-fal\":{\"max_file_size\":209715200,\"min_width\":720,\"max_duration\":10.05,\"min_fps\":24,\"min_duration\":3,\"max_fps\":60,\"max_width\":2160,\"min_height\":720,\"max_height\":2160,\"timeout\":30},\"description\":\"Reference video URL. Only .mp4/.mov formats supported, 3-10 seconds duration, 720-2160px resolution, max 200MB.\\n\\nMax file size: 200.0MB, Min width: 720px, Min height: 720px, Max width: 2160px, Max height: 2160px, Min duration: 3.0s, Max duration: 10.05s, Min FPS: 24.0, Max FPS: 60.0, Timeout: 30.0s\",\"type\":\"string\",\"examples\":[\"https://v3b.fal.media/files/b/rabbit/ku8_Wdpf-oTbGRq4lB5DU_output.mp4\"]},\"elements\":{\"ui\":{\"important\":true},\"title\":\"Elements\",\"description\":\"Elements (characters/objects) to include. Reference in prompt as @Element1, @Element2, etc. Maximum 4 total (elements + reference images) when using video.\",\"anyOf\":[{\"items\":{\"$ref\":\"#/components/schemas/OmniVideoElementInput\"},\"type\":\"array\"},{\"type\":\"null\"}],\"examples\":[[{\"frontal_image_url\":\"https://v3b.fal.media/files/b/panda/MQp-ghIqshvMZROKh9lW3.png\",\"reference_image_urls\":[\"https://v3b.fal.media/files/b/kangaroo/YMpmQkYt9xugpOTQyZW0O.png\",\"https://v3b.fal.media/files/b/zebra/d6ywajNyJ6bnpa_xBue-K.png\"]}]]}},\"required\":[\"prompt\",\"video_url\"],\"description\":\"Input for video editing or video-as-reference generation.\",\"type\":\"object\",\"title\":\"OmniV2VEditInput\"},\"ImageToVideoRequest\":{\"properties\":{\"prompt\":{\"maxLength\":2500,\"title\":\"Prompt\",\"type\":\"string\",\"examples\":[\"Snowflakes fall as a car moves forward along the road.\"]},\"duration\":{\"default\":\"5\",\"title\":\"Duration\",\"description\":\"The duration of the generated video in seconds\",\"type\":\"string\",\"enum\":[\"5\",\"10