n  }\\n}\",\"required\":\"{\\n  \\\"video\\\": {\\n    \\\"file_name\\\": \\\"output.mp4\\\",\\n    \\\"file_size\\\": 47359974,\\n    \\\"url\\\": \\\"https://v3b.fal.media/files/b/panda/oVdiICFXY03Vbam-08Aj8_output.mp4\\\",\\n    \\\"content_type\\\": \\\"video/mp4\\\"\\n  }\\n}\"}},\"ImageToVideoV25ProRequest\":{\"name\":\"ImageToVideoV25ProRequest\",\"description\":\"\",\"properties\":{\"prompt\":{\"name\":\"prompt\",\"label\":\"Prompt\",\"type\":\"string\",\"description\":\"\",\"required\":true,\"examples\":[\"A stark starting line divides two powerful cars, engines revving for the challenge ahead. They surge forward in the heat of competition, a blur of speed and chrome. The finish line looms as they vie for victory.\"],\"ui\":{}},\"image_url\":{\"name\":\"image_url\",\"label\":\"Image Url\",\"type\":\"string\",\"description\":\"URL of the image to be used for the video\",\"required\":true,\"examples\":[\"https://v3.fal.media/files/panda/HnY2yf-BbzlrVQxR-qP6m_9912d0932988453aadf3912fc1901f52.jpg\"],\"ui\":{\"field\":\"image\"}},\"duration\":{\"name\":\"duration\",\"label\":\"Duration\",\"type\":{\"kind\":\"enum\",\"values\":[\"5\",\"10\"],\"name\":\"DurationEnum\"},\"description\":\"The duration of the generated video in seconds Default value: `\\\"5\\\"`\",\"required\":false,\"enumValues\":[\"5\",\"10\"],\"defaultValue\":\"5\",\"ui\":{}},\"negative_prompt\":{\"name\":\"negative_prompt\",\"label\":\"Negative Prompt\",\"type\":\"string\",\"description\":\" Default value: `\\\"blur, distort, and low quality\\\"`\",\"required\":false,\"defaultValue\":\"blur, distort, and low quality\",\"ui\":{}},\"cfg_scale\":{\"name\":\"cfg_scale\",\"label\":\"Cfg Scale\",\"type\":\"float\",\"description\":\"The CFG (Classifier Free Guidance) scale is a measure of how close you want\\nthe model to stick to your prompt. Default value: `0.5`\",\"required\":false,\"defaultValue\":0.5,\"min\":0,\"max\":1,\"ui\":{}},\"tail_image_url\":{\"name\":\"tail_image_url\",\"label\":\"Tail Image Url\",\"type\":\"string\",\"description\":\"URL of the image to be used for the end of the video\",\"required\":false,\"ui\":{\"important\":true}}},\"examples\":{\"all\":\"{\\n  \\\"prompt\\\": \\\"A stark starting line divides two powerful cars, engines revving for the challenge ahead. They surge forward in the heat of competition, a blur of speed and chrome. The finish line looms as they vie for victory.\\\",\\n  \\\"image_url\\\": \\\"https://v3.fal.media/files/panda/HnY2yf-BbzlrVQxR-qP6m_9912d0932988453aadf3912fc1901f52.jpg\\\",\\n  \\\"duration\\\": \\\"5\\\",\\n  \\\"negative_prompt\\\": \\\"blur, distort, and low quality\\\",\\n  \\\"cfg_scale\\\": 0.5\\n}\",\"required\":\"{\\n  \\\"prompt\\\": \\\"A stark starting line divides two powerful cars, engines revving for the challenge ahead. They surge forward in the heat of competition, a blur of speed and chrome. The finish line looms as they vie for victory.\\\",\\n  \\\"image_url\\\": \\\"https://v3.fal.media/files/panda/HnY2yf-BbzlrVQxR-qP6m_9912d0932988453aadf3912fc1901f52.jpg\\\"\\n}\"}},\"ImageToVideoV25ProOutput\":{\"name\":\"ImageToVideoV25ProOutput\",\"description\":\"\",\"properties\":{\"video\":{\"name\":\"video\",\"label\":\"Video\",\"type\":{\"kind\":\"type\",\"name\":\"File\"},\"description\":\"The generated video\",\"required\":true,\"examples\":[{\"url\":\"https://storage.googleapis.com/falserverless/model_tests/kling/kling-v2.5-turbo-pro-image-to-video-output.mp4\"}],\"ui\":{}}},\"examples\":{\"all\":\"{\\n  \\\"video\\\": {\\n    \\\"url\\\": \\\"https://storage.googleapis.com/falserverless/model_tests/kling/kling-v2.5-turbo-pro-image-to-video-output.mp4\\\"\\n  }\\n}\",\"required\":\"{\\n  \\\"video\\\": {\\n    \\\"url\\\": \\\"https://storage.googleapis.com/falserverless/model_tests/kling/kling-v2.5-turbo-pro-image-to-video-output.mp4\\\"\\n  }\\n}\"}},\"VideoEffectsRequest\":{\"name\":\"VideoEffectsRequest\",\"description\":\"\",\"properties\":{\"input_image_urls\":{\"name\":\"input_imag