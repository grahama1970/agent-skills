escription\":\"Kling 2.5 (pro) Image to Video API.\",\"operationId\":\"pro25_image_to_video_v2_5_turbo_pro_image_to_video_post\"}},\"/v1.6/pro/elements\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ElementsOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"Pro16 Multi Image To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MultiImageToVideoRequest\"}}}},\"description\":\"Kling Pro Multi-Image to Video API.\\n\\nThis endpoint allows generating videos from multiple input images (up to 4).\\nThe images should be provided in the order they should appear in the video.\",\"operationId\":\"pro16_multi_image_to_video_v1_6_pro_elements_post\"}},\"/lipsync/text-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LipsyncOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"Lipsync T2V\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LipsyncT2VRequest\"}}}},\"description\":\"Kling Lipsync Text to Video API.\",\"operationId\":\"lipsync_t2v_lipsync_text_to_video_post\"}},\"/v3/pro/motion-control\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlV3ProOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"V3 Pro Motion Control\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlV3ProRequest\"}}}},\"description\":\"Kling V3 (pro) Motion Control API.\\n\\nGenerate videos where character actions match a reference video while\\nthe visual appearance is based on a reference image. Pro mode generates\\nhigher quality video output.\\n\\nV3 adds support for element binding to enhance facial consistency.\\nWhen an element is provided, the character's facial identity is better\\npreserved across the generated video. Element binding requires\\ncharacter_orientation='video'.\\n\\nCharacter orientation controls output pose direction and video limits:\\n- 'video': Matches reference video orientation - better for complex motions (max 30s)\\n- 'image': Matches reference image orientation - better for camera movements (max 10s)\",\"operationId\":\"v3_pro_motion_control_v3_pro_motion_control_post\"}},\"/v1.6/standard/elements\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ElementsOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"Std16 Multi Image To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MultiImageToVideoRequest\"}}}},\"description\":\"Kling Standard Multi-Image to Video API.\\n\\nThis endpoint allows generating videos from multiple input images (up to 4).\\nThe images should be provided in the order they should appear in the video.\",\"operationId\":\"std16_multi_image_to_video_v1_6_standard_elements_post\"}},\"/lipsync/audio-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LipsyncA2VOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"Lipsync A2V\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LipsyncA2VRequest\"}}}},\"description\":\"Kling Lipsync Audio to Video API.\",\"operationId\":\"lipsync_a2v_lipsync_audio_to_video_post\"}},\"/o1/image-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoImageToVideoOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"O1 Image To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoImageToVideoInput\"}}}},\"description\":\"Generate a video that transitions from start frame to end frame.\\nThe video will smoothly animate between the two provided images.\",\"operationId\":\"o1_image_to_video_o1_image_to_video_post\"}},\"/us/v2.5-turbo/standard/image-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV25StandardOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"Us Std25 Image To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV25StandardRequest\"}}}},\"description\":\"Kling 2.5 (std) Image to Video API.\",\"operationId\":\"us_std25_image_to_video_us_v2_5_turbo_standard_image_to_video_post\"}},\"/o1/reference-to-video\":{\"post\":{\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoOutput\"}}},\"description\":\"Successful Response\"},\"422\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}},\"description\":\"Validation Error\"}},\"summary\":\"O1 Reference To Video\",\"parameters\":[{\"schema\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"title\":\"X-Fal-Caller-User-Id\"},\"required\":false,\"name\":\"x-fal-caller-user-id\",\"in\":\"header\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoInput\"}}}},\"de