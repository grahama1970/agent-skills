t\":true},\"title\":\"Prompt\",\"description\":\"Text prompt for video generation. Reference video as @Video1.\",\"type\":\"string\",\"examples\":[\"change the main character to be Popeye from @Element1, dark lighting and rain, 3d character. make him sad, with rain dropping on him, dark light on the character.\"]},\"shot_type\":{\"default\":\"customize\",\"title\":\"Shot Type\",\"description\":\"The type of multi-shot video generation.\",\"const\":\"customize\",\"type\":\"string\"},\"image_urls\":{\"ui\":{\"important\":true},\"title\":\"Image Urls\",\"description\":\"Reference images for style/appearance. Reference in prompt as @Image1, @Image2, etc. Maximum 4 total (elements + reference images) when using video.\",\"anyOf\":[{\"items\":{\"x-fal\":{\"max_file_size\":10485760,\"min_height\":300,\"min_width\":300,\"max_aspect_ratio\":2.5,\"timeout\":20,\"min_aspect_ratio\":0.4},\"_fal_ui_field\":\"image\",\"limit_description\":\"Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s\",\"type\":\"string\",\"ui\":{\"field\":\"image\"}},\"type\":\"array\"},{\"type\":\"null\"}],\"examples\":[null]},\"video_url\":{\"x-fal\":{\"max_file_size\":209715200,\"min_width\":720,\"max_duration\":15.05,\"min_fps\":24,\"min_duration\":3,\"max_fps\":60,\"max_width\":3840,\"min_height\":720,\"max_height\":3840,\"timeout\":30},\"description\":\"Reference video URL. Only .mp4/.mov formats, 3-15s duration, 720-3840px resolution, max 200MB.\",\"type\":\"string\",\"examples\":[\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/standard-v2v-edit/standard_video_reference.mp4\"],\"ui\":{\"field\":\"video\"},\"_fal_ui_field\":\"video\",\"limit_description\":\"Max file size: 200.0MB, Min width: 720px, Min height: 720px, Max width: 3840px, Max height: 3840px, Min duration: 3.0s, Max duration: 15.05s, Min FPS: 24.0, Max FPS: 60.0, Timeout: 30.0s\",\"title\":\"Video Url\"},\"elements\":{\"ui\":{\"important\":tru