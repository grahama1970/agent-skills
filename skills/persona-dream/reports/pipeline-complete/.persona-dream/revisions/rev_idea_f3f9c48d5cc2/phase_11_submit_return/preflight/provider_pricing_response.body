\":\"List of prompts for multi-shot video generation.\",\"anyOf\":[{\"items\":{\"$ref\":\"#/components/schemas/KlingV3MultiPromptElement\"},\"type\":\"array\"},{\"type\":\"null\"}],\"examples\":[null]},\"generate_audio\":{\"default\":false,\"title\":\"Generate Audio\",\"description\":\"Whether to generate native audio for the video.\",\"type\":\"boolean\",\"ui\":{\"important\":true}},\"aspect_ratio\":{\"default\":\"16:9\",\"title\":\"Aspect Ratio\",\"description\":\"Aspect ratio of the generated video.\",\"type\":\"string\",\"enum\":[\"16:9\",\"9:16\",\"1:1\"]}},\"x-fal-order-properties\":[\"prompt\",\"duration\",\"aspect_ratio\",\"generate_audio\",\"multi_prompt\",\"shot_type\"],\"title\":\"O3ProTextToVideoInput\",\"type\":\"object\"},\"ImageToVideoV21MasterRequest\":{\"properties\":{\"prompt\":{\"maxLength\":2500,\"title\":\"Prompt\",\"type\":\"string\",\"examples\":[\"Sunlight dapples through budding branches, illuminating a vibrant tapestry of greens and browns as a pair of robins meticulously weave twigs and mud into a cradle of life, their tiny forms a whirlwind of activity against a backdrop of blossoming spring.  The scene unfolds with a gentle, observational pace, allowing the viewer to fully appreciate the intricate details of nest construction, the soft textures of downy feathers contrasted against the rough bark of the branches, the delicate balance of strength and fragility in their creation.\"]},\"duration\":{\"default\":\"5\",\"title\":\"Duration\",\"description\":\"The duration of the generated video in seconds\",\"type\":\"string\",\"enum\":[\"5\",\"10\"]},\"negative_prompt\":{\"maxLength\":2500,\"default\":\"blur, distort, and low quality\",\"type\":\"string\",\"title\":\"Negative Prompt\"},\"image_url\":{\"ui\":{\"field\":\"image\"},\"title\":\"Image Url\",\"description\":\"URL of the image to be used for the video\",\"type\":\"string\",\"examples\":[\"https://v3.fal.media/files/zebra/9Nrm22YyLojSTPJbZYNhh_image.webp\"]},\"cfg_scale\":{\"minimum\":0,\"title\":\"Cfg Scale\",\"default\":0.5,\"maximum\":1,\"type\":\"number\",\"description\":\"\\n            The CFG (Classifier Free Guidance) scale is a measure of how close you want\\n            the model to stick to your prompt.\\n        \"}},\"required\":[\"prompt\",\"image_url\"],\"x-fal-order-properties\":[\"prompt\",\"image_url\",\"duration\",\"negative_prompt\",\"cfg_scale\"],\"title\":\"ImageToVideoV21MasterRequest\",\"type\":\"object\"},\"TextToVideoV2MasterOutput\":{\"properties\":{\"video\":{\"$ref\":\"#/components/schemas/File\",\"description\":\"The generated video\",\"examples\":[{\"url\":\"https://v3.fal.media/files/rabbit/5fu6OSZdvV825r2s_c0S8_output.mp4\"}]}},\"required\":[\"video\"],\"x-fal-order-properties\":[\"video\"],\"title\":\"TextToVideoV2MasterOutput\",\"type\":\"object\"},\"AdvancedLipsyncCreateTaskInput\":{\"properties\":{\"session_id\":{\"title\":\"Session Id\",\"description\":\"The session id of the lip-sync task\",\"type\":\"string\",\"examples\":[\"820842086936223749\"]},\"face_choose\":{\"$ref\":\"#/components/schemas/FaceChoice\",\"description\":\"Specified Face for Lip-Sync. Includes Face ID, lip movement reference data, etc. Currently only supports one person lip-sync.\"}},\"required\":[\"session_id\",\"face_choose\"],\"x-fal-order-properties\":[\"session_id\",\"face_choose\"],\"title\":\"AdvancedLipsyncCreateTaskInput\",\"type\":\"object\"},\"TTSInput\":{\"properties\":{\"voice_speed\":{\"minimum\":0.8,\"title\":\"Voice Speed\",\"default\":1,\"maximum\":2,\"type\":\"number\",\"description\":\"Rate of speech\"},\"text\":{\"maxLength\":500,\"title\":\"Text\",\"description\":\"The text to be converted to speech\",\"type\":\"string\",\"examples\":[\"Hello world! Kling TTS is available on FAL!\"]},\"voice_id\":{\"default\":\"genshin_vindi2\",\"title\":\"Voice Id\",\"description\":\"The voice ID to use for speech synthesis\",\"type\":\"string\",\"enum\":[\"genshin_vindi2\",\"zhinen_xuesheng\",\"AOT\",\"ai_shatang\",\"genshin_klee2