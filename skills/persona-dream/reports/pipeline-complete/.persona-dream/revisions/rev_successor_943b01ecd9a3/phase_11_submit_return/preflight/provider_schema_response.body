io\",\"label\":\"Generate Audio\",\"type\":\"boolean\",\"description\":\"Whether to generate native audio for the video. Supports Chinese and English voice output. Other languages are automatically translated to English. For English speech, use lowercase letters; for acronyms or proper nouns, use uppercase. Default value: `true`\",\"required\":false,\"defaultValue\":true,\"ui\":{\"important\":true}}},\"examples\":{\"all\":\"{\\n  \\\"prompt\\\": \\\"Old friends reuniting at a train station after 20 years, one exclaims 'Is that really you?!' other tearfully replies 'I promised I'd come back, didn't I?', train whistle, steam hissing, emotional orchestral swell, crowd murmur\\\",\\n  \\\"duration\\\": \\\"5\\\",\\n  \\\"aspect_ratio\\\": \\\"16:9\\\",\\n  \\\"negative_prompt\\\": \\\"blur, distort, and low quality\\\",\\n  \\\"cfg_scale\\\": 0.5,\\n  \\\"generate_audio\\\": true\\n}\",\"required\":\"{\\n  \\\"prompt\\\": \\\"Old friends reuniting at a train station after 20 years, one exclaims 'Is that really you?!' other tearfully replies 'I promised I'd come back, didn't I?', train whistle, steam hissing, emotional orchestral swell, crowd murmur\\\"\\n}\"}},\"KlingV3ComboElementInput\":{\"name\":\"KlingV3ComboElementInput\",\"description\":\"\",\"properties\":{\"frontal_image_url\":{\"name\":\"frontal_image_url\",\"label\":\"Frontal Image Url\",\"type\":\"string\",\"description\":\"The frontal image of the element (main view).\",\"required\":false,\"ui\":{\"field\":\"image\"}},\"reference_image_urls\":{\"name\":\"reference_image_urls\",\"label\":\"Reference Image Urls\",\"type\":{\"kind\":\"list\",\"elementType\":\"string\"},\"description\":\"Additional reference images from different angles. 1-3 images supported. At least one image is required.\",\"required\":false,\"ui\":{}},\"video_url\":{\"name\":\"video_url\",\"label\":\"Video Url\",\"type\":\"string\",\"description\":\"The video URL of the element. A request can only have one element with a video.\",\"required\