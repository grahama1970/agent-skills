":\"enum\",\"values\":[\"5\",\"10\"],\"name\":\"DurationEnum\"},\"description\":\"The duration of the generated video in seconds Default value: `\\\"5\\\"`\",\"required\":false,\"enumValues\":[\"5\",\"10\"],\"defaultValue\":\"5\",\"ui\":{}},\"aspect_ratio\":{\"name\":\"aspect_ratio\",\"label\":\"Aspect Ratio\",\"type\":{\"kind\":\"enum\",\"values\":[\"16:9\",\"9:16\",\"1:1\"],\"name\":\"AspectRatioEnum\"},\"description\":\"The aspect ratio of the generated video frame Default value: `\\\"16:9\\\"`\",\"required\":false,\"enumValues\":[\"16:9\",\"9:16\",\"1:1\"],\"defaultValue\":\"16:9\",\"ui\":{}},\"negative_prompt\":{\"name\":\"negative_prompt\",\"label\":\"Negative Prompt\",\"type\":\"string\",\"description\":\" Default value: `\\\"blur, distort, and low quality\\\"`\",\"required\":false,\"defaultValue\":\"blur, distort, and low quality\",\"ui\":{}},\"cfg_scale\":{\"name\":\"cfg_scale\",\"label\":\"Cfg Scale\",\"type\":\"float\",\"description\":\"The CFG (Classifier Free Guidance) scale is a measure of how close you want\\nthe model to stick to your prompt. Default value: `0.5`\",\"required\":false,\"defaultValue\":0.5,\"min\":0,\"max\":1,\"ui\":{}}},\"examples\":{\"all\":\"{\\n  \\\"prompt\\\": \\\"A stylish woman walks down a Tokyo street filled with warm glowing neon and animated city signage. She wears a black leather jacket, a long red dress, and black boots, and carries a black purse.\\\",\\n  \\\"duration\\\": \\\"5\\\",\\n  \\\"aspect_ratio\\\": \\\"16:9\\\",\\n  \\\"negative_prompt\\\": \\\"blur, distort, and low quality\\\",\\n  \\\"cfg_scale\\\": 0.5\\n}\",\"required\":\"{\\n  \\\"prompt\\\": \\\"A stylish woman walks down a Tokyo street filled with warm glowing neon and animated city signage. She wears a black leather jacket, a long red dress, and black boots, and carries a black purse.\\\"\\n}\"}},\"OmniVideoImageToVideoInput\":{\"name\":\"OmniVideoImageToVideoInput\",\"description\":\"\",\"properties\":{\"prompt\":{\"name\":\"prompt\",\"label\":\"Prompt\",\"type\":\"string\",\"description\":\"Use @Image1 to reference the start frame, @Image2 to reference the end frame.\",\"required\":true,\"examples\":[\"Create a magical timelapse transition. The snow melts rapidly to reveal green grass, and the tree branches burst into bloom with pink flowers in real-time. The lighting shifts from cold winter light to warm spring sunshine. The camera pushes in slowly towards the tree. Disney-style magical transformation, cinematic, 8k.\"],\"ui\":{}},\"start_image_url\":{\"name\":\"start_image_url\",\"label\":\"Start Image Url\",\"type\":\"string\",\"description\":\"Image to use as the first frame of the video.\\n\\nMax file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s\",\"required\":true,\"examples\":[\"https://v3b.fal.media/files/b/rabbit/NaslJIC7F2WodS6DFZRRJ.png\"],\"dimensionConstraints\":{\"minWidth\":300,\"minHeight\":300,\"minAspectRatio\":0.4,\"maxAspectRatio\":2.5},\"ui\":{\"field\":\"image\"}},\"end_image_url\":{\"name\":\"end_image_url\",\"label\":\"End Image Url\",\"type\":\"string\",\"description\":\"Image to use as the last frame of the video.\",\"required\":false,\"examples\":[\"https://v3b.fal.media/files/b/tiger/BwHi22qoQnqaTNMMhe533.png\"],\"ui\":{\"field\":\"image\",\"important\":true}},\"duration\":{\"name\":\"duration\",\"label\":\"Duration\",\"type\":{\"kind\":\"enum\",\"values\":[\"3\",\"4\",\"5\",\"6\",\"7\",\"8\",\"9\",\"10\"],\"name\":\"DurationEnum\"},\"description\":\"Video duration in seconds. Default value: `\\\"5\\\"`\",\"required\":false,\"enumValues\":[\"3\",\"4\",\"5\",\"6\",\"7\",\"8\",\"9\",\"10\"],\"defaultValue\":\"5\",\"ui\":{}}},\"examples\":{\"all\":\"{\\n  \\\"prompt\\\": \\\"Create a magical timelapse transition. The snow melts rapidly to reveal green grass, and the tree branches burst into bloom with pink flowers in real-time. The lighting shifts from cold winter light to warm spring sunshine. The camera pushes in slowly towards the tree. Disney-style magical transformation, cinematic, 8k.\\\",\\n  \\\"start_image_url\\\": \\\"https://v3b.fal.media/files/b/rabbit/NaslJIC7F2WodS6DFZRRJ.png\\\",\\n  \\\"end_image_url\\\": \\\"https://v3b.fal.media/files/b/tiger/BwHi22qoQnqaTNMMhe533.png\\\",\\n  \\\"duration\\\": \\\"5\\\"\\n}\",\"required\":\"{\\n  \\\"prompt\\\": \\\"Create a magical timelapse transition. The snow melts rapidly to reveal green grass, and the tree branches burst into bloom with pink flowers in real-time. The lighting shifts from cold winter light to warm spring sunshine. The camera pushes in slowly towards the tree. Disney-style magical transformation, cinematic, 8k.\\\",\\n  \\\"start_image_url\\\": \\\"https://v3b.fal.media/files/b/rabbit/NaslJIC7F2WodS6DFZRRJ.png\\\"\\n}\"}},\"CreateVoiceOutput\":{\"name\":\"CreateVoiceOutput\",\"description\":\"Response model for creating a custom voice.\",\"properties\":{\"voice_id\":{\"name\":\"voice_id\",\"label\":\"Voice Id\",\"type\":\"string\",\"description\":\"Unique identifier for the created voice\",\"required\":true,\"examples\":[\"829877809978941442\"],\"ui\":{}}},\"examples\":{\"all\":\"{\\n  \\\"voice_id\\\": \\\"829877809978941442\\\"\\n}\",\"required\":\"{\\n  \\\"voice_id\\\": \\\"829877809978941442\\\"\\n}\"}},\"O3ProEditVideoV2VInput\":{\"name\":\"O3ProEditVideoV2VInput\",\"description\":\"\",\"properties\":{\"prompt\":{\"name\":\"prompt\",\"label\":\"Prompt\",\"type\":\"string\",\"description\":\"Text prompt for video generation. Reference video as @Video1.\",\"required\":true,\"examples\":[\"Change environment to be fully snow as @Image1. Replace animal with @Element1\"],\"ui\":{\"important\":true}},\"video_url\":{\"name\":\"video_url\",\"label\":\"Video Url\",\"type\":\"string\",\"description\":\"Reference video URL. Only .mp4/.mov formats, 3-15s duration, 720-3840px resolution, max 200MB.\",\"required\":true,\"examples\":[\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/video_reference.mp4\"],\"dimensionConstraints\":{\"minWidth\":720,\"minHeight\":720,\"maxWidth\":3840,\"maxHeight\":3840},\"ui\":{\"field\":\"video\"}},\"image_urls\":{\"name\":\"image_urls\",\"label\":\"Image Urls\",\"type\":{\"kind\":\"list\",\"elementType\":\"string\"},\"description\":\"Reference images for style/appearance. Reference in prompt as @Image1, @Image2, etc. Maximum 4 total (elements + reference images) when using video.\",\"required\":false,\"examples\":[[\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/image_url1.jpg\"]],\"ui\":{\"important\":true}},\"keep_audio\":{\"name\":\"keep_audio\",\"label\":\"Keep Audio\",\"type\":\"boolean\",\"description\":\"Whether to keep the original audio from the reference video. Default value: `true`\",\"required\":false,\"defaultValue\":true,\"ui\":{}},\"elements\":{\"name\":\"elements\",\"label\":\"Elements\",\"type\":{\"kind\":\"list\",\"elementType\":{\"kind\":\"type\",\"name\":\"KlingV3ImageElementInput\"}},\"description\":\"Elements (characters/objects) to include. Reference in prompt as @Element1, @Element2.\",\"required\":false,\"examples\":[[{\"frontal_image_url\":\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/element1_front.png\",\"reference_image_urls\":[\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/element1_reference1.png\"]}]],\"ui\":{\"important\":true}},\"shot_type\":{\"name\":\"shot_type\",\"label\":\"Shot Type\",\"type\":\"string\",\"description\":\"The type of multi-shot video generation. Default value: `\\\"customize\\\"`\",\"required\":false,\"defaultValue\":\"customize\",\"constValue\":\"customize\",\"ui\":{}}},\"examples\":{\"all\":\"{\\n  \\\"prompt\\\": \\\"Change environment to be fully snow as @Image1. Replace animal with @Element1\\\",\\n  \\\"video_url\\\": \\\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/video_reference.mp4\\\",\\n  \\\"image_urls\\\": [\\n    \\\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/image_url1.jpg\\\"\\n  ],\\n  \\\"keep_audio\\\": true,\\n  \\\"elements\\\": [\\n    {\\n      \\\"frontal_image_url\\\": \\\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/element1_front.png\\\",\\n      \\\"reference_image_urls\\\": [\\n        \\\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/element1_reference1.png\\\"\\n      ]\\n    }\\n  ],\\n  \\\"shot_type\\\": \\\"customize\\\"\\n}\",\"required\":\"{\\n  \\\"prompt\\\": \\\"Change environment to be fully snow as @Image1. Replace animal with @Element1\\\",\\n  \\\"video_url\\\": \\\"https://storage.googleapis.com/falserverless/example_inputs/kling-o3/pro-v2v-edit/video_reference.mp4\\\"\\n}\"}},\"ImageToVideoV3ProOutput\":{\"name\":\"ImageToVideoV3ProOutput\",\"description\":\"\",\"properties\":{\"video\":{\"name\":\"video\",\"label\":\"Video\",\"type\":{\"kind\":\"type\",\"name\":\"File\"},\"description\":\"The generated video\",\"required\":true,\"examples\":[{\"content_type\":\"video/mp4\",\"file_size\":8431922,\"file_name\":\"out.mp4\",\"url\":\"https://storage.googleapis.com/falserverless/example_outputs/kling-v3/pro-i2v/out.mp4\"}],\"ui\":{}}},\"examples\":{\"all\":\"{\\n  \\\"video\\\": {\\n    \\\"content_type\\\": \\\"video/mp4\\\",\\n    \\\"file_size\\\": 8431922,\\n    \\\"file_name\\\": \\\"out.mp4\\\",\\n    \\\"url\\\": \\\"https://storage.googleapis.com/falserverless/example_outputs/kling-v3/pro-i2v/out.mp4\\\"\\n  }\\n}\",\"required\":\"{\\n  \\\"video\\\": {\\n    \\\"content_type\\\": \\\"video/mp4\\\",\\n    \\\"file_size\\\": 8431922,\\n    \\\"file_name\\\": \\\"out.mp4\\\",\\n    \\\"url\\\": \\\"https://storage.googleapis.com/falserverless/example_outputs/kling-v3/pro-i2v/out.mp4\\\"\\n  }\\n}\"}},\"O3_4kTextToVideoInput\":{\"name\":\"O3_4kTextToVideoInput\",\"description\":\"\",\"properties\":{\"prompt\":{\"n