</span><span style="background-color:transparent"><span></span><span class="token token keyword">const</span><span> result </span><span class="token token operator">=</span><span> </span><span class="token token keyword control-flow">await</span><span> fal</span><span class="token token punctuation">.</span><span class="token token method function property-access">subscribe</span><span class="token token punctuation">(</span><span class="token token string">&quot;fal-ai/kling-video/v3/standard/image-to-video&quot;</span><span class="token token punctuation">,</span><span> </span><span class="token token punctuation">{</span><span>
</span></span><span style="background-color:transparent"><span>  </span><span class="token token literal-property property">input</span><span class="token token operator">:</span><span> </span><span class="token token punctuation">{</span><span>
</span></span><span style="background-color:transparent"><span>    </span><span class="token token literal-property property">start_image_url</span><span class="token token operator">:</span><span> </span><span class="token token string">&quot;https://storage.googleapis.com/falserverless/example_inputs/kling-v3/standard-i2v/start_image.png&quot;</span><span>
</span></span><span style="background-color:transparent"><span>  </span><span class="token token punctuation">}</span><span class="token token punctuation">,</span><span>
</span></span><span style="background-color:transparent"><span>  </span><span class="token token literal-property property">logs</span><span class="token token operator">:</span><span> </span><span class="token token boolean">true</span><span class="token token punctuation">,</span><span>
</span></span><span style="background-color:transparent"><span>  </span><span class="token token function-variable function">onQueueUpdate</span><span class="token token operator">:</span><span> </span><span class="token token punctuation">(</span><span class="token token parameter">update</span><span class="token token punctuation">)</span><span> </span><span class="token token arrow operator">=&gt;</span><span> </span><span class="token token punctuation">{</span><span>
