del (4k mode).\\n\\nO3 4k produces ultra-high-resolution output with start/end frames and\\nnative audio. Only the Singapore server supports this mode.\",\"operationId\":\"o3_4k_image_to_video_o3_4k_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3_4kImageToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3_4kImageToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/lipsync/audio-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Lipsync A2V\",\"description\":\"Kling Lipsync Audio to Video API.\",\"operationId\":\"lipsync_a2v_lipsync_audio_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LipsyncA2VRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/LipsyncA2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1/standard/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Text To Video\",\"description\":\"Kling 1.0 Text to Video API.\",\"operationId\":\"text_to_video_v1_standard_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/V1TextToVideoRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/T2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1/tts\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Kling Tts\",\"description\":\"Kling TTS API.\\nThis endpoint generates an audio of speech from text.\",\"operationId\":\"kling_tts_v1_tts_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TTSInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TTSOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/pro/video-to-video/reference\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 Pro Video To Video\",\"operationId\":\"o3_pro_video_to_video_o3_pro_video_to_video_reference_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3ProReferenceVideoV2VInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3ProReferenceV2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v3/turbo/pro/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V3 Turbo Pro Image To Video\",\"description\":\"Generate videos with Kling V3 Turbo (pro, 1080p) Image to Video\",\"operationId\":\"v3_turbo_pro_image_to_video_v3_turbo_pro_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV3TurboProRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV3TurboProOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2/master/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V2 Master Text To Video\",\"description\":\"Kling 2.0 Master Text to Video API.\\n\\nThe Kling 2.0 Master model is an upgraded version of the text-to-video generation model\\nthat significantly improves upon Kling 1.6 in several key areas:\\n\\nText Understanding:\\n    - Enhanced execution of actions and camera movements\\n    - Support for more complex sequential shot descriptions\\n    - Ability to generate blockbuster-quality scenes from text\\n\\nMotion Quality:\\n    - More dynamic character and subject movements\\n    - Smoother motion and transitions\\n    - Natural and logical complex action sequences\\n\\nVisual Quality:\\n    - Lifelike characters with realistic movements and expressions\\n    - Highly detailed scene generation from cinematic descriptions\\n    - Better preservation of artistic style and aesthetics\",\"operationId\":\"v2_master_text_to_video_v2_master_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV2MasterRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV2MasterOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/pro/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 Pro Image To Video\",\"description\":\"Generate a video from image using O3 model (professional mode).\\n\\nO3 supports extended duration (3-15s), start/end frames, and native audio.\\nProfessional mode generates 1080P videos.\",\"operationId\":\"o3_pro_image_to_video_o3_pro_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3ProImageToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3ProImageToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/4k/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 4K Text To Video\",\"description\":\"Generate a video from text prompt using O3 model (4k mode).\\n\\nO3 4k produces ultra-high-resolution output. Only the Singapore server\\nsupports this mode.\",\"operationId\":\"o3_4k_text_to_video_o3_4k_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3_4kTextToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3_4kTextToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/standard/reference-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 Std Reference To Video\",\"operationId\":\"o3_std_reference_to_video_o3_standard_reference_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3StandardReferenceVideoI2VInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3StandardImageR2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/4k/reference-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 4K Reference To Video\",\"description\":\"Generate a video with references/elements using O3 model (4k mode).\\n\\nO3 4k produces ultra-high-resolution output. Only the Singapore server\\nsupports this mode.\",\"operationId\":\"o3_4k_reference_to_video_o3_4k_reference_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3_4kReferenceVideoI2VInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3_4kImageR2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1.5/pro/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro15 Text To Video\",\"description\":\"Kling 1.5 (pro) Text to Video API.\",\"operationId\":\"pro15_text_to_video_v1_5_pro_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/T2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o1/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O1 Image To Video\",\"description\":\"Generate a video that transitions from start frame to end frame.\\nThe video will smoothly animate between the two provided images.\",\"operationId\":\"o1_image_to_video_o1_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoImageToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoImageToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/us/v2.5-turbo/pro/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Us Pro25 Image To Video\",\"description\":\"Kling 2.5 (pro) Image to Video API (routes identically to the\\nmain /v2.5-turbo/pro/image-to-video endpoint).\",\"operationId\":\"us_pro25_image_to_video_us_v2_5_turbo_pro_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV25ProRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV25ProOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v3/turbo/pro/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V3 Turbo Pro Text To Video\",\"description\":\"Generate videos with Kling V3 Turbo (pro, 1080p) Text to Video\",\"operationId\":\"v3_turbo_pro_text_to_video_v3_turbo_pro_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV3TurboProRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV3TurboProOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o1/reference-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O1 Reference To Video\",\"description\":\"Generate a video from a start frame image with optional references and elements.\\n\\nThe image defines the first frame of the video. You can optionally add\\nreference images for style/appearance and elements for characters/objects.\",\"operationId\":\"o1_reference_to_video_o1_reference_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2.6/standard/motion-control\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V26 Standard Motion Control\",\"description\":\"Kling V2.6 (standard) Motion Control API.\\n\\nGenerate videos where character actions match a reference video while\\nthe visual appearance is based on a reference image. Standard mode is\\ncost-effective.\\n\\nThe character in the reference image will perform the same actions as\\nthe character in the reference video. This is useful for:\\n- Transferring dance moves to different characters\\n- Applying specific gestures or movements to portraits\\n- Creating consistent character animations across different visuals\\n\\nCharacter orientation controls output pose direction and video limits:\\n- 'video': Matches reference video orientation - better for complex motions (max 30s)\\n- 'image': Matches reference image orientation - better for camera movements (max 10s)\",\"operationId\":\"v26_standard_motion_control_v2_6_standard_motion_control_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/standard/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 Std Image To Video\",\"description\":\"Generate a video from image using O3 model (standard mode).\\n\\nO3 supports extended duration (3-15s), start/end frames, and native audio.\",\"operationId\":\"o3_std_image_to_video_o3_standard_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3StandardImageToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3StandardImageToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/advanced-lipsync\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Advanced Lipsync\",\"description\":\"Kling Advanced Lipsync - Create Task API.\\n\\nThis endpoint creates an advanced lip-sync task with precise control over:\\n- Face selection (using face_id from identify-face endpoint)\\n- Audio source (TTS audio_id or custom sound_file)\\n- Audio timing (crop and insert positions)\\n- Volume control (for both new audio and original video audio)\\n\\nThe session_id and face_id must be obtained from the identify-face endpoint first.\",\"operationId\":\"advanced_lipsync_advanced_lipsync_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AdvancedLipsyncCreateTaskInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AdvancedLipsyncOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/ai-avatar/v2/pro\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro Ai Avatar V2\",\"operationId\":\"pro_ai_avatar_v2_ai_avatar_v2_pro_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AIAvatarInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/AIAvatarOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/identify-face\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Identify Face\",\"description\":\"Kling Advanced Lipsync - Identify Face API.\\n\\nThis endpoint identifies faces in a video and returns face data with time ranges.\\nThe returned session_id and face_data can be used with the create-task endpoint\\nto generate advanced lip-sync videos with precise control over audio timing.\",\"operationId\":\"identify_face_identify_face_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/IdentifyFaceInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/IdentifyFaceOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/omni/pro/video-to-video/reference\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Omni V2V Reference\",\"description\":\"Generate a video from a reference video.\",\"operationId\":\"omni_v2v_reference_omni_pro_video_to_video_reference_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VReferenceInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VReferenceOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o1/standard/video-to-video/reference\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"sum