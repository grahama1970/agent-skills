 generation when the `generate_audio` parameter is enabled.\",\"operationId\":\"v3_standard_text_to_video_v3_standard_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV3StandardRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV3StandardOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1/lite/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro Image To Video\",\"description\":\"Kling 1.0 (pro) Image to Video API.\",\"operationId\":\"pro_image_to_video_v1_lite_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/V1ImageToVideoRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/I2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/us/v3/standard/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Us V3 Standard Image To Video\",\"description\":\"Kling V3 (standard) Image to Video API.\",\"operationId\":\"us_v3_standard_image_to_video_us_v3_standard_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV3StandardRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV3StandardOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1.5/pro/effects\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro15 Effects\",\"description\":\"Kling 1.5 (pro) Effects API.\",\"operationId\":\"pro15_effects_v1_5_pro_effects_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/VideoEffectsRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/VideoEffectsOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o3/standard/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O3 Std Text To Video\",\"description\":\"Generate a video from text prompt using O3 model (standard mode).\\n\\nO3 supports extended duration (3-15s) and native audio generation.\",\"operationId\":\"o3_std_text_to_video_o3_standard_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3StandardTextToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/O3StandardTextToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/omni/pro/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Omni Video Image To Video\",\"description\":\"Generate a video that transitions from start frame to end frame.\\nThe video will smoothly animate between the two provided images.\",\"operationId\":\"omni_video_image_to_video_omni_pro_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoImageToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoImageToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o1/video-to-video/edit\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O1 Video To Video Edit\",\"description\":\"Modify a video based on the prompt.\",\"operationId\":\"o1_video_to_video_edit_o1_video_to_video_edit_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VEditInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VEditOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/balancer/state\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Get Balancer State\",\"description\":\"Get cluster state (penalties, circuit breakers, utilization).\",\"operationId\":\"get_balancer_state_balancer_state_post\",\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"title\":\"Response Get Balancer State Balancer State Post\",\"type\":\"object\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2.1/pro/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro21 Image To Video\",\"description\":\"Kling 2.1 (pro) Image to Video API.\",\"operationId\":\"pro21_image_to_video_v2_1_pro_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV21ProRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV21ProOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2.5-turbo/standard/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Std25 Image To Video\",\"description\":\"Kling 2.5 (std) Image to Video API.\",\"operationId\":\"std25_image_to_video_v2_5_turbo_standard_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV25StandardRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV25StandardOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v3/pro/motion-control\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V3 Pro Motion Control\",\"description\":\"Kling V3 (pro) Motion Control API.\\n\\nGenerate videos where character actions match a reference video while\\nthe visual appearance is based on a reference image. Pro mode generates\\nhigher quality video output.\\n\\nV3 adds support for element binding to enhance facial consistency.\\nWhen an element is provided, the character's facial identity is better\\npreserved across the generated video. Element binding requires\\ncharacter_orientation='video'.\\n\\nCharacter orientation controls output pose direction and video limits:\\n- 'video': Matches reference video orientation - better for complex motions (max 30s)\\n- 'image': Matches reference image orientation - better for camera movements (max 10s)\",\"operationId\":\"v3_pro_motion_control_v3_pro_motion_control_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlV3ProRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlV3ProOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1.6/pro/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro16 Text To Video\",\"description\":\"Kling 1.6 (pro) Text to Video API.\",\"operationId\":\"pro16_text_to_video_v1_6_pro_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/T2VOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2.6/pro/motion-control\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V26 Pro Motion Control\",\"description\":\"Kling V2.6 (pro) Motion Control API.\\n\\nGenerate videos where character actions match a reference video while\\nthe visual appearance is based on a reference image. Pro mode offers\\nhigher quality output.\\n\\nThe character in the reference image will perform the same actions as\\nthe character in the reference video. This is useful for:\\n- Transferring dance moves to different characters\\n- Applying specific gestures or movements to portraits\\n- Creating consistent character animations across different visuals\\n\\nCharacter orientation controls output pose direction and video limits:\\n- 'video': Matches reference video orientation - better for complex motions (max 30s)\\n- 'image': Matches reference image orientation - better for camera movements (max 10s)\",\"operationId\":\"v26_pro_motion_control_v2_6_pro_motion_control_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2.1/master/text-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Master21 Text To Video\",\"description\":\"Kling 2.1 Master Text to Video API.\",\"operationId\":\"master21_text_to_video_v2_1_master_text_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV21MasterRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/TextToVideoV21MasterOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1.6/pro/effects\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro16 Effects\",\"description\":\"Kling 1.6 (pro) Effects API.\",\"operationId\":\"pro16_effects_v1_6_pro_effects_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/VideoEffectsRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/VideoEffectsOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v3/standard/motion-control\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V3 Standard Motion Control\",\"description\":\"Kling V3 (standard) Motion Control API.\\n\\nGenerate videos where character actions match a reference video while\\nthe visual appearance is based on a reference image. Standard mode is\\ncost-effective.\\n\\nV3 adds support for element binding to enhance facial consistency.\\nWhen an element is provided, the character's facial identity is better\\npreserved across the generated video. Element binding requires\\ncharacter_orientation='video'.\\n\\nCharacter orientation controls output pose direction and video limits:\\n- 'video': Matches reference video orientation - better for complex motions (max 30s)\\n- 'image': Matches reference image orientation - better for camera movements (max 10s)\",\"operationId\":\"v3_standard_motion_control_v3_standard_motion_control_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlV3StandardRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MotionControlV3StandardOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o1/standard/reference-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O1 Std Reference To Video\",\"description\":\"Generate a video from a start frame image with optional references and elements (standard mode).\\n\\nThe image defines the first frame of the video. You can optionally add\\nreference images for style/appearance and elements for characters/objects.\",\"operationId\":\"o1_std_reference_to_video_o1_standard_reference_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniVideoReferenceToVideoOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/video-to-audio\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Video To Audio\",\"description\":\"Kling Video to Audio API.\\nThis endpoint extracts audio from a video file.\",\"operationId\":\"video_to_audio_video_to_audio_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/VideoToAudioInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/VideoToAudioOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v2/master/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"V2 Master Image To Video\",\"description\":\"Kling 2.0 Master Image to Video API.\\n\\nThe Kling 2.0 Master model is an upgraded version of the text-to-video generation model\\nthat significantly improves upon Kling 1.6 in several key areas:\\n\\nText Understanding:\\n    - Enhanced execution of actions and camera movements\\n    - Support for more complex sequential shot descriptions\\n    - Ability to generate blockbuster-quality scenes from text\\n\\nMotion Quality:\\n    - More dynamic character and subject movements\\n    - Smoother motion and transitions\\n    - Natural and logical complex action sequences\\n\\nVisual Quality:\\n    - Lifelike characters with realistic movements and expressions\\n    - Highly detailed scene generation from cinematic descriptions\\n    - Better preservation of artistic style and aesthetics\",\"operationId\":\"v2_master_image_to_video_v2_master_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV2MasterRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ImageToVideoV2MasterOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1.6/standard/elements\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Std16 Multi Image To Video\",\"description\":\"Kling Standard Multi-Image to Video API.\\n\\nThis endpoint allows generating videos from multiple input images (up to 4).\\nThe images should be provided in the order they should appear in the video.\",\"operationId\":\"std16_multi_image_to_video_v1_6_standard_elements_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/MultiImageToVideoRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/ElementsOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/o1/video-to-video/reference\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"O1 Video To Video Reference\",\"description\":\"Generate a video from a reference video.\",\"operationId\":\"o1_video_to_video_reference_o1_video_to_video_reference_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VReferenceInput\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/OmniV2VReferenceOutput\"}}}},\"422\":{\"description\":\"Validation Error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/HTTPValidationError\"}}}}}}},\"/v1.5/pro/image-to-video\":{\"post\":{\"parameters\":[{\"in\":\"header\",\"schema\":{\"title\":\"X-Fal-Caller-User-Id\",\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"required\":false,\"name\":\"x-fal-caller-user-id\"}],\"summary\":\"Pro15 Image To Video\",\"description\":\"Kling 1.5 (pro) Image to Video API.\",\"operationId\":\"pro15_image_to_video_v1_5_pro_image_to_video_post\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/KlingV15ProImageToVideoRequest\"}}},\"required\":true},\"responses\":{\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/