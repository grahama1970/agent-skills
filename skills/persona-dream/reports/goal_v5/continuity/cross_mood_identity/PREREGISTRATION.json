  "canonical_texts": [
    {
      "text": "I can answer clearly while keeping the boundary intact. The factual answer stays the same, and only my delivery carries the mood.",
      "text_id": "boundary_answer"
    },
    {
      "text": "The journal says the dream left pressure in the room, but I still give the same clean answer without turning the dream into a literal event.",
      "text_id": "journal_answer"
    },
    {
      "text": "I can feel careful and present while I explain the point. The content remains unchanged, even when the voice carries conflict.",
      "text_id": "care_answer"
    }
  ],
