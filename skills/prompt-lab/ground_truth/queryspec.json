{
  "description": "Ground truth test cases for SPARTA QuerySpec generation",
  "cases": [
    {
      "id": "rf_jamming_detect",
      "input": "How do I detect RF jamming attacks on satellite communications?",
      "expected": {
        "action": "QUERY",
        "scope": "sparta",
        "tier1": ["Detect"],
        "keywords": ["RF", "jamming", "satellite", "communications"],
        "entities": []
      },
      "notes": "Clear detection query for RF jamming threat"
    },
    {
      "id": "t1071_mitigate",
      "input": "What controls mitigate T1071 application layer protocol attacks in space systems?",
      "expected": {
        "action": "QUERY",
        "scope": "sparta",
        "entities": ["T1071"],
        "tier1": ["Mitigate"],
        "keywords": ["application", "layer", "protocol", "controls"]
      },
      "notes": "Entity extraction with mitigation focus"
    },
    {
      "id": "cwe_787_prevent",
      "input": "How can CWE-787 buffer overflow vulnerabilities be prevented in spacecraft software?",
      "expected": {
        "action": "QUERY",
        "scope": "sparta",
        "entities": ["CWE-787"],
        "tier1": ["Harden"],
        "keywords": ["buffer", "overflow", "spacecraft", "software", "prevent"]
      },
      "notes": "CWE entity with hardening tactics"
    },
    {
      "id": "weather_oos",
      "input": "What's the weather forecast for tomorrow?",
      "expected": {
        "action": "NO_MATCH",
        "scope": "sparta"
      },
      "notes": "Out of scope - weather query"
    },
    {
      "id": "recipe_oos",
      "input": "How do I make chocolate chip cookies?",
      "expected": {
        "action": "NO_MATCH",
        "scope": "sparta"
      },
      "notes": "Out of scope - recipe query"
    },
    {
      "id": "general_cve_oos",
      "input": "What is CVE-2024-1234?",
      "expected": {
        "action": "NO_MATCH",
        "scope": "sparta"
      },
      "notes": "Out of scope - general CVE without space context"
    },
    {
      "id": "ambiguous_security",
      "input": "How do I make it more secure?",
      "expected": {
        "action": "CLARIFY",
        "scope": "sparta"
      },
      "notes": "Ambiguous - what is 'it'?"
    },
    {
      "id": "ground_station_protect",
      "input": "What are the best practices for protecting ground station command links?",
      "expected": {
        "action": "QUERY",
        "scope": "sparta",
        "tier1": ["Harden"],
        "tier0": ["Precision"],
        "keywords": ["ground", "station", "command", "links", "protect"]
      },
      "notes": "Ground station protection query"
    },
    {
      "id": "command_injection_detect",
      "input": "How can I detect command injection attacks on spacecraft uplink?",
      "expected": {
        "action": "QUERY",
        "scope": "sparta",
        "tier1": ["Detect"],
        "tier0": ["Corruption"],
        "keywords": ["command", "injection", "spacecraft", "uplink"]
      },
      "notes": "Detection of command injection"
    },
    {
      "id": "telemetry_spoofing",
      "input": "What controls exist for telemetry spoofing threats?",
      "expected": {
        "action": "QUERY",
        "scope": "sparta",
        "tier1": ["Detect", "Mitigate"],
        "tier0": ["Stealth"],
        "keywords": ["telemetry", "spoofing", "controls"]
      },
      "notes": "Telemetry spoofing threat mitigation"
    }
  ],
  "validation_rules": {
    "action": {
      "type": "exact_match",
      "required": true,
      "valid_values": ["QUERY", "CLARIFY", "NO_MATCH"]
    },
    "scope": {
      "type": "exact_match",
      "required": true,
      "valid_values": ["sparta"]
    },
    "entities": {
      "type": "subset_match",
      "required": false,
      "description": "Expected entities should be subset of predicted"
    },
    "tier0": {
      "type": "overlap",
      "required": false,
      "valid_values": ["Corruption", "Fragility", "Loyalty", "Precision", "Resilience", "Stealth"]
    },
    "tier1": {
      "type": "overlap",
      "required": false,
      "valid_values": ["Detect", "Evade", "Exploit", "Harden", "Isolate", "Model", "Persist", "Restore"]
    },
    "keywords": {
      "type": "overlap",
      "required": false,
      "min_overlap": 0.5
    }
  }
}
