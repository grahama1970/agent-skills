#!/usr/bin/env python3
"""Task Monitor Client for Prompt-Lab.

Integrates with the centralized task-monitor skill by:
1. Registering tasks in ~/.pi/task-monitor/registry.json
2. Writing state files that task-monitor TUI can display
3. Updating progress per case (not just on completion)

Usage:
    monitor = PromptLabTaskClient("test-sparta-100", total_cases=100)
    for case in cases:
        result = evaluate(case)
        monitor.update(case.id, result)
    monitor.finish()

View progress:
    # Via task-monitor TUI
    cd ~/.pi/skills/task-monitor
    uv run python monitor.py tui --filter prompt-lab
"""

import asyncio
import json
import os
import time
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Any, Optional
from loguru import logger

# Heartbeat configuration
HEARTBEAT_INTERVAL_S = float(os.getenv("PROMPT_LAB_HEARTBEAT_INTERVAL_S", "30.0"))

# Task monitor registry location (same as dogpile uses)
TASK_MONITOR_REGISTRY = Path.home() / ".pi" / "task-monitor" / "registry.json"
SKILL_DIR = Path(__file__).parent
STATE_FILE = SKILL_DIR / "prompt_lab_task_state.json"
BATCH_STATE_FILE = SKILL_DIR / ".batch_state.json"  # Standard task-monitor format
ERROR_LOG = SKILL_DIR / "prompt_lab_errors.json"


@dataclass
class GateMetrics:
    """Track pass/fail counts for a quality gate."""
    passed: int = 0
    failed: int = 0

    @property
    def rate(self) -> float:
        total = self.passed + self.failed
        return self.passed / total if total > 0 else 1.0

    def to_dict(self) -> Dict[str, Any]:
        return {
            "passed": self.passed,
            "failed": self.failed,
            "rate": round(self.rate, 4),
        }


@dataclass
class FailureRecord:
    """Record of a quality gate failure."""
    case_id: str
    gate: str  # ambiguity, anchoring, grounding
    question: str
    reason: str
    score: Optional[float] = None
    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())

    def to_dict(self) -> Dict[str, Any]:
        return {
            "case_id": self.case_id,
            "gate": self.gate,
            "question": self.question[:100],  # Truncate for display
            "reason": self.reason,
            "score": self.score,
            "timestamp": self.timestamp,
        }


class PromptLabTaskClient:
    """Task-monitor compatible progress tracker for prompt-lab.

    Writes state to prompt_lab_task_state.json which task-monitor TUI can display.
    """

    def __init__(
        self,
        task_name: str,
        total_cases: int,
        description: Optional[str] = None,
        register: bool = True,
    ):
        self.task_name = task_name
        self.total_cases = total_cases
        self.description = description or f"Prompt-Lab: {task_name}"

        # Progress tracking
        self.completed = 0
        self.start_time = time.time()
        self.last_update = 0.0

        # Gate metrics
        self.gates = {
            "ambiguity": GateMetrics(),
            "anchoring": GateMetrics(),
            "grounding": GateMetrics(),
        }

        # Failure tracking
        self.failures: List[FailureRecord] = []
        self.total_qras = 0

        # Per-case timing
        self.case_times: Dict[str, float] = {}

        # Heartbeat tracking
        self.current_case: Optional[str] = None
        self.current_case_start: Optional[float] = None
        self._heartbeat_task: Optional[asyncio.Task] = None

        # Register with task-monitor
        if register:
            self._register_task()

        # Initial state write
        self._write_state()

    def _register_task(self):
        """Register this task with task-monitor registry."""
        try:
            TASK_MONITOR_REGISTRY.parent.mkdir(parents=True, exist_ok=True)

            # Load existing registry
            registry = {}
            if TASK_MONITOR_REGISTRY.exists():
                try:
                    registry = json.loads(TASK_MONITOR_REGISTRY.read_text())
                except Exception:
                    registry = {}

            # Add/update our task
            registry[f"prompt-lab:{self.task_name}"] = {
                "state_file": str(STATE_FILE),
                "total": self.total_cases,
                "description": self.description,
                "project": "prompt-lab",
                "registered_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            }

            # Write atomically
            tmp = TASK_MONITOR_REGISTRY.with_suffix(".tmp")
            tmp.write_text(json.dumps(registry, indent=2))
            os.replace(tmp, TASK_MONITOR_REGISTRY)
        except Exception as e:
            logger.debug("prompt-lab task monitor registry write failed: {}", e)

    def _write_state(self, final: bool = False):
        """Update task-monitor state file."""
        now = time.time()

        # Throttle updates (max every 0.3s unless final)
        if not final and (now - self.last_update) < 0.3:
            return
        self.last_update = now

        elapsed = now - self.start_time
        progress_pct = (self.completed / self.total_cases * 100) if self.total_cases > 0 else 0

        # Calculate ETA
        eta_seconds = None
        if self.completed > 0 and self.completed < self.total_cases:
            rate = self.completed / elapsed
            remaining = self.total_cases - self.completed
            eta_seconds = remaining / rate if rate > 0 else None

        state = {
            "completed": self.completed,
            "total": self.total_cases,
            "description": self.description,
            "current_item": f"case {self.completed + 1}/{self.total_cases}",
            "progress_pct": round(progress_pct, 1),
            "elapsed_seconds": round(elapsed, 1),
            "eta_seconds": round(eta_seconds, 1) if eta_seconds else None,
            "gates": {name: metrics.to_dict() for name, metrics in self.gates.items()},
            "stats": {
                "total_qras": self.total_qras,
                "failures": len(self.failures),
                "ambiguity_rate": round(self.gates["ambiguity"].rate, 4),
                "anchoring_rate": round(self.gates["anchoring"].rate, 4),
                "grounding_rate": round(self.gates["grounding"].rate, 4),
            },
            "failures": [f.to_dict() for f in self.failures[-20:]],  # Last 20
            "last_updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "status": "completed" if final else "running",
        }

        # Write atomically to both state files
        try:
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(state, indent=2))
            os.replace(tmp, STATE_FILE)
        except Exception as e:
            logger.debug("tmp failed: {}", e)

        # Also write .batch_state.json in standard task-monitor format
        try:
            # Include current case info if processing
            current_item = f"case {self.completed + 1}/{self.total_cases}"
            if self.current_case and self.current_case_start:
                case_elapsed = now - self.current_case_start
                current_item = f"processing {self.current_case} ({case_elapsed:.0f}s)"

            batch_state = {
                "completed": self.completed,
                "total": self.total_cases,
                "status": "completed" if final else "running",
                "current_item": current_item,
                "description": self.description,
                "project": "prompt-lab",
                "task_name": self.task_name,
                "progress_pct": round(progress_pct, 1),
                "elapsed_seconds": round(elapsed, 1),
                "eta_seconds": round(eta_seconds, 1) if eta_seconds else None,
                "last_updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            }
            tmp = BATCH_STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(batch_state, indent=2))
            os.replace(tmp, BATCH_STATE_FILE)
        except Exception as e:
            logger.debug("operation failed: {}", e)

    def start_case(self, case_id: str):
        """Mark a case as started for heartbeat tracking.

        Args:
            case_id: The case being processed
        """
        self.current_case = case_id
        self.current_case_start = time.time()

    def end_case(self, case_id: str):
        """Mark a case as finished.

        Args:
            case_id: The case that finished
        """
        if self.current_case_start:
            self.case_times[case_id] = time.time() - self.current_case_start
        self.current_case = None
        self.current_case_start = None

    def heartbeat(self):
        """Send a heartbeat update to state file.

        Call this periodically during long-running case processing
        to show the task is still alive.
        """
        # Force write state (bypass throttle)
        self.last_update = 0.0
        self._write_state()

    async def _heartbeat_loop(self, interval: float = HEARTBEAT_INTERVAL_S):
        """Internal heartbeat loop for async context manager."""
        try:
            while True:
                await asyncio.sleep(interval)
                self.heartbeat()
        except asyncio.CancelledError:
            pass

    async def start_heartbeat(self, interval: float = HEARTBEAT_INTERVAL_S):
        """Start automatic heartbeat updates.

        Args:
            interval: Seconds between heartbeats (default: 30)

        Returns:
            asyncio.Task that can be cancelled to stop heartbeat
        """
        if self._heartbeat_task is not None:
            return self._heartbeat_task
        self._heartbeat_task = asyncio.create_task(self._heartbeat_loop(interval))
        return self._heartbeat_task

    async def stop_heartbeat(self):
        """Stop automatic heartbeat updates."""
        if self._heartbeat_task is not None:
            self._heartbeat_task.cancel()
            try:
                await self._heartbeat_task
            except asyncio.CancelledError:
                pass
            self._heartbeat_task = None

    def update(
        self,
        case_id: str,
        ambiguity_rate: float,
        anchoring_rate: float,
        grounding_rate: float,
        qra_count: int,
        failures: Optional[List[Dict[str, Any]]] = None,
    ):
        """Update progress after evaluating a case.

        Args:
            case_id: The test case ID
            ambiguity_rate: 0.0-1.0 ambiguity gate pass rate for this case
            anchoring_rate: 0.0-1.0 entity anchoring rate for this case
            grounding_rate: 0.0-1.0 citation grounding rate for this case
            qra_count: Number of QRAs generated for this case
            failures: Optional list of failure details
        """
        self.completed += 1
        self.total_qras += qra_count

        # Update gate metrics
        if ambiguity_rate >= 1.0:
            self.gates["ambiguity"].passed += 1
        else:
            self.gates["ambiguity"].failed += 1

        if anchoring_rate >= 1.0:
            self.gates["anchoring"].passed += 1
        else:
            self.gates["anchoring"].failed += 1

        if grounding_rate >= 0.85:  # Grounding threshold
            self.gates["grounding"].passed += 1
        else:
            self.gates["grounding"].failed += 1

        # Record failures
        if failures:
            for f in failures:
                self.failures.append(FailureRecord(
                    case_id=case_id,
                    gate=f.get("failed_gate", "unknown"),
                    question=f.get("question", ""),
                    reason=f.get("reason", ""),
                    score=f.get("score"),
                ))

        self._write_state()

    def finish(self, success: bool = True):
        """Mark the task as complete."""
        self._write_state(final=True)

        # Persist errors to log file
        if self.failures:
            try:
                error_data = {
                    "task_name": self.task_name,
                    "completed_at": datetime.now().isoformat(),
                    "success": success,
                    "total_cases": self.total_cases,
                    "total_failures": len(self.failures),
                    "gates": {name: metrics.to_dict() for name, metrics in self.gates.items()},
                    "failures": [f.to_dict() for f in self.failures],
                }
                tmp = ERROR_LOG.with_suffix(".tmp")
                tmp.write_text(json.dumps(error_data, indent=2))
                os.replace(tmp, ERROR_LOG)
            except Exception as e:
                logger.debug("value lookup failed: {}", e)

    def get_summary(self) -> Dict[str, Any]:
        """Get a summary for logging/reporting."""
        elapsed = time.time() - self.start_time
        return {
            "task_name": self.task_name,
            "completed": self.completed,
            "total": self.total_cases,
            "elapsed_seconds": round(elapsed, 1),
            "gates": {
                "ambiguity": self.gates["ambiguity"].rate,
                "anchoring": self.gates["anchoring"].rate,
                "grounding": self.gates["grounding"].rate,
            },
            "failures": len(self.failures),
            "total_qras": self.total_qras,
        }


# Convenience functions for simple usage
_current_client: Optional[PromptLabTaskClient] = None


def start_monitoring(task_name: str, total_cases: int) -> PromptLabTaskClient:
    """Start monitoring a new prompt-lab task."""
    global _current_client
    _current_client = PromptLabTaskClient(task_name, total_cases)
    return _current_client


def get_monitor() -> Optional[PromptLabTaskClient]:
    """Get the current task monitor."""
    return _current_client


def end_monitoring(success: bool = True):
    """End the current task monitoring."""
    global _current_client
    if _current_client:
        _current_client.finish(success)
        _current_client = None
