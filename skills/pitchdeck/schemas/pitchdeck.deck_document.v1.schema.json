{
  "$defs": {
    "AssetKind": {
      "enum": [
        "screenshot",
        "diagram",
        "logo",
        "illustration",
        "photo",
        "video",
        "other"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "alt_text": {
          "minLength": 1,
          "title": "Alt Text",
          "type": "string"
        },
        "target_aspect": {
          "default": "16:9",
          "title": "Target Aspect",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssetStatus",
          "default": "planned"
        },
        "generation_brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Brief"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clearance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearance"
        }
      },
      "required": [
        "id",
        "kind",
        "visibility",
        "alt_text"
      ],
      "title": "AssetSpec",
      "type": "object"
    },
    "AssetStatus": {
      "enum": [
        "present",
        "missing",
        "planned",
        "stale",
        "regenerate"
      ],
      "title": "AssetStatus",
      "type": "string"
    },
    "AttachHint": {
      "additionalProperties": false,
      "description": "ADVISORY editing hint (2026-08-07 review): geometry stays authoritative;\nthe PPTX emitter writes stCxn/endCxn only for proven-safe combinations.",
      "properties": {
        "element_id": {
          "minLength": 1,
          "title": "Element Id",
          "type": "string"
        },
        "connection_site": {
          "maximum": 8,
          "minimum": 0,
          "title": "Connection Site",
          "type": "integer"
        }
      },
      "required": [
        "element_id",
        "connection_site"
      ],
      "title": "AttachHint",
      "type": "object"
    },
    "BasicMark": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "bold",
            "italic",
            "underline",
            "code"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "BasicMark",
      "type": "object"
    },
    "Bbox": {
      "additionalProperties": false,
      "description": "Fractional geometry on the 16:9 canvas \u2014 x*1920/y*1080 in the browser,\nx*13.333in/y*7.5in in PPTX, so placement round-trips exactly.",
      "properties": {
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Bbox",
      "type": "object"
    },
    "BindingKind": {
      "description": "Relation of a visible text string to the claim ledger (ContentIR core).\n\nSynthesized from the 2026-08-05 roundtable: webgpt's relation taxonomy,\nwebclaude's explicit non-claim/decorative lexicon + unbound-blocks-publish\ndefault, applied at whole-string granularity (runs stay derived artifacts).",
      "enum": [
        "claim_quote",
        "claim_paraphrase",
        "derived",
        "qualifier",
        "non_claim",
        "decorative"
      ],
      "title": "BindingKind",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind",
          "default": "candidate"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/ClaimRisk",
          "default": "medium"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus",
          "default": "candidate"
        },
        "required_qualifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Qualifier"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence Spans",
          "type": "array"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "text",
        "visibility"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimApproval": {
      "additionalProperties": false,
      "description": "Approval provenance (roundtable item 5): who, when, against what evidence.\n\nAn approved claim without provenance is a warning normally and an ERROR at\npublish; an expired approval returns the claim to unpublishable.",
      "properties": {
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "minLength": 4,
          "title": "Approved At",
          "type": "string"
        },
        "source_snapshot_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Snapshot Sha256"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "fixture": {
          "default": false,
          "title": "Fixture",
          "type": "boolean"
        }
      },
      "required": [
        "approved_by",
        "approved_at"
      ],
      "title": "ClaimApproval",
      "type": "object"
    },
    "ClaimKind": {
      "enum": [
        "thesis",
        "product",
        "proof",
        "status",
        "roadmap",
        "ask",
        "non_claim",
        "candidate"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "ClaimRisk": {
      "enum": [
        "low",
        "medium",
        "high",
        "mandatory_non_claim"
      ],
      "title": "ClaimRisk",
      "type": "string"
    },
    "ClaimStatus": {
      "enum": [
        "candidate",
        "approved",
        "rejected"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ColorMark": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "color",
          "default": "color",
          "title": "Type",
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "canvas",
            "ink",
            "muted",
            "highlight_warm",
            "highlight_green",
            "program",
            "alert"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "ColorMark",
      "type": "object"
    },
    "ContentReveal": {
      "description": "Browser-deck content entrance animation for body items.\n\n`step` is click-gated: in Present mode the advance key reveals the next\nbullet/card (a fragment) before it advances the slide \u2014 real-presentation\npacing. Honored by the workbench, presenter, and HTML export; PPTX stays\nanimation-free by design.",
      "enum": [
        "none",
        "stagger_up",
        "stagger_fade",
        "step"
      ],
      "title": "ContentReveal",
      "type": "string"
    },
    "DeckMeta": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "audience": {
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "target_editor": {
          "default": "google_slides",
          "title": "Target Editor",
          "type": "string"
        },
        "theme": {
          "default": "dark_cyan_evidence",
          "title": "Theme",
          "type": "string"
        },
        "theme_tokens": {
          "$ref": "#/$defs/ThemeTokens"
        },
        "source_policy": {
          "$ref": "#/$defs/DeckSourcePolicy"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        }
      },
      "required": [
        "id",
        "title",
        "audience",
        "visibility",
        "source_policy"
      ],
      "title": "DeckMeta",
      "type": "object"
    },
    "DeckSourcePolicy": {
      "enum": [
        "public_only",
        "public_and_private"
      ],
      "title": "DeckSourcePolicy",
      "type": "string"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "description": "Connectors are first-class and factual by default: a meaningful edge is a\nRELATIONSHIP claim \u2014 it needs bindings or an explicit decorative class.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "route": {
          "default": "straight",
          "enum": [
            "straight",
            "curve",
            "dotted-path"
          ],
          "title": "Route",
          "type": "string"
        },
        "line_style": {
          "default": "solid",
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "title": "Line Style",
          "type": "string"
        },
        "arrowhead": {
          "default": true,
          "title": "Arrowhead",
          "type": "boolean"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "binding_paths": {
          "items": {
            "type": "string"
          },
          "title": "Binding Paths",
          "type": "array"
        },
        "decorative": {
          "default": false,
          "title": "Decorative",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramGraph": {
      "additionalProperties": false,
      "description": "Normalized editable diagram: separate nodes, edges, labels, and groups \u2014\nemitters MUST render these as distinct shapes (never one raster).",
      "properties": {
        "recipe": {
          "enum": [
            "endpoint-bridge",
            "pipeline",
            "hub-spoke",
            "layered-stack",
            "loop",
            "before-after",
            "scene"
          ],
          "title": "Recipe",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "groups": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Groups",
          "type": "object"
        }
      },
      "required": [
        "recipe",
        "nodes"
      ],
      "title": "DiagramGraph",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "description": "Editable diagram node: icon + label as separate parts, bbox in fractions\nof the OWNING element's bbox (diagrams reposition as one unit).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/Bbox"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Icon-library id or sanitized inline SVG path d= data.",
          "title": "Icon"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "sublabel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sublabel"
        },
        "binding_paths": {
          "items": {
            "type": "string"
          },
          "title": "Binding Paths",
          "type": "array"
        },
        "decoration": {
          "default": "ring",
          "enum": [
            "ring",
            "principal",
            "support",
            "ground"
          ],
          "title": "Decoration",
          "type": "string"
        },
        "scale": {
          "default": 1.0,
          "description": "Glyph weight within its scene.",
          "exclusiveMinimum": 0.2,
          "maximum": 2.5,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "id",
        "bbox",
        "label"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "DocElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocElementKind"
        },
        "bbox": {
          "$ref": "#/$defs/Bbox"
        },
        "z": {
          "default": 0,
          "title": "Z",
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Semantic origin (title, message, body:0, visual, caption\u2026).",
          "title": "Role"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocTextStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "svg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inline SVG; validated by the svg_sanitize allowlist gate (#1268).",
          "title": "Svg"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "diagram": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagramGraph"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DocElement"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "group members; coordinates are fractions of the group's UNROTATED local frame",
          "title": "Children"
        },
        "child_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bbox"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chOff/chExt as fractions of the group bbox; preserved so padded frames survive python-pptx extent recalculation"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "line": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rich_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/RichTextSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rotation_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clockwise, center-anchored; group/shape/image only",
          "title": "Rotation Deg"
        },
        "binding_paths": {
          "description": "TextBinding.path values this element renders.",
          "items": {
            "type": "string"
          },
          "title": "Binding Paths",
          "type": "array"
        },
        "entrance": {
          "$ref": "#/$defs/DocEntrance"
        }
      },
      "required": [
        "id",
        "kind",
        "bbox"
      ],
      "title": "DocElement",
      "type": "object"
    },
    "DocElementKind": {
      "enum": [
        "text",
        "image",
        "svg",
        "figure",
        "diagram",
        "group",
        "shape",
        "line",
        "icon",
        "rich_text"
      ],
      "title": "DocElementKind",
      "type": "string"
    },
    "DocEntrance": {
      "additionalProperties": false,
      "description": "Rhetorical animation: reveal order follows the argument, never decoration.",
      "properties": {
        "effect": {
          "default": "none",
          "enum": [
            "none",
            "fade",
            "rise",
            "zoom"
          ],
          "title": "Effect",
          "type": "string"
        },
        "delay_ms": {
          "default": 0,
          "maximum": 5000,
          "minimum": 0,
          "title": "Delay Ms",
          "type": "integer"
        },
        "fragment_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Click-gated build step; None reveals with the slide.",
          "title": "Fragment Index"
        }
      },
      "title": "DocEntrance",
      "type": "object"
    },
    "DocSlide": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "layout_origin": {
          "$ref": "#/$defs/SlideLayout"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/DocElement"
          },
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/TextBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "transition": {
          "$ref": "#/$defs/SlideTransition",
          "default": "slide"
        },
        "transition_duration_ms": {
          "default": 400,
          "maximum": 1200,
          "minimum": 200,
          "title": "Transition Duration Ms",
          "type": "integer"
        },
        "reveal": {
          "$ref": "#/$defs/ContentReveal",
          "default": "stagger_up"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
