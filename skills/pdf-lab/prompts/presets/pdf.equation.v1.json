{
  "schema_version": "pdf_lab.element_preset.v1",
  "required_inputs": [
    "case_id",
    "page",
    "element_id",
    "original_page_image_path",
    "annotated_page_image_path",
    "actual_json",
    "provenance"
  ],
  "common_validators": [
    "artifact_paths_exist",
    "actual_json_present",
    "no_invented_text",
    "page_matches_element_page"
  ],
  "decision_outputs": [
    "agent_resolved",
    "human_triage",
    "fixture_candidate",
    "blocker"
  ],
  "preset_id": "pdf.equation.v1",
  "element_type": "equation",
  "required_outputs": [
    "equation_id",
    "page",
    "bbox",
    "latex",
    "plain_text",
    "variables",
    "surrounding_context",
    "confidence",
    "warnings",
    "evidence"
  ],
  "validators": [
    "preserve_symbols_first",
    "no_helpful_rewriting",
    "mark_unclear_subscripts",
    "context_page_required"
  ],
  "human_triage_gate": "Only escalate when equation symbols are unreadable or corrected JSON changes symbolic content.",
  "rendering_contract": [
    "show_original_page",
    "show_annotated_page_or_crop",
    "show_actual_json",
    "show_candidate_corrected_json_or_null",
    "show_validator_results"
  ]
}
