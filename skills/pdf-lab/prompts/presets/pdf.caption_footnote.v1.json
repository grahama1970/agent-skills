{
  "schema_version": "pdf_lab.element_preset.v1",
  "required_inputs": [
    "case_id",
    "page",
    "element_id",
    "original_page_image_path",
    "annotated_page_image_path",
    "actual_json",
    "provenance"
  ],
  "common_validators": [
    "artifact_paths_exist",
    "actual_json_present",
    "no_invented_text",
    "page_matches_element_page"
  ],
  "decision_outputs": [
    "agent_resolved",
    "human_triage",
    "fixture_candidate",
    "blocker"
  ],
  "preset_id": "pdf.caption_footnote.v1",
  "element_type": "caption_footnote",
  "required_outputs": [
    "reference_type",
    "text",
    "attached_to",
    "page",
    "bbox",
    "confidence",
    "evidence"
  ],
  "validators": [
    "attached_target_exists_or_null",
    "no_invented_attachment",
    "text_must_be_visible_or_extracted"
  ],
  "human_triage_gate": "Only escalate when attachment target cannot be resolved from proximity, labels, and artifacts.",
  "rendering_contract": [
    "show_original_page",
    "show_annotated_page_or_crop",
    "show_actual_json",
    "show_candidate_corrected_json_or_null",
    "show_validator_results"
  ]
}
