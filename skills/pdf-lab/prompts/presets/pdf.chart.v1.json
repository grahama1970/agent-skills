{
  "schema_version": "pdf_lab.element_preset.v1",
  "required_inputs": [
    "case_id",
    "page",
    "element_id",
    "original_page_image_path",
    "annotated_page_image_path",
    "actual_json",
    "provenance"
  ],
  "common_validators": [
    "artifact_paths_exist",
    "actual_json_present",
    "no_invented_text",
    "page_matches_element_page"
  ],
  "decision_outputs": [
    "agent_resolved",
    "human_triage",
    "fixture_candidate",
    "blocker"
  ],
  "preset_id": "pdf.chart.v1",
  "element_type": "chart",
  "required_outputs": [
    "chart_id",
    "page",
    "bbox",
    "chart_type",
    "caption",
    "axes",
    "legend",
    "data_values",
    "summary",
    "do_not_infer",
    "confidence",
    "evidence"
  ],
  "validators": [
    "page_image_required",
    "visible_values_only",
    "axes_must_be_readable",
    "trend_without_values_when_values_unreadable"
  ],
  "human_triage_gate": "Only escalate when chart identity or readable values conflict between image and extraction artifacts.",
  "rendering_contract": [
    "show_original_page",
    "show_annotated_page_or_crop",
    "show_actual_json",
    "show_candidate_corrected_json_or_null",
    "show_validator_results"
  ]
}
