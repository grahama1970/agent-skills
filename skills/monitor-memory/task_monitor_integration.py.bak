"""Task Monitor Integration for monitor-memory.

Reports per-probe progress to ~/.pi/task-monitor/ for centralized monitoring.
Follows the PersonaMonitorTracker pattern from monitor-personas.

Inputs: probe IDs and results during execution.
Outputs: task_state.json written to STATE_DIR with throttled updates.
"""
from __future__ import annotations

import json
import os
import time
from pathlib import Path
from typing import Any, Dict, List, Optional
from loguru import logger

TASK_MONITOR_REGISTRY = Path.home() / ".pi" / "task-monitor" / "registry.json"
STATE_DIR = Path.home() / ".pi" / "monitor-memory"


class MemoryMonitorTracker:
    """Task-monitor compatible tracker for memory health probes."""

    def __init__(
        self,
        job_type: str = "check",
        name: str = "memory-monitor",
        register: bool = True,
    ):
        self.job_type = job_type
        self.name = f"{name}-{job_type}"
        self.state_file = STATE_DIR / f"task_state_{job_type}.json"

        STATE_DIR.mkdir(parents=True, exist_ok=True)

        # Progress tracking
        self.probes: List[str] = []
        self.current_probe: str = ""
        self.completed_probes: List[str] = []
        self.probe_status: Dict[str, str] = {}
        self.probe_stats: Dict[str, Dict[str, Any]] = {}

        # Timing
        self.start_time = time.time()
        self.last_update = 0.0

        # Error tracking
        self.errors: List[Dict[str, Any]] = []

        if register:
            self._register_task()

        self._update_state()

    def _register_task(self):
        """Register with task-monitor."""
        try:
            TASK_MONITOR_REGISTRY.parent.mkdir(parents=True, exist_ok=True)

            registry = {}
            if TASK_MONITOR_REGISTRY.exists():
                try:
                    registry = json.loads(TASK_MONITOR_REGISTRY.read_text())
                except Exception:
                    registry = {}

            registry[self.name] = {
                "state_file": str(self.state_file),
                "total": len(self.probes),
                "description": f"Memory Monitor: {self.job_type}",
                "project": "monitor-memory",
                "registered_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            }

            tmp = TASK_MONITOR_REGISTRY.with_suffix(".tmp")
            tmp.write_text(json.dumps(registry, indent=2))
            os.replace(tmp, TASK_MONITOR_REGISTRY)
        except Exception as e:
            logger.debug("value lookup failed: {}", e)

    def _update_state(self, final: bool = False):
        """Update task-monitor state file (throttled to 0.5s)."""
        now = time.time()

        if not final and (now - self.last_update) < 0.5:
            return
        self.last_update = now

        elapsed = now - self.start_time
        total = len(self.probes) if self.probes else 1
        completed = len(self.completed_probes)
        progress_pct = (completed / total * 100) if total > 0 else 0

        state = {
            "completed": completed,
            "total": total,
            "description": f"Memory Monitor: {self.job_type}",
            "current_item": self.current_probe,
            "stats": {
                "success": sum(1 for s in self.probe_status.values() if s == "success"),
                "failed": sum(1 for s in self.probe_status.values() if s == "failed"),
                "skipped": sum(1 for s in self.probe_status.values() if s == "skipped"),
            },
            "probe_status": self.probe_status,
            "probe_stats": self.probe_stats,
            "errors": self.errors[-10:],
            "elapsed_seconds": round(elapsed, 1),
            "progress_pct": round(progress_pct, 1),
            "last_updated": time.strftime("%Y-%m-%d %H:%M:%S"),
            "status": "completed" if final else "running",
        }

        try:
            tmp = self.state_file.with_suffix(".tmp")
            tmp.write_text(json.dumps(state, indent=2))
            os.replace(tmp, self.state_file)
        except Exception as e:
            logger.debug("tmp failed: {}", e)

    def set_probes(self, probe_ids: List[str]):
        """Set the list of probes to execute."""
        self.probes = probe_ids
        self.probe_status = {p: "pending" for p in probe_ids}
        self._update_state()

    def start_probe(self, probe_id: str):
        """Mark a probe as starting."""
        self.current_probe = probe_id
        self.probe_status[probe_id] = "running"
        self._update_state()

    def complete_probe(
        self,
        probe_id: str,
        success: bool = True,
        stats: Optional[Dict[str, Any]] = None,
        error_msg: Optional[str] = None,
    ):
        """Mark a probe as complete."""
        self.probe_status[probe_id] = "success" if success else "failed"
        self.completed_probes.append(probe_id)

        if stats:
            self.probe_stats[probe_id] = stats

        if not success and error_msg:
            self.errors.append({
                "probe": probe_id,
                "message": error_msg,
                "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
            })

        self._update_state()

    def skip_probe(self, probe_id: str, reason: str = "not applicable"):
        """Mark a probe as skipped."""
        self.probe_status[probe_id] = "skipped"
        self.completed_probes.append(probe_id)
        self.probe_stats[probe_id] = {"skipped_reason": reason}
        self._update_state()

    def finish(self, success: bool = True):
        """Mark the job as complete."""
        self._update_state(final=True)

    def get_summary(self) -> Dict[str, Any]:
        """Get a summary for reporting."""
        elapsed = time.time() - self.start_time
        return {
            "job_type": self.job_type,
            "elapsed_seconds": round(elapsed, 1),
            "probes": {
                "total": len(self.probes),
                "success": sum(1 for s in self.probe_status.values() if s == "success"),
                "failed": sum(1 for s in self.probe_status.values() if s == "failed"),
                "skipped": sum(1 for s in self.probe_status.values() if s == "skipped"),
            },
            "errors": len(self.errors),
        }


# Global tracker instances
_trackers: Dict[str, MemoryMonitorTracker] = {}


def start_job(job_type: str) -> MemoryMonitorTracker:
    """Start a new monitoring job."""
    tracker = MemoryMonitorTracker(job_type=job_type)
    _trackers[job_type] = tracker
    return tracker


def get_tracker(job_type: str) -> Optional[MemoryMonitorTracker]:
    """Get the tracker for a job type."""
    return _trackers.get(job_type)


def end_job(job_type: str, success: bool = True):
    """End a monitoring job."""
    if job_type in _trackers:
        _trackers[job_type].finish(success)
        del _trackers[job_type]
