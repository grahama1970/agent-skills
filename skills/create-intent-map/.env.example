# HuggingFace token (required for downloading models)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Weights & Biases API key (optional, for experiment tracking)
WANDB_API_KEY=

# GPU selection (default: first GPU)
CUDA_VISIBLE_DEVICES=0

# HuggingFace cache directory (optional, defaults to ~/.cache/huggingface)
# HF_CACHE_DIR=/path/to/cache
