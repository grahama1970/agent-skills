{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "monitor-codebase Fallow-style output",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "command",
    "project",
    "path",
    "timestamp",
    "verdict",
    "summary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "version": {"type": "string"},
    "command": {"type": "string", "enum": ["aggregate", "audit"]},
    "project": {"type": "string"},
    "path": {"type": "string"},
    "timestamp": {"type": "string"},
    "verdict": {"type": "string", "enum": ["pass", "warn", "fail"]},
    "base_ref": {"type": "string"},
    "head_sha": {"type": "string"},
    "changed_files_count": {"type": "integer", "minimum": 0},
    "changed_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "total_issues", "by_source", "by_rule", "by_severity"],
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "total_issues": {"type": "integer", "minimum": 0},
        "by_source": {"type": "object"},
        "by_rule": {"type": "object"},
        "by_severity": {"type": "object"}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/definitions/Finding"}
    },
    "sources": {"type": "object"},
    "notifications": {"type": "object"}
  },
  "definitions": {
    "Finding": {
      "type": "object",
      "required": [
        "finding_id",
        "rule",
        "source",
        "file",
        "line",
        "message",
        "severity",
        "confidence",
        "evidence",
        "actions",
        "remediation_route"
      ],
      "properties": {
        "finding_id": {"type": "string"},
        "rule": {"type": "string"},
        "source": {"type": "string"},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 0},
        "message": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "warn", "error", "critical"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "object"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/Action"}
        },
        "remediation_route": {"$ref": "#/definitions/RemediationRoute"}
      },
      "additionalProperties": true
    },
    "Action": {
      "type": "object",
      "required": ["type", "auto_fixable", "description"],
      "properties": {
        "type": {"type": "string"},
        "auto_fixable": {"type": "boolean"},
        "runner": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "RemediationRoute": {
      "type": "object",
      "required": ["runner", "confidence", "reason"],
      "properties": {
        "runner": {
          "type": "string",
          "enum": ["local", "code-runner", "subagent-runner", "review-prompt", "human-review"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string"},
        "allowlist": {
          "type": "array",
          "items": {"type": "string"}
        },
        "definition_of_done": {
          "type": "object",
          "required": ["command", "assertion"],
          "properties": {
            "command": {"type": "string"},
            "assertion": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
