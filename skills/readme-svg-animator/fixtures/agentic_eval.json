{
  "version": 2,
  "skill": "readme-svg-animator",
  "trials": 3,
  "proof_scope": "local deterministic SVG generation, structural validation, browser img-mode motion, and unsafe-input rejection",
  "claims": {
    "proves": "the skill can generate and validate its bundled scenes and rejects a script-bearing SVG through its real CLI",
    "does_not_prove": "all arbitrary diagram layouts, every browser, future GitHub proxy behavior, or exact font availability on remote viewers"
  },
  "cases": [
    {
      "name": "real-render-verify-browser",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "out=$(mktemp -d) && ../run.sh render ../assets/templates/fanout-anatomy.yml \"$out/scene.svg\" && ../run.sh verify ../assets/templates/fanout-anatomy.yml \"$out/scene.svg\" --receipt \"$out/scene.receipt.json\" --browser"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "PASS"
        ]
      }
    },
    {
      "name": "real-sanity",
      "type": "positive",
      "command": [
        "../sanity.sh"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "SANITY PASS"
        ]
      }
    },
    {
      "name": "unsafe-svg-fails-closed",
      "type": "negative",
      "command": [
        "../run.sh",
        "validate",
        "../tests/fixtures/unsafe-script.svg"
      ],
      "expected": {
        "exit_code": 1,
        "stdout_contains": [
          "FAIL"
        ]
      }
    }
  ],
  "eval_kind": "skill_behavior"
}