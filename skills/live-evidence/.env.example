# Select an interview-specific YAML profile.
LIVE_EVIDENCE_PROFILE=/absolute/path/to/skills/live-evidence/config/g2i.example.yaml

# OS path-separated allowlist. Only these current checkouts are searched by ripgrep.
LIVE_EVIDENCE_REPOS=/home/graham/workspace/experiments/tau:/home/graham/workspace/experiments/agent-skills:/home/graham/workspace/experiments/sparta:/home/graham/workspace/experiments/graph-memory-operator

# Supported Graph Memory service and sibling-skill boundaries.
MEMORY_SERVICE_URL=http://127.0.0.1:8601
# LIVE_EVIDENCE_MEMORY_RUNNER=/absolute/path/to/skills/memory/run.sh
# LIVE_EVIDENCE_BRAVE_RUNNER=/absolute/path/to/skills/brave-search/run.sh
# LIVE_EVIDENCE_DOGPILE_RUNNER=/absolute/path/to/skills/dogpile/run.sh

# Keep the API loopback-only unless you intentionally add a separate network/auth boundary.
LIVE_EVIDENCE_ALLOW_REMOTE_BIND=false
