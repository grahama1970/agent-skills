{
  "version": 2,
  "skill": "live-evidence",
  "trials": 2,
  "proof_scope": "Live local HTTP; positive case uses live Ask/Tau creator and reviewer. Both cases use synthetic sources/questions. No audio, UI, or full-goal proof.",
  "claims": {
    "proves": "Unreviewed source answers are held; the positive case displays the exact creator answer with matching digest, required sections and a live Tau reviewer approval.",
    "does_not_prove": "Adversarial receipt authentication, stale-review rejection, live audio, UI quality, broad answer correctness, or complete live-evidence readiness."
  },
  "cases": [
    {
      "name": "incomplete-input-shows-independent-clarification",
      "type": "adversarial",
      "real_world": true,
      "evidence_class": "fault_injected_deterministic",
      "readback": true,
      "notes": "Injected incomplete-parser transcript, default deterministic scanner, real HTTP and Surf form submission. No provider or microphone calls.",
      "command": ["bash", "-c", "bash ../run.sh ui-build >/dev/null && UV_PROJECT_ENVIRONMENT=\"${XDG_CACHE_HOME:-$HOME/.cache}/live-evidence/venv\" uv run --project .. --extra dev python ../scripts/eval_unreviewed_publication.py --incomplete --ui"],
      "timeout_seconds": 150,
      "expected": {
        "exit_code": 0,
        "artifacts": [
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/status", "equals": "PASS"},
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/checks/incomplete_question_clarification", "equals": true},
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/checks/clarification_form_visible", "equals": true},
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/checks/clarification_submit_resolved", "equals": true},
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/checks/unreviewed_answer_still_hidden", "equals": true}
        ]
      }
    },
    {
      "name": "reviewed-answer-published-through-live-ask-tau",
      "type": "positive",
      "real_world": true,
      "evidence_class": "fault_injected_deterministic",
      "readback": true,
      "notes": "Synthetic source/question with real HTTP and non-mocked Ask/Tau provider calls; class does not claim natural live meeting evidence.",
      "command": ["bash", "-c", "UV_PROJECT_ENVIRONMENT=\"${XDG_CACHE_HOME:-$HOME/.cache}/live-evidence/venv\" uv run --project .. --extra dev python ../scripts/eval_unreviewed_publication.py --reviewed --manual --ui"],
      "timeout_seconds": 360,
      "expected": {
        "exit_code": 0,
        "artifacts": [
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/status", "equals": "PASS"},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/provider_live", "equals": true},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/checks/exact_creator_answer", "equals": true},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/checks/answer_digest_matches", "equals": true},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/checks/required_sections", "equals": true},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/checks/primary_answer_no_scroll", "equals": true},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/checks/implementation_above_fold", "equals": true},
          {"path": "/tmp/live-evidence-reviewed-publication.json", "json_pointer": "/checks/new_session_requires_consent", "equals": true}
        ]
      }
    },
    {
      "name": "unreviewed-source-answer-held-over-live-http",
      "type": "adversarial",
      "real_world": true,
      "evidence_class": "fault_injected_deterministic",
      "readback": true,
      "command": ["bash", "-c", "UV_PROJECT_ENVIRONMENT=\"${XDG_CACHE_HOME:-$HOME/.cache}/live-evidence/venv\" uv run --project .. --extra dev python ../scripts/eval_unreviewed_publication.py"],
      "timeout_seconds": 90,
      "expected": {
        "exit_code": 0,
        "artifacts": [
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/status", "equals": "PASS"},
          {"path": "/tmp/live-evidence-unreviewed-publication.json", "json_pointer": "/cards", "equals": []}
        ]
      }
    }
  ]
}
