{
  "version": 1,
  "skill": "ingest-website",
  "defaults": { "latency_budget_ms": 10000 },
  "cases": [
    {
      "name": "cli-help",
      "command": ["--help"],
      "expected_exit_code": 0,
      "expected_stdout_contains": ["ingest", "URL", "--scope", "--dry-run", "report"],
      "latency_budget_ms": 3000,
      "tags": ["fast", "smoke"]
    },
    {
      "name": "ingest-help",
      "command": ["ingest", "--help"],
      "expected_exit_code": 0,
      "expected_stdout_contains": ["--scope", "--max-pages", "--depth", "--delay", "--output-dir", "--no-qra"],
      "expected_stdout_excludes": ["--js", "--concurrency"],
      "latency_budget_ms": 5000,
      "tags": ["fast", "smoke"]
    },
    {
      "name": "sanity-pass",
      "command": ["--help"],
      "expected_exit_code": 0,
      "expected_stdout_contains": ["Usage:", "ingest"],
      "latency_budget_ms": 3000,
      "tags": ["fast", "smoke"],
      "_note": "Basic smoke test — run.sh responds to --help with usage info"
    },
    {
      "name": "no-url-rejects",
      "command": ["ingest"],
      "expected_exit_code": 1,
      "latency_budget_ms": 10000,
      "tags": ["fast", "negative"],
      "_note": "Ingest with no URL must exit 1 — not silently succeed"
    },
    {
      "name": "report-help",
      "command": ["report", "--help"],
      "expected_exit_code": 0,
      "expected_stdout_contains": ["scope", "--json"],
      "latency_budget_ms": 5000,
      "tags": ["fast", "smoke"]
    },
    {
      "name": "unknown-command-fails",
      "command": ["bogus-command"],
      "expected_exit_code": 1,
      "expected_stdout_contains": ["Usage:"],
      "latency_budget_ms": 3000,
      "tags": ["fast", "negative"]
    },
    {
      "name": "dry-run-local-file",
      "command": ["ingest", "--urls", "fixtures/inputs/test_urls.txt", "--dry-run", "--output-dir", "/tmp/ingest-website-eval", "--max-pages", "1"],
      "expected_exit_code": 0,
      "expected_stdout_contains": ["Fetched"],
      "latency_budget_ms": 30000,
      "tags": ["integration"]
    }
  ],
  "compose_chains": [
    {
      "name": "sanity-then-help",
      "chain": ["ingest-website"],
      "steps": [
        {"command": ["--help"]},
        {"command": ["ingest", "--help"]}
      ],
      "latency_budget_ms": 10000
    }
  ]
}
