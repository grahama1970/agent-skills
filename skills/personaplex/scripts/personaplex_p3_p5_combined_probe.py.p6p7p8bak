#!/usr/bin/env python3
from __future__ import annotations
"""Combined P3-P5 PersonaPlex probe.

The default path is deterministic fallback with explicit claim boundaries.
Configured live services are attempted opportunistically and recorded honestly.
"""

import argparse
import asyncio
import json
import shutil
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from personaplex_p3_p5_live_services import (  # noqa: E402
    append_jsonl,
    attempt_evidence_case,
    attempt_memory_upsert,
    build_conversation_history_record,
    build_response_packet,
    deterministic_intent,
    deterministic_recall,
    maybe_probe_live_websocket,
    sha256_json,
    utc_now,
    validate_no_inline_vectors,
    write_json,
)


@dataclass
class ActiveTurn:
    session_id: str
    persona_id: str
    turn_id: int
    generation: int
    transcript: str
    source: str
    historical_tool_recommendations: list[dict[str, Any]]
    started_at_utc: str

    @property
    def key(self) -> str:
        return f"conversation:{self.session_id}:{self.turn_id:06d}"


class P3P5CombinedProbe:
    def __init__(
        self,
        *,
        fixture: dict[str, Any],
        run_root: Path,
        memory_url: str | None,
        memory_upsert_endpoint: str,
        evidence_case_url: str | None,
        live_websocket_url: str | None,
    ) -> None:
        self.fixture = fixture
        self.session_id = fixture.get("session_id", "p3p5-session")
        self.persona_id = fixture.get("persona_id", "embry")
        self.run_root = run_root
        self.memory_url = memory_url
        self.memory_upsert_endpoint = memory_upsert_endpoint
        self.evidence_case_url = evidence_case_url
        self.live_websocket_url = live_websocket_url
        self.events_jsonl = run_root / "events.jsonl"
        self.active_turn: ActiveTurn | None = None
        self.generation = 0
        self.next_turn_id = 0
        self.historical_authorities: list[dict[str, Any]] = []
        self.stale_rejections: list[dict[str, Any]] = []
        self.release_receipts: list[dict[str, Any]] = []
        self.memory_upsert_attempts: list[dict[str, Any]] = []
        self.evidence_case_attempts: list[dict[str, Any]] = []
        self.results: list[dict[str, Any]] = []
        self.sealed_turn_keys: list[str] = []
        self.websocket_probe: dict[str, Any] = {}

    def start_turn(self, transcript: str, source: str) -> ActiveTurn:
        if self.active_turn is not None:
            self.historical_authorities.append({
                "turn_id": self.active_turn.turn_id,
                "generation": self.active_turn.generation,
                "authoritative": False,
                "non_authoritative": True,
                "note": "superseded by newer final transcript; retained for audit/context only",
                "created_at_utc": utc_now(),
            })
        self.next_turn_id += 1
        self.generation += 1
        turn = ActiveTurn(
            session_id=self.session_id,
            persona_id=self.persona_id,
            turn_id=self.next_turn_id,
            generation=self.generation,
            transcript=transcript,
            source=source,
            historical_tool_recommendations=list(self.historical_authorities),
            started_at_utc=utc_now(),
        )
        self.active_turn = turn
        append_jsonl(self.events_jsonl, {
            "event": "p3_p5_final_transcript_started",
            "turn_id": turn.turn_id,
            "generation": turn.generation,
            "source": source,
            "transcript_hash": sha256_json({"transcript": transcript}),
            "output_gate_closed": True,
        })
        return turn

    def is_active(self, turn: ActiveTurn) -> bool:
        return bool(self.active_turn and self.active_turn.turn_id == turn.turn_id and self.active_turn.generation == turn.generation)

    def reject_stale(self, turn: ActiveTurn, operation: str, details: dict[str, Any] | None = None) -> dict[str, Any]:
        active = self.active_turn
        receipt = {
            "operation": operation,
            "stale_turn_id": turn.turn_id,
            "stale_generation": turn.generation,
            "active_turn_id": active.turn_id if active else None,
            "active_generation": active.generation if active else None,
            "reason": "stale turn callback fenced before mutation",
            "details": details or {},
            "created_at_utc": utc_now(),
        }
        self.stale_rejections.append(receipt)
        append_jsonl(self.events_jsonl, {"event": "stale_callback_receipt", **receipt})
        return receipt

    async def run_turn(self, turn: ActiveTurn, *, route_delay_ms: int, user_audio_bytes: bytes) -> dict[str, Any]:
        intent = deterministic_intent(
            turn.transcript,
            turn_id=turn.turn_id,
            generation=turn.generation,
            session_id=turn.session_id,
            persona_id=turn.persona_id,
        )
        append_jsonl(self.events_jsonl, {
            "event": "p3_p5_memory_intent_product",
            "turn_id": turn.turn_id,
            "generation": turn.generation,
            "action": (intent.get("json") or {}).get("action"),
            "intent_hash": intent.get("receipt_hash"),
            "current_turn_authority": True,
        })
        if route_delay_ms:
            await asyncio.sleep(route_delay_ms / 1000.0)
        if not self.is_active(turn):
            self.reject_stale(turn, "p3_p5_route_callback_after_delay", {"route_delay_ms": route_delay_ms})
            return {
                "turn_id": turn.turn_id,
                "generation": turn.generation,
                "status": "stale_fenced",
                "reason": "route work finished after a newer turn became active",
                "sealed_key": None,
                "route_endpoint": None,
                "gate_receipt": None,
            }

        recall = deterministic_recall(turn.transcript, intent)
        evidence = attempt_evidence_case(
            evidence_case_url=self.evidence_case_url,
            transcript=turn.transcript,
            intent=intent,
            recall=recall,
        )
        self.evidence_case_attempts.append(evidence)

        can_answer = bool(evidence.get("can_answer"))
        route_endpoint = "/memory /answer" if can_answer else evidence.get("selected_route", "/memory /clarify")
        response_text = (
            "I can answer only from the evidence-case packet."
            if can_answer
            else "I need one more grounded detail before I can answer safely: which canonical asset record or scan window should I use?"
        )
        factual_claims_allowed = bool(can_answer and evidence.get("substantive_compliance_claim_released"))
        product = {
            "route_endpoint": route_endpoint,
            "can_answer": can_answer,
            "factual_claims_allowed": factual_claims_allowed,
            "text": response_text,
            "source": "evidence_case" if evidence.get("real_create_evidence_case") else "fail_closed_evidence_unavailable",
            "receipt_hash": sha256_json({"route_endpoint": route_endpoint, "text": response_text, "evidence": evidence}),
        }
        response_packet = build_response_packet(
            session_id=turn.session_id,
            turn_id=turn.turn_id,
            generation=turn.generation,
            route_endpoint=route_endpoint,
            text=response_text,
            factual_claims_allowed=factual_claims_allowed,
            source_product_hash=product["receipt_hash"],
            current_intent_authority_hash=intent["receipt_hash"],
        )
        # Data stop: one simulated free model token is blocked while the gate is closed.
        gate_receipt = {
            "session_id": turn.session_id,
            "turn_id": turn.turn_id,
            "generation": turn.generation,
            "gate_closed_reason": "final transcript received; close gate before memory/evidence routing",
            "blocked_token_count": 1,
            "queue_depth_at_release": 0,
            "release_authorized": True,
            "response_packet_hash": response_packet["packet_hash"],
            "created_at_utc": utc_now(),
        }
        record = build_conversation_history_record(
            run_root=self.run_root,
            session_id=turn.session_id,
            persona_id=turn.persona_id,
            turn_id=turn.turn_id,
            generation=turn.generation,
            transcript=turn.transcript,
            intent=intent,
            recall=recall,
            evidence_attempt=evidence,
            response_packet=response_packet,
            gate_receipt=gate_receipt,
            historical_tool_recommendations=turn.historical_tool_recommendations,
            source=turn.source,
            user_audio_bytes=user_audio_bytes,
        )
        validate_no_inline_vectors(record)
        upsert_attempt = attempt_memory_upsert(
            memory_url=self.memory_url,
            endpoint=self.memory_upsert_endpoint,
            record=record,
            run_root=self.run_root,
        )
        self.memory_upsert_attempts.append(upsert_attempt)
        self.release_receipts.append(gate_receipt)
        self.sealed_turn_keys.append(record["_key"])
        append_jsonl(self.events_jsonl, {
            "event": "p3_p5_turn_sealed",
            "turn_id": turn.turn_id,
            "generation": turn.generation,
            "sealed_key": record["_key"],
            "route_endpoint": route_endpoint,
            "queue_depth_at_release": gate_receipt["queue_depth_at_release"],
            "real_memory_upsert": upsert_attempt.get("real_memory_upsert"),
            "real_create_evidence_case": evidence.get("real_create_evidence_case"),
        })
        return {
            "turn_id": turn.turn_id,
            "generation": turn.generation,
            "status": "sealed",
            "reason": "active bounded packet released and canonical conversation_history record prepared",
            "sealed_key": record["_key"],
            "route_action": (intent.get("json") or {}).get("action"),
            "route_endpoint": route_endpoint,
            "gate_receipt": gate_receipt,
            "memory_upsert_attempt": upsert_attempt,
            "evidence_case_attempt": evidence,
        }

    async def run(self) -> dict[str, Any]:
        if self.run_root.exists():
            shutil.rmtree(self.run_root)
        self.run_root.mkdir(parents=True, exist_ok=True)
        self.websocket_probe = await maybe_probe_live_websocket(self.live_websocket_url, self.fixture)
        append_jsonl(self.events_jsonl, {"event": "p3_p5_websocket_probe_complete", **self.websocket_probe})

        tasks: list[asyncio.Task] = []
        elapsed_ms = 0
        for item in self.fixture["turns"]:
            wait_ms = int(item.get("start_after_ms", 0)) - elapsed_ms
            if wait_ms > 0:
                await asyncio.sleep(wait_ms / 1000.0)
                elapsed_ms += wait_ms
            turn = self.start_turn(item["transcript"], item.get("source", "deterministic_transcript_fixture"))
            user_audio_bytes = (item.get("user_audio_marker") or item["transcript"]).encode("utf-8")
            tasks.append(asyncio.create_task(
                self.run_turn(
                    turn,
                    route_delay_ms=int(item.get("route_delay_ms", 0)),
                    user_audio_bytes=user_audio_bytes,
                )
            ))
        self.results = list(await asyncio.gather(*tasks))
        final = self.final_receipt()
        final_path = self.run_root / "p3-p5-final-receipt.json"
        write_json(final_path, final)
        final["final_receipt_path"] = str(final_path)
        write_json(final_path, final)
        return final

    def final_receipt(self) -> dict[str, Any]:
        real_memory = any(bool(item.get("real_memory_upsert")) for item in self.memory_upsert_attempts)
        real_evidence = any(bool(item.get("real_create_evidence_case")) for item in self.evidence_case_attempts)
        queue_depth = max([r["queue_depth_at_release"] for r in self.release_receipts], default=0)
        ok = (
            len(self.fixture["turns"]) >= 2
            and any(r.get("status") == "stale_fenced" for r in self.results)
            and any(r.get("status") == "sealed" for r in self.results)
            and queue_depth == 0
            and all(item.get("no_inline_vectors") for item in self.memory_upsert_attempts)
            and all(item.get("substantive_compliance_claim_released") is not True for item in self.evidence_case_attempts if not item.get("can_answer"))
        )
        return {
            "schema": "personaplex.p3_p5_combined.final_receipt.v1",
            "ok": bool(ok),
            "claim_boundary": "Combined P3-P5 probe. Deterministic fallback is not real Deepgram/GPU/memory/evidence proof unless the real_* flags are true.",
            "session_id": self.session_id,
            "persona_id": self.persona_id,
            "turn_count": len(self.fixture["turns"]),
            "active_turn_id": self.active_turn.turn_id if self.active_turn else None,
            "live_websocket": bool(self.websocket_probe.get("live_websocket")),
            "real_deepgram": bool(self.websocket_probe.get("real_deepgram")),
            "real_gpu_personaplex": bool(self.websocket_probe.get("real_gpu_personaplex")),
            "deepgram_mode": self.websocket_probe.get("deepgram_mode", "deterministic_transcript_fixture"),
            "websocket_probe": self.websocket_probe,
            "real_memory_upsert": real_memory,
            "memory_upsert_attempts": self.memory_upsert_attempts,
            "real_create_evidence_case": real_evidence,
            "evidence_case_attempts": self.evidence_case_attempts,
            "sealed_turn_keys": list(self.sealed_turn_keys),
            "sealed_turn_count": len(self.sealed_turn_keys),
            "stale_rejection_count": len(self.stale_rejections),
            "stale_rejections": self.stale_rejections,
            "release_receipts": self.release_receipts,
            "queue_depth_at_release": queue_depth,
            "results": self.results,
            "events_jsonl": str(self.events_jsonl),
            "created_at_utc": utc_now(),
        }


async def run_probe_from_args(args: argparse.Namespace) -> dict[str, Any]:
    fixture = json.loads(args.fixture.read_text(encoding="utf-8"))
    probe = P3P5CombinedProbe(
        fixture=fixture,
        run_root=args.run_root,
        memory_url=args.memory_url,
        memory_upsert_endpoint=args.memory_upsert_endpoint,
        evidence_case_url=args.evidence_case_url,
        live_websocket_url=args.live_websocket_url,
    )
    return await probe.run()


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fixture", type=Path, required=True)
    parser.add_argument("--run-root", type=Path, default=Path("/tmp/personaplex-p3-p5-combined-sanity"))
    parser.add_argument("--memory-url", default=None)
    parser.add_argument("--memory-upsert-endpoint", default="/upsert")
    parser.add_argument("--evidence-case-url", default=None)
    parser.add_argument("--live-websocket-url", default=None)
    parser.add_argument("--json", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    final = asyncio.run(run_probe_from_args(args))
    if args.json:
        print(json.dumps(final, indent=2, sort_keys=True, ensure_ascii=False))
    else:
        print(
            f"ok={str(final['ok']).lower()} live_websocket={str(final['live_websocket']).lower()} "
            f"real_memory_upsert={str(final['real_memory_upsert']).lower()} "
            f"real_create_evidence_case={str(final['real_create_evidence_case']).lower()}"
        )
        print(f"final_receipt={final['final_receipt_path']}")
    return 0 if final.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
