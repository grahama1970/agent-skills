# Copy to skills/hum/.env_temp for local hum experiments.
# Do not commit real secrets. The hum wrapper loads this after the project root
# .env so skill-local ElevenLabs experiments can override broad defaults.

# Required for ElevenLabs STS, Sound Effects, Voice Library, and similar-voice API calls.
ELEVENLABS_API_KEY=

# Optional defaults for local bakeoff scripts.
HUM_ELEVENLABS_MODEL_ID=eleven_multilingual_sts_v2
HUM_ELEVENLABS_DEFAULT_VOICE_ID=
HUM_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
