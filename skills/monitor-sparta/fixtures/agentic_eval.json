{
 "version": 2,
 "skill": "monitor-sparta",
 "trials": 3,
 "proof_scope": "live non-expert analyst retrieval over the SPARTA corpus, including abstention calibration",
 "claims": {
  "proves": "that a non-expert operator can resolve security identifiers across CWE/CAPEC/ATT&CK/D3FEND/NVD from the live corpus, that fabricated identifiers are rejected, and decisively that real-but-locally-absent identifiers return UNVERIFIED_LOCALLY instead of a misleading false negative",
  "does_not_prove": "plausibility judgment -- whether an exploitation chain is realistic, whether a detection rule would false-positive in production, or whether an AI's threat analysis is operationally sound. Those still require a practitioner."
 },
 "cases": [
  {
   "name": "sanity",
   "type": "positive",
   "command": [
    "bash",
    "../sanity.sh"
   ],
   "expected": {
    "exit_code": 0
   }
  },
  {
   "name": "non-expert-analyst-bench-live",
   "type": "positive",
   "real_world": true,
   "command": [
    "python3",
    "../scripts/analyst_bench.py",
    "--quiet"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "VERDICT: PASS"
    ]
   }
  },
  {
   "name": "fabricated-identifier-is-rejected",
   "type": "adversarial",
   "real_world": true,
   "command": [
    "python3",
    "../scripts/analyst_probe.py",
    "resolve",
    "CWE-999999"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "NOT_IN_CORPUS"
    ]
   }
  },
  {
   "name": "real-cve-absent-locally-must-abstain-not-deny",
   "type": "adversarial",
   "real_world": true,
   "command": [
    "python3",
    "../scripts/analyst_probe.py",
    "resolve",
    "CVE-2021-44228"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "UNVERIFIED_LOCALLY",
     "NOT evidence"
    ]
   }
  },
  {
   "name": "random-sampled-edges-congruent-e2e",
   "type": "adversarial",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "uv run python scripts/adversarial_alignment_probe.py edges --samples 250"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "\"failures\": []"
    ]
   }
  },
  {
   "name": "mutated-identifiers-never-resolve-e2e",
   "type": "adversarial",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "uv run python scripts/adversarial_alignment_probe.py mutate --samples 200"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "\"failures\": []"
    ]
   }
  },
  {
   "name": "embedded-ids-do-not-fragment-e2e",
   "type": "adversarial",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "uv run python scripts/adversarial_alignment_probe.py fragment --samples 200"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "\"failures\": []"
    ]
   }
  }
 ],
 "eval_tier": "compliance"
}