{
  "version": 2,
  "skill": "a-detection",
  "trials": 3,
  "eval_tier": "compliance",
  "proof_scope": "Full requested product capability; must remain non-READY without browser and independent real-human detection evidence.",
  "claims": {
    "proves": "Only declared mechanisms with capable guards and real HTTP readback.",
    "does_not_prove": "Any-provider authorship detection, human fairness, browser journey, or full release readiness."
  },
  "capability_claims": [
    {
      "id": "http-contract",
      "description": "The server must bind every accepted edit to one authenticated session and contiguous revision; exact retries must be idempotent.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "protocol"
    },
    {
      "id": "authorization",
      "description": "Only the session token holder may export/delete active records; errors must not echo submitted source or credentials.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "control_flow"
    },
    {
      "id": "value-representation",
      "description": "Unknown, malformed, unsupported, missing-model, and uncertified inputs must not be converted into an authorship accusation.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "value_bearing",
      "domain_profile": "json-scalar-v1"
    },
    {
      "id": "evidence-integrity",
      "description": "An independent verifier must reconstruct all accepted Unicode edits and reject changed, omitted, reordered, or wrongly bound evidence.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "control_flow"
    },
    {
      "id": "dataset-independence",
      "description": "Dataset evaluation must exclude session, author, task, repository, exact-source and normalized-token overlap between splits and hold out generator families.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "other"
    },
    {
      "id": "calibration",
      "description": "A frozen threshold must be selected without calibration/test labels; low-FPR qualification must use an independent human-session confidence bound.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "other"
    },
    {
      "id": "unicode-replay",
      "description": "An independent verifier must reconstruct all accepted Unicode edits and reject changed, omitted, reordered, or wrongly bound evidence.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "property_or_fuzz": true
      },
      "claim_semantics": "value_bearing",
      "domain_profile": "json-scalar-v1"
    },
    {
      "id": "training",
      "description": "Synthetic examples and deterministic passing tests must never establish real-human or any-provider detection efficacy.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "other"
    },
    {
      "id": "http-transport",
      "description": "The server must bind every accepted edit to one authenticated session and contiguous revision; exact retries must be idempotent.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "live_e2e": true
      },
      "claim_semantics": "protocol"
    },
    {
      "id": "server-time",
      "description": "REQ-04: server-time and source budget enforcement",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "timing"
    },
    {
      "id": "browser-journey",
      "description": "REQ-11: real-browser assessment journey including independent record readback",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "live_e2e": true
      },
      "claim_semantics": "human_perceptual"
    },
    {
      "id": "provider-agnostic-detection",
      "description": "Provider-agnostic detection quality must be measured on independently sourced, consented real-human sessions and unseen model families at predeclared session-level FPRs.",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "live_e2e": true,
        "human_evaluation": true
      },
      "claim_semantics": "other"
    },
    {
      "id": "no-execution",
      "description": "REQ-13: candidate source is never executed on the host",
      "criticality": "critical",
      "required": true,
      "evidence_required": {
        "deterministic": true
      },
      "claim_semantics": "control_flow"
    }
  ],
