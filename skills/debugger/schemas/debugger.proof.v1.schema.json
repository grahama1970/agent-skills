{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debugger.proof.v1",
  "title": "Debugger Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer",
    "debugger",
    "repro",
    "breakpoints",
    "stopped",
    "captures",
    "assessment",
    "analysis"
  ],
  "properties": {
    "schema": {
      "const": "debugger.proof.v1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "debugger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "mode"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "mode": {
          "enum": ["python-bdb", "node-inspector", "rust-gdb", "vscode-bridge", "dap", "other"]
        }
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "items": {"type": "string"}
        },
        "description": {"type": "string"}
      }
    },
    "breakpoints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/breakpoint"}
    },
    "stopped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hit", "reason", "frame"],
      "properties": {
        "hit": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "frame": {"$ref": "#/$defs/frame"}
      }
    },
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedLocals", "locals", "watches"],
      "properties": {
        "requestedLocals": {
          "type": "array",
          "items": {"type": "string"}
        },
        "locals": {
          "type": "object",
          "additionalProperties": true
        },
        "watches": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofValid", "variableInspectionValid", "limitations"],
      "properties": {
        "proofValid": {"type": "boolean"},
        "variableInspectionValid": {"type": "boolean"},
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "sessionTranscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sessionId", "stopSequences", "eventLogRef"],
      "properties": {
        "schema": {"const": "debugger.session_transcript_ref.v1"},
        "sessionId": {"type": "string", "minLength": 1},
        "stopSequences": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "eventLogRef": {"type": "string", "minLength": 1},
        "sessionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "nextEdit"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1},
        "nextEdit": {"type": "string"},
        "humanBreakpoint": {"type": "string"}
      }
    }
  },
  "$defs": {
    "breakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "hit"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "source": {"type": "string"},
        "verified": {
          "oneOf": [
            {"type": "boolean"},
            {"enum": ["unavailable", "unknown"]}
          ]
        },
        "hit": {"type": "boolean"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "function": {"type": "string"},
        "threadId": {"type": ["integer", "string"]},
        "sessionId": {"type": "string"}
      }
    }
  }
}
