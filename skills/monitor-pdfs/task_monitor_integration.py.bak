#!/usr/bin/env python3
"""Task Monitor Integration for Monitor-PDFs.

Reports pipeline progress to ~/.pi/task-monitor/ for centralized monitoring.
"""
import json
import os
import time
from pathlib import Path
from typing import Any, Dict, List, Optional
from loguru import logger

TASK_MONITOR_REGISTRY = Path.home() / ".pi" / "task-monitor" / "registry.json"
STATE_DIR = Path.home() / ".pi" / "monitor-pdfs"

class PDFMonitorTracker:
    """Task-monitor compatible tracker for PDF harvesting and processing."""

    def __init__(self, name: str = "pdf-monitor"):
        self.name = name
        self.state_file = STATE_DIR / "task_state_dashboard.json"
        
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.start_time = time.time()
        
        self._register_task()

    def _register_task(self):
        """Register with task-monitor."""
        try:
            TASK_MONITOR_REGISTRY.parent.mkdir(parents=True, exist_ok=True)
            registry = {}
            if TASK_MONITOR_REGISTRY.exists():
                try:
                    registry = json.loads(TASK_MONITOR_REGISTRY.read_text())
                except Exception:
                    registry = {}

            registry[self.name] = {
                "state_file": str(self.state_file),
                "description": "PDF Harvesting & Processing Dashboard",
                "project": "extractor",
                "registered_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            }

            tmp = TASK_MONITOR_REGISTRY.with_suffix(".tmp")
            tmp.write_text(json.dumps(registry, indent=2))
            os.replace(tmp, TASK_MONITOR_REGISTRY)
        except Exception as e:
            logger.debug("extraction failed: {}", e)

    def report_progress(self, harvest_stats: List[Dict], batch_stats: Dict, image_stats: Dict):
        """Update task-monitor state file with current metrics."""
        now = time.time()
        elapsed = now - self.start_time

        # Calculate an overall completion metric if possible, or just aggregate
        total_pdfs = batch_stats.get("total", 11394)
        processed_pdfs = batch_stats.get("current", 0)
        progress_pct = batch_stats.get("percent", 0)

        harvest_count = sum(h["count"] for h in harvest_stats)
        
        state = {
            "completed": processed_pdfs,
            "total": total_pdfs,
            "description": "PDF Pipeline Monitoring",
            "status": "running",
            "progress_pct": round(progress_pct, 1),
            "elapsed_seconds": round(elapsed, 1),
            "last_updated": time.strftime("%Y-%m-%d %H:%M:%S"),
            "stats": {
                "harvested_pdfs": harvest_count,
                "batch_processed": processed_pdfs,
                "extracted_images": image_stats.get("total", 0),
                "arxiv_progress": next((f"{h['current']}/{h['target']}" for h in harvest_stats if h["name"] == "Arxiv"), "0/0"),
            },
            "harvest_details": harvest_stats,
            "image_details": image_stats
        }

        try:
            tmp = self.state_file.with_suffix(".tmp")
            tmp.write_text(json.dumps(state, indent=2))
            os.replace(tmp, self.state_file)
        except Exception as e:
            logger.debug("tmp failed: {}", e)
