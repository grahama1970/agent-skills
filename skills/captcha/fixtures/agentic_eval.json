{
  "version": 2,
  "skill": "captcha",
  "trials": 2,
  "proof_scope": "multi-trial local agentic safety, Surf/captcha seam gate, and pinned real defensive CAPTCHA/bot-detection reference coverage",
  "claims": {
    "proves": "the real captcha entrypoint reports safe status, rejects unauthorized public targets, refuses live effects without --execute, preserves missing-runtime blockers, emits an Ask skill.run DAG, binds pointer dispatch to Surf without dispatching input, and is evaluated against a pinned real defensive CAPTCHA/bot-detection reference project",
    "does_not_prove": "live ReCAP model performance, public-site CAPTCHA solving, authenticated browser provider behavior, or that a pointer dispatch solves a challenge"
  },
  "capability_claims": [
    {
      "id": "captcha.defensive_authorization_boundary",
      "description": "Captcha fails closed for public targets and live effects unless the local defensive authorization contract is explicit.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "captcha.surf_pointer_plan_seam",
      "description": "Captcha can prepare Surf pointer dispatch plans without dispatching browser input itself.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "captcha.real_defensive_reference",
      "description": "Captcha eval coverage includes a pinned real open-source defensive CAPTCHA/bot-detection reference without public-provider solving.",
      "criticality": "critical",
      "evidence_required": {
        "live_e2e": true
      }
    }
  ],
  "seams": [
    {
      "seam_id": "captcha.authorization_preflight",
      "seam_type": "policy_boundary",
      "criticality": "critical",
      "required_evidence": ["deterministic"]
    },
    {
      "seam_id": "captcha.surf_pointer_dispatch_plan",
      "seam_type": "skill_composition",
      "criticality": "critical",
      "required_evidence": ["deterministic"]
    },
    {
      "seam_id": "captcha.real_defensive_reference",
      "seam_type": "external_reference",
      "criticality": "critical",
      "required_evidence": ["live_e2e"]
    }
  ],
  "cases": [
    {
      "name": "safe-default-real-entrypoint",
      "type": "positive",
      "real_world": true,
      "evidence_class": "deterministic",
      "command": ["../run.sh"],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["captcha.status.v1"]
      }
    },
    {
      "name": "public-target-fails-closed",
      "type": "adversarial",
      "evidence_class": "deterministic",
      "supports_claims": ["captcha.defensive_authorization_boundary"],
      "seams": ["captcha.authorization_preflight"],
      "command": [
        "../run.sh",
        "authorization-preflight",
        "--manifest",
        "authorization-invalid-public.json",
        "--action",
        "evaluate",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["target_not_loopback", "BLOCKED"]
      }
    },
    {
      "name": "live-effect-requires-explicit-execute",
      "type": "negative",
      "evidence_class": "deterministic",
      "supports_claims": ["captcha.defensive_authorization_boundary"],
      "seams": ["captcha.authorization_preflight"],
      "command": [
        "../run.sh",
        "evaluate",
        "--manifest",
        "authorization-valid-local.json",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["execution_not_confirmed", "BLOCKED"]
      }
    },
    {
      "name": "missing-runtime-plan-is-not-pass",
      "type": "negative",
      "evidence_class": "deterministic",
      "command": [
        "../run.sh",
        "plan",
        "--manifest",
        "authorization-valid-local.json",
        "--recap-root",
        "/definitely/missing/ReCAP-Agent",
        "--recap-python",
        "/definitely/missing/ReCAP-Agent/.venv/bin/python",
        "--output-root",
        "/mnt/storage12tb/skills/captcha/outputs",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["NEEDS_ATTENTION", "blockers"]
      }
    },
    {
      "name": "ask-composition-is-explicit",
      "type": "positive",
      "evidence_class": "deterministic",
      "command": [
        "../run.sh",
        "ask-dag",
        "--manifest",
        "authorization-valid-local.json",
        "--out",
        "/tmp/captcha-agentic-eval-dag.json",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["ask.dag.v1", "skill.run", "captcha"]
      }
    },
    {
      "name": "pointer-dispatch-binds-to-surf-without-execution",
      "type": "positive",
      "evidence_class": "deterministic",
      "supports_claims": ["captcha.surf_pointer_plan_seam"],
      "seams": ["captcha.surf_pointer_dispatch_plan"],
      "command": [
        "bash",
        "-c",
        "../run.sh pointer-plan --manifest authorization-valid-local.json --request pointer-motion-request-valid.json --out /tmp/captcha-agentic-pointer-plan.json --json >/tmp/captcha-agentic-pointer-plan.stdout.json && ../run.sh pointer-dispatch-plan --manifest authorization-valid-local.json --plan /tmp/captcha-agentic-pointer-plan.json --out /tmp/captcha-agentic-pointer-dispatch-plan.json --json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "captcha.pointer_dispatch_plan.v1",
          "surf.pointer_dispatch_receipt.v1",
          "pointer.dispatch"
        ],
        "artifacts": [
          {
            "path": "/tmp/captcha-agentic-pointer-dispatch-plan.json",
            "json_pointer": "/surf/expected_schema",
            "equals": "surf.pointer_dispatch_receipt.v1"
          },
          {
            "path": "/tmp/captcha-agentic-pointer-dispatch-plan.json",
            "json_pointer": "/surf/post_observation_required",
            "equals": true
          }
        ]
      }
    },
    {
      "name": "fcaptcha-real-defensive-reference-tests",
      "type": "positive",
      "real_world": true,
      "evidence_class": "live_e2e",
      "readback": true,
      "supports_claims": ["captcha.real_defensive_reference"],
      "seams": ["captcha.real_defensive_reference"],
      "command": [
        "bash",
        "-c",
        "cd .. && ./run.sh defensive-reference --output /tmp/captcha-fcaptcha-reference-eval.json --json"
      ],
      "timeout_seconds": 240,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "captcha.fcaptcha_reference_eval.v1",
          "WebDecoy/FCaptcha",
          "6/6 passed",
          "17/17 passed"
        ],
        "artifacts": [
          {
            "path": "/tmp/captcha-fcaptcha-reference-eval.json",
            "json_pointer": "/success",
            "equals": true
          },
          {
            "path": "/tmp/captcha-fcaptcha-reference-eval.json",
            "json_pointer": "/real_example",
            "equals": true
          },
          {
            "path": "/tmp/captcha-fcaptcha-reference-eval.json",
            "json_pointer": "/source_commit",
            "equals": "dbe52eab975bb39161dd2a54d69924de51f63000"
          },
          {
            "path": "/tmp/captcha-fcaptcha-reference-eval.json",
            "json_pointer": "/public_captcha_provider",
            "equals": false
          },
          {
            "path": "/tmp/captcha-fcaptcha-reference-eval.json",
            "json_pointer": "/solver_or_bypass",
            "equals": false
          },
          {
            "path": "/tmp/captcha-fcaptcha-reference-eval.json",
            "json_pointer": "/skill_entrypoint",
            "equals": "captcha defensive-reference"
          }
        ]
      }
    }
  ]
}
