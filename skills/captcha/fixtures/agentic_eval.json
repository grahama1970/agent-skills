{
  "version": 2,
  "skill": "captcha",
  "trials": 2,
  "proof_scope": "multi-trial local agentic safety and Surf/captcha seam gate",
  "claims": {
    "proves": "the real captcha entrypoint reports safe status, rejects unauthorized public targets, refuses live effects without --execute, preserves missing-runtime blockers, emits an Ask skill.run DAG, and binds pointer dispatch to Surf without dispatching input",
    "does_not_prove": "live ReCAP model performance, public-site CAPTCHA solving, authenticated browser provider behavior, or that a pointer dispatch solves a challenge"
  },
  "cases": [
    {
      "name": "safe-default-real-entrypoint",
      "type": "positive",
      "real_world": true,
      "evidence_class": "deterministic",
      "command": ["../run.sh"],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["captcha.status.v1"]
      }
    },
    {
      "name": "public-target-fails-closed",
      "type": "adversarial",
      "evidence_class": "deterministic",
      "command": [
        "../run.sh",
        "authorization-preflight",
        "--manifest",
        "authorization-invalid-public.json",
        "--action",
        "evaluate",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["target_not_loopback", "BLOCKED"]
      }
    },
    {
      "name": "live-effect-requires-explicit-execute",
      "type": "negative",
      "evidence_class": "deterministic",
      "command": [
        "../run.sh",
        "evaluate",
        "--manifest",
        "authorization-valid-local.json",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["execution_not_confirmed", "BLOCKED"]
      }
    },
    {
      "name": "missing-runtime-plan-is-not-pass",
      "type": "negative",
      "evidence_class": "deterministic",
      "command": [
        "../run.sh",
        "plan",
        "--manifest",
        "authorization-valid-local.json",
        "--recap-root",
        "/definitely/missing/ReCAP-Agent",
        "--recap-python",
        "/definitely/missing/ReCAP-Agent/.venv/bin/python",
        "--output-root",
        "/mnt/storage12tb/skills/captcha/outputs",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["NEEDS_ATTENTION", "blockers"]
      }
    },
    {
      "name": "ask-composition-is-explicit",
      "type": "positive",
      "evidence_class": "deterministic",
      "command": [
        "../run.sh",
        "ask-dag",
        "--manifest",
        "authorization-valid-local.json",
        "--out",
        "/tmp/captcha-agentic-eval-dag.json",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["ask.dag.v1", "skill.run", "captcha"]
      }
    },
    {
      "name": "pointer-dispatch-binds-to-surf-without-execution",
      "type": "positive",
      "evidence_class": "deterministic",
      "command": [
        "bash",
        "-c",
        "../run.sh pointer-plan --manifest authorization-valid-local.json --request pointer-motion-request-valid.json --out /tmp/captcha-agentic-pointer-plan.json --json >/tmp/captcha-agentic-pointer-plan.stdout.json && ../run.sh pointer-dispatch-plan --manifest authorization-valid-local.json --plan /tmp/captcha-agentic-pointer-plan.json --out /tmp/captcha-agentic-pointer-dispatch-plan.json --json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "captcha.pointer_dispatch_plan.v1",
          "surf.pointer_dispatch_receipt.v1",
          "pointer.dispatch"
        ],
        "artifacts": [
          {
            "path": "/tmp/captcha-agentic-pointer-dispatch-plan.json",
            "json_pointer": "/surf/expected_schema",
            "equals": "surf.pointer_dispatch_receipt.v1"
          },
          {
            "path": "/tmp/captcha-agentic-pointer-dispatch-plan.json",
            "json_pointer": "/surf/post_observation_required",
            "equals": true
          }
        ]
      }
    }
  ]
}
