{
  "version": 2,
  "skill": "captcha",
  "trials": 3,
  "proof_scope": "multi-trial local agentic safety and composition gate",
  "claims": {
    "proves": "the real captcha entrypoint repeatedly reports safe status, rejects unauthorized public targets, refuses live effects without --execute, preserves missing-runtime blockers, and emits an Ask skill.run DAG",
    "does_not_prove": "live ReCAP model performance, nondeterministic CAPTCHA-solving behavior, Surf browser transport behavior, or release readiness"
  },
  "cases": [
    {
      "name": "safe-default-real-entrypoint",
      "type": "positive",
      "real_world": true,
      "command": ["../run.sh"],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["captcha.status.v1"]
      }
    },
    {
      "name": "public-target-fails-closed",
      "type": "adversarial",
      "command": [
        "../run.sh",
        "authorization-preflight",
        "--manifest",
        "authorization-invalid-public.json",
        "--action",
        "evaluate",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["target_not_loopback", "BLOCKED"]
      }
    },
    {
      "name": "live-effect-requires-explicit-execute",
      "type": "negative",
      "command": [
        "../run.sh",
        "evaluate",
        "--manifest",
        "authorization-valid-local.json",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["execution_not_confirmed", "BLOCKED"]
      }
    },
    {
      "name": "missing-runtime-plan-is-not-pass",
      "type": "negative",
      "command": [
        "../run.sh",
        "plan",
        "--manifest",
        "authorization-valid-local.json",
        "--recap-root",
        "/definitely/missing/ReCAP-Agent",
        "--recap-python",
        "/definitely/missing/ReCAP-Agent/.venv/bin/python",
        "--output-root",
        "/mnt/storage12tb/skills/captcha/outputs",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 2,
        "stdout_contains": ["NEEDS_ATTENTION", "blockers"]
      }
    },
    {
      "name": "ask-composition-is-explicit",
      "type": "positive",
      "command": [
        "../run.sh",
        "ask-dag",
        "--manifest",
        "authorization-valid-local.json",
        "--out",
        "/tmp/captcha-agentic-eval-dag.json",
        "--json"
      ],
      "timeout_seconds": 45,
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["ask.dag.v1", "skill.run", "captcha"]
      }
    }
  ]
}
