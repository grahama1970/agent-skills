{
  "$defs": {
    "EvaluationAction": {
      "enum": [
        "status",
        "plan",
        "evaluate",
        "verify",
        "ask-dag"
      ],
      "title": "EvaluationAction",
      "type": "string"
    },
    "SeamValidation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "const": "PASS",
          "default": "PASS",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SeamValidation",
      "type": "object"
    },
    "TeamMode": {
      "enum": [
        "blue_team",
        "red_team"
      ],
      "title": "TeamMode",
      "type": "string"
    }
  },
  "$id": "captcha.authorization_receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/EvaluationAction"
    },
    "authorization_id": {
      "title": "Authorization Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "model_base_url": {
      "title": "Model Base Url",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "provider": {
      "const": "dynamic",
      "default": "dynamic",
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": "captcha.authorization_receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seam_validation": {
      "$ref": "#/$defs/SeamValidation"
    },
    "status": {
      "const": "PASS",
      "default": "PASS",
      "title": "Status",
      "type": "string"
    },
    "target_url": {
      "title": "Target Url",
      "type": "string"
    },
    "team_mode": {
      "$ref": "#/$defs/TeamMode"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "authorization_id",
    "action",
    "validated_at",
    "expires_at",
    "manifest_sha256",
    "target_url",
    "model_base_url",
    "team_mode",
    "policy_version",
    "limitations",
    "seam_validation"
  ],
  "title": "AuthorizationReceipt",
  "type": "object"
}
