{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grahama.co/schemas/monitor-opportunities/report-v1.json",
  "title": "monitor-opportunities Stage 0 morning report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "generated_at",
    "contract_version",
    "immutable_goal",
    "stage",
    "operational_readiness",
    "capability_authority",
    "lane_coverage",
    "source_receipts",
    "eligibility_rejections",
    "opportunities",
    "resume_variants",
    "outreach_packets",
    "applications",
    "interview_prep",
    "decision_actions",
    "artifact_accounting",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "monitor_opportunities.report.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^mo_[A-Za-z0-9._:-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "immutable_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "goal_hash"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 40
        },
        "goal_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stage": {
      "const": "STAGE_0_RESEARCH_ONLY"
    },
    "operational_readiness": {
      "type": "string",
      "enum": [
        "FIXTURE_ONLY",
        "NOT_ESTABLISHED",
        "DEGRADED",
        "STAGE_0_READY"
      ]
    },
    "capability_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_report",
        "local_resume_variant",
        "gmail_mailbox_draft_create",
        "linkedin_human_handoff_ready",
        "ats_form_inspect",
        "ats_form_prefill",
        "ats_form_submit"
      ],
      "properties": {
        "local_report": {
          "enum": [
            "ALLOWED",
            "NOT_IMPLEMENTED"
          ]
        },
        "local_resume_variant": {
          "enum": [
            "ALLOWED",
            "NOT_IMPLEMENTED"
          ]
        },
        "gmail_mailbox_draft_create": {
          "enum": [
            "BLOCKED_STAGE_0",
            "NOT_IMPLEMENTED"
          ]
        },
        "linkedin_human_handoff_ready": {
          "enum": [
            "BLOCKED_STAGE_0",
            "NOT_IMPLEMENTED"
          ]
        },
        "ats_form_inspect": {
          "enum": [
            "BLOCKED_STAGE_0",
            "NOT_IMPLEMENTED"
          ]
        },
        "ats_form_prefill": {
          "enum": [
            "BLOCKED_STAGE_0",
            "NOT_IMPLEMENTED"
          ]
        },
        "ats_form_submit": {
          "enum": [
            "BLOCKED_STAGE_0",
            "NOT_IMPLEMENTED"
          ]
        }
      }
    },
    "lane_coverage": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/laneCoverage"
      }
    },
    "source_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceReceipt"
      }
    },
    "eligibility_rejections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eligibilityRejection"
      }
    },
    "opportunities": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    },
    "resume_variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resumeVariant"
      }
    },
    "outreach_packets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outreachPacket"
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/application"
      }
    },
    "interview_prep": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interviewPrep"
      }
    },
    "decision_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decisionAction"
      }
    },
    "artifact_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_worthy_total",
        "visible_total",
        "hidden_total",
        "hidden_ids"
      ],
      "properties": {
        "action_worthy_total": {
          "type": "integer",
          "minimum": 0
        },
        "visible_total": {
          "type": "integer",
          "minimum": 0
        },
        "hidden_total": {
          "const": 0
        },
        "hidden_ids": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "application_packets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/applicationPacket"
      }
    },
    "source_intel": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceIntel"
      }
    },
    "relationship_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationshipSignal"
      }
    }
  },
  "$defs": {
    "resultStatus": {
      "type": "string",
      "enum": [
        "MATCHES",
        "NO_MATCHES",
        "FEED_DOWN",
        "AUTH_REQUIRED",
        "AUTH_FAILED",
        "RATE_LIMITED",
        "POLICY_BLOCKED",
        "STALE_DATA",
        "INVALID_REQUEST",
        "INVALID_RESPONSE",
        "NOT_SEARCHED"
      ]
    },
    "laneCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "searched",
        "result_status",
        "candidates_observed",
        "candidates_admitted",
        "source_receipt_ids",
        "limitations"
      ],
      "properties": {
        "lane": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "searched": {
          "type": "boolean"
        },
        "result_status": {
          "$ref": "#/$defs/resultStatus"
        },
        "candidates_observed": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_admitted": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_admitted_opportunities": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_admitted_source_intel": {
          "type": "integer",
          "minimum": 0
        },
        "source_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "searched": {
                "const": false
              }
            },
            "required": [
              "searched"
            ]
          },
          "then": {
            "properties": {
              "result_status": {
                "const": "NOT_SEARCHED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result_status": {
                "const": "NOT_SEARCHED"
              }
            },
            "required": [
              "result_status"
            ]
          },
          "then": {
            "properties": {
              "searched": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "lane",
        "provider",
        "target",
        "source_class",
        "result_status",
        "observed_at",
        "request_summary",
        "response_status",
        "content_type",
        "response_bytes",
        "content_sha256",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "enum": [
            "employer_ats",
            "federal_feed",
            "human_supplied_linkedin",
            "ops_linkedin_authorized_read_only",
            "primary_company_source",
            "source_locator",
            "job_board",
            "sam.gov_website",
            "meetup_surf_capture",
            "human_supplied_indeed",
            "human_supplied_hiddenjobs"
          ]
        },
        "result_status": {
          "$ref": "#/$defs/resultStatus"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "request_summary": {
          "type": "string",
          "minLength": 1
        },
        "response_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automation_policy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "linkedin_authorized_read_only_no_actions",
            "linkedin_no_automation",
            "meetup_authorized_read_only_no_rsvp_no_message",
            "read_only_browser_capture_no_apply_no_message"
          ]
        },
        "required_source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "fallback_for_receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "eligibilityRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rejection_id",
        "lane",
        "title",
        "organization",
        "reason_code",
        "source_receipt_id",
        "action_worthy",
        "visible_in_report"
      ],
      "properties": {
        "rejection_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "enum": [
            "REJECT_RELOCATION_REQUIRED",
            "REJECT_LOCATION",
            "REJECT_CLEARANCE_REQUIRED_UNATTESTED",
            "REJECT_WORK_AUTHORIZATION_MISMATCH",
            "REJECT_STALE",
            "REJECT_DUPLICATE_OR_ALREADY_APPLIED",
            "REJECT_SOURCE_INVALID",
            "HUMAN_REVIEW_ELIGIBILITY_UNKNOWN",
            "HUMAN_REVIEW_LOCATION_AMBIGUOUS",
            "REJECT_STALE_AGE",
            "REJECT_ROLE_TYPE"
          ]
        },
        "source_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "action_worthy": {
          "const": false
        },
        "visible_in_report": {
          "const": true
        }
      }
    },
    "screeningProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "inferred",
        "confidence",
        "evidence_refs",
        "unknowns"
      ],
      "properties": {
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "lane",
        "opportunity_type",
        "title",
        "organization",
        "location",
        "source_receipt_ids",
        "eligibility_state",
        "fit_score",
        "claim_keys",
        "why_candidate",
        "screening_interface_profile",
        "status",
        "action_worthy",
        "visible_in_report"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "opportunity_type": {
          "enum": [
            "employment_posting",
            "federal_notice",
            "commercial_signal"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "workplace_type",
            "relocation_required"
          ],
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1
            },
            "workplace_type": {
              "enum": [
                "WNY_HYBRID",
                "WNY_ONSITE",
                "REMOTE",
                "NOT_APPLICABLE"
              ]
            },
            "relocation_required": {
              "type": "boolean"
            }
          }
        },
        "source_receipt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "eligibility_state": {
          "enum": [
            "ELIGIBLE_WNY_HYBRID",
            "ELIGIBLE_WNY_ONSITE",
            "ELIGIBLE_REMOTE",
            "ELIGIBLE_COMMERCIAL_SIGNAL",
            "ELIGIBLE_FEDERAL_NOTICE"
          ]
        },
        "fit_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "claim_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^claim:"
          }
        },
        "why_candidate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "screening_interface_profile": {
          "$ref": "#/$defs/screeningProfile"
        },
        "status": {
          "const": "SHORTLISTED"
        },
        "action_worthy": {
          "const": true
        },
        "visible_in_report": {
          "const": true
        },
        "posting_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "apply_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_evidence_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resumeVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "opportunity_id",
        "claim_snapshot_sha256",
        "claim_keys",
        "artifact_refs",
        "presentation_diff",
        "status",
        "action_worthy",
        "visible_in_report"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "claim_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^claim:"
          }
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "presentation_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_changes",
            "prohibited_changes"
          ],
          "properties": {
            "allowed_changes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prohibited_changes": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "const": "WOULD_PRESENT_STAGE0"
        },
        "action_worthy": {
          "const": true
        },
        "visible_in_report": {
          "const": true
        }
      }
    },
    "outreachPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "opportunity_id",
        "channel",
        "recipient",
        "contact_provenance",
        "subject",
        "body",
        "character_count",
        "claim_keys",
        "claim_snapshot_sha256",
        "roundtable_status",
        "roundtable_verdict",
        "roundtable_receipt_digest",
        "payload_digest",
        "readiness_state",
        "effect_status",
        "sendable",
        "candidate_transmits",
        "human_send_steps",
        "action_worthy",
        "visible_in_report"
      ],
      "properties": {
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "GMAIL",
            "LINKEDIN"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "claim_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^claim:"
          }
        },
        "roundtable_status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "BLOCKED"
          ]
        },
        "effect_status": {
          "enum": [
            "WOULD_PRESENT_STAGE0",
            "DRAFT_CREATED_NOT_SENT",
            "INDETERMINATE"
          ]
        },
        "sendable": {
          "const": false
        },
        "candidate_transmits": {
          "const": true
        },
        "action_worthy": {
          "const": true
        },
        "visible_in_report": {
          "const": true
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "contact_provenance": {
          "type": "string",
          "minLength": 1
        },
        "character_count": {
          "type": "integer",
          "minimum": 1
        },
        "roundtable_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SEND_AS_IS",
            "SEND_WITH_REVISIONS",
            null
          ]
        },
        "roundtable_receipt_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "readiness_state": {
          "enum": [
            "BLOCKED_ROUNDTABLE",
            "REVIEW_PERMITTED"
          ]
        },
        "human_send_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "draft_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mailbox_draft_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect_receipt_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_payload_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "applicationField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "field_type",
        "required",
        "disposition",
        "automated_answer"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "field_type": {
          "enum": [
            "text",
            "email",
            "phone",
            "file",
            "choice",
            "free_text",
            "self_identification",
            "salary",
            "clearance",
            "work_authorization",
            "legal"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "human_required",
            "exact_approved_answer",
            "blocked"
          ]
        },
        "automated_answer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field_type": {
                "enum": [
                  "free_text",
                  "self_identification",
                  "salary",
                  "clearance",
                  "work_authorization",
                  "legal"
                ]
              }
            },
            "required": [
              "field_type"
            ]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "human_required"
              },
              "automated_answer": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "opportunity_id",
        "ats_provider",
        "state",
        "authorized",
        "form_schema_digest",
        "fields",
        "action_worthy",
        "visible_in_report"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "ats_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "const": "BLOCKED_STAGE_0"
        },
        "authorized": {
          "const": false
        },
        "form_schema_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applicationField"
          }
        },
        "action_worthy": {
          "const": true
        },
        "visible_in_report": {
          "const": true
        }
      }
    },
    "interviewPrep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "talking_points"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "talking_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "claim_keys",
              "source_refs"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "claim_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^claim:"
                }
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "decisionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target_type",
        "enabled",
        "effects_external"
      ],
      "properties": {
        "action": {
          "enum": [
            "ACCEPT_RESUME_VARIANT",
            "ATTEND_MEETUP",
            "AUTHORIZE_APPLICATION_PAYLOAD",
            "DEFER",
            "DEFER_CONTACT",
            "KEEP",
            "MARK_HUMAN_SENT_GMAIL",
            "MARK_HUMAN_SENT_LINKEDIN",
            "PROPOSE_CLAIM_AMENDMENT",
            "RECONNECT_CONTACT",
            "REJECT",
            "SKIP_MEETUP",
            "WATCH_MEETUP",
            "WITHHOLD_APPLICATION"
          ]
        },
        "target_type": {
          "enum": [
            "application",
            "opportunity",
            "outreach_packet",
            "relationship_signal",
            "resume_variant",
            "source_intel"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "effects_external": {
          "const": false
        }
      }
    },
    "applicationPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "application_id",
        "opportunity_id",
        "posting_digest",
        "screening_interface_profile_digest",
        "resume_variant_id",
        "resume_artifacts",
        "resume_digest",
        "claim_snapshot_digest",
        "field_answer_digest",
        "attachment_digest",
        "outreach_digest",
        "policy_observations",
        "policy_observations_digest",
        "approval_payload_digest",
        "approval_status",
        "packet_ref",
        "action_worthy",
        "visible_in_report",
        "external_effects"
      ],
      "properties": {
        "schema": {
          "const": "monitor_opportunities.application_packet.v1"
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string"
        },
        "application_id": {
          "type": "string",
          "minLength": 1
        },
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "posting_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "screening_interface_profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resume_variant_id": {
          "type": "string",
          "minLength": 1
        },
        "resume_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "exists",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "exists": {
                "type": "boolean"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "resume_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "claim_snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "field_answer_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attachment_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outreach_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "policy_observations_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_status": {
          "enum": [
            "NOT_AUTHORIZED"
          ]
        },
        "packet_ref": {
          "type": "string",
          "minLength": 1
        },
        "action_worthy": {
          "const": true
        },
        "visible_in_report": {
          "const": true
        },
        "external_effects": {
          "const": false
        }
      }
    },
    "sourceIntel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "lane",
        "signal_type",
        "title",
        "organization",
        "source_receipt_ids",
        "decision",
        "reasons",
        "action_worthy",
        "visible_in_report"
      ],
      "properties": {
        "signal_id": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "signal_type": {
          "enum": [
            "LINKEDIN_LOCATOR",
            "MEETUP_NETWORKING"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "source_receipt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_evidence_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "enum": [
            "LOCATOR_ONLY",
            "ATTEND_MEETUP",
            "WATCH_MEETUP",
            "SKIP_MEETUP"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action_worthy": {
          "type": "boolean"
        },
        "visible_in_report": {
          "const": true
        }
      }
    },
    "relationshipSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_worthy",
        "channel_guidance",
        "contact_channel_risk",
        "evidence_refs",
        "external_effects",
        "organization",
        "preferred_human_channels",
        "provenance",
        "recommended_action",
        "relationship_path",
        "signal_id",
        "signal_type",
        "source_opportunity_id",
        "source_receipt_ids",
        "subject",
        "visible_in_report"
      ],
      "properties": {
        "signal_id": {
          "type": "string",
          "minLength": 1
        },
        "source_opportunity_id": {
          "type": "string",
          "minLength": 1
        },
        "signal_type": {
          "enum": [
            "direct_contact",
            "adjacent_contact",
            "organization_sponsor"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "relationship_path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_receipt_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "memory_recall_found": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "memory_recall_degraded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recommended_action": {
          "enum": [
            "human_decide_attend_watch_or_skip",
            "human_decide_reconnect_or_defer"
          ]
        },
        "external_effects": {
          "const": false
        },
        "action_worthy": {
          "const": true
        },
        "visible_in_report": {
          "const": true
        },
        "contact_channel_risk": {
          "enum": [
            "corporate_email_may_be_blocked_after_long_gap"
          ]
        },
        "preferred_human_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "LINKEDIN_HUMAN_HANDOFF",
              "AUTHORIZED_PERSONA_GMAIL",
              "VERIFIED_CURRENT_EMAIL"
            ]
          }
        },
        "channel_guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
