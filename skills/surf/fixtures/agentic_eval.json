{
  "version": 2,
  "skill": "surf",
  "trials": 3,
  "proof_scope": "surf entrypoint, native-socket troubleshooting posture, deterministic CDP geometry/pointer receipt seams, deterministic OS pointer coordinate mapping receipts, live loopback bot-detector browser proof, and defensive captcha composition including red-team mode",
  "claims": {
    "proves": "the Surf entrypoint exposes the current browser-control contract, native CLI socket diagnostics meet explicit local expectations, the CDP geometry/pointer primitives are covered by the production test runner, OS pointer dispatch maps viewport CSS samples to screen pixels with a receipt, live Chrome can drive/read back a pinned loopback bot-detection page through CDP primitives, and Surf eval coverage reaches the captcha entrypoint for defensive reference and red-team local authorization",
    "does_not_prove": "provider semantic correctness, authenticated WebGPT completion, CAPTCHA solving, public bot-detection bypass, or full browser review readiness"
  },
  "capability_claims": [
    {
      "id": "surf.cdp_geometry_receipts",
      "description": "Surf exposes deterministic receipt-producing CDP geometry commands for DOM-unavailable workflows.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true,
        "live_e2e": true
      }
    },
    {
      "id": "surf.pointer_dispatch_receipt",
      "description": "Surf validates receipt-bound pointer plans and exposes CDP and OS-level pointer.dispatch receipt contracts.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true,
        "live_e2e": true
      }
    },
    {
      "id": "surf.pointer_dispatch_os_transport",
      "description": "Surf can map viewport CSS pointer samples to screen pixels and deliver an OS-level pointer dispatch receipt to real Chrome when the default CDP 9222 path is unavailable.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true,
        "live_e2e": true
      }
    },
    {
      "id": "surf.captcha_defensive_composition",
