{
  "version": 2,
  "skill": "surf",
  "trials": 3,
  "proof_scope": "surf entrypoint and native-socket troubleshooting posture",
  "claims": {
    "proves": "the Surf sanity entrypoint and native CLI socket diagnostics meet explicit local expectations",
    "does_not_prove": "provider semantic correctness, authenticated WebGPT completion, or full browser review readiness"
  },
  "cases": [
    {
      "name": "capabilities-entrypoint",
      "type": "positive",
      "real_world": true,
      "timeout_seconds": 120,
      "command": [
        "bash",
        "-c",
        "cd .. && ./run.sh capabilities --json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "surf"
        ]
      }
    },
    {
      "name": "stale-native-socket-emits-actionable-failure-code",
      "type": "adversarial",
      "real_world": true,
      "timeout_seconds": 120,
      "command": [
        "bash",
        "-c",
        "cd ../vendor/surf-cli && npm test -- --run test/integration/cli-native-socket.test.ts && cd ../.. && ./run.sh capabilities --json >/dev/null"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "cli-native-socket.test.ts"
        ]
      }
    }
  ]
}
