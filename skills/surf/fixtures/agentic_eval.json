{
  "version": 2,
  "skill": "surf",
  "trials": 3,
  "proof_scope": "surf entrypoint, native-socket troubleshooting posture, and deterministic CDP geometry/pointer receipt seams",
  "claims": {
    "proves": "the Surf entrypoint exposes the current browser-control contract, native CLI socket diagnostics meet explicit local expectations, and the CDP geometry/pointer primitives are covered by the production test runner",
    "does_not_prove": "provider semantic correctness, authenticated WebGPT completion, live Chrome pointer delivery, or full browser review readiness"
  },
  "capability_claims": [
    {
      "id": "surf.cdp_geometry_receipts",
      "description": "Surf exposes deterministic receipt-producing CDP geometry commands for DOM-unavailable workflows.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    },
    {
      "id": "surf.pointer_dispatch_receipt",
      "description": "Surf validates receipt-bound pointer plans and exposes a pointer.dispatch receipt contract.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true
      }
    }
  ],
  "seams": [
    {
      "seam_id": "surf.wrapper.cdp_command_surface",
      "seam_type": "cli_contract",
      "criticality": "critical",
      "required_evidence": ["deterministic"]
    },
    {
      "seam_id": "surf.cdp_client.primitives",
      "seam_type": "browser_transport",
      "criticality": "critical",
      "required_evidence": ["deterministic"]
    }
  ],
  "cases": [
    {
      "name": "capabilities-entrypoint",
      "type": "positive",
      "real_world": true,
      "evidence_class": "deterministic",
      "timeout_seconds": 120,
      "command": [
        "bash",
        "-c",
        "cd .. && ./run.sh capabilities --json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "surf"
        ]
      }
    },
    {
      "name": "cdp-pointer-wrapper-contract-is-advertised",
      "type": "positive",
      "real_world": true,
      "evidence_class": "deterministic",
      "supports_claims": [
        "surf.cdp_geometry_receipts",
        "surf.pointer_dispatch_receipt"
      ],
      "seams": [
        "surf.wrapper.cdp_command_surface"
      ],
      "timeout_seconds": 120,
      "command": [
        "bash",
        "-c",
        "cd .. && ./run.sh --help"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "surf cdp.layout",
          "surf cdp.quads",
          "surf cdp.hit-test",
          "surf cdp.raw",
          "surf pointer.dispatch"
        ]
      }
    },
    {
      "name": "cdp-pointer-primitives-production-test-runner",
      "type": "positive",
      "real_world": true,
      "evidence_class": "deterministic",
      "supports_claims": [
        "surf.cdp_geometry_receipts",
        "surf.pointer_dispatch_receipt"
      ],
      "seams": [
        "surf.cdp_client.primitives"
      ],
      "timeout_seconds": 180,
      "command": [
        "bash",
        "-c",
        "cd .. && UV_PROJECT_ENVIRONMENT=/tmp/surf-agentic-eval-venv uv run --with pytest --project . python -m pytest -q tests/test_cdp_primitives.py"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "5 passed"
        ]
      }
    },
    {
      "name": "stale-native-socket-emits-actionable-failure-code",
      "type": "adversarial",
      "real_world": true,
      "evidence_class": "deterministic",
      "timeout_seconds": 120,
      "command": [
        "bash",
        "-c",
        "cd ../vendor/surf-cli && npm test -- --run test/integration/cli-native-socket.test.ts && cd ../.. && ./run.sh capabilities --json >/dev/null"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "cli-native-socket.test.ts"
        ]
      }
    }
  ]
}
