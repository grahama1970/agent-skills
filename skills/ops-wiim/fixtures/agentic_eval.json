{
  "version": 2,
  "skill": "ops-wiim",
  "trials": 2,
  "proof_scope": "live LinkPlay HTTP API diagnostics against the real WiiM Amp on the LAN plus fail-closed and mutation-gating boundaries",
  "claims": {
    "proves": "diagnose reaches the live amp and emits ops_wiim.diagnosis.v1 with findings; unreachable amps fail closed with exit 2; mutations are refused without --execute",
    "does_not_prove": "amplifier power-stage health, TV-side digital attenuation, or the meaning of firmware-specific mode codes"
  },
  "cases": [
    {
      "name": "live-diagnose-real-amp",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh diagnose --json --ip \"${WIIM_IP:-192.168.86.50}\""
      ],
      "blocked_when_stdout_contains": [
        "\"status\": \"down\""
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "ops_wiim.diagnosis.v1",
          "\"status\": \"up\"",
          "findings",
          "not_observable"
        ]
      }
    },
    {
      "name": "unreachable-amp-fails-closed",
      "type": "negative",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh diagnose --json --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 2,
        "stdout_contains": [
          "ops_wiim.diagnosis.v1",
          "\"status\": \"down\""
        ]
      }
    },
    {
      "name": "mutation-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh set-volume 100 --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "play-url-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh play-url http://example.com/t.mp3 --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "mdns-resolve-finds-amp",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh resolve --json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "ops_wiim.resolve.v1",
          "192.168.86.50",
          "WiiM Amp-24AA"
        ]
      }
    }
  ]
}