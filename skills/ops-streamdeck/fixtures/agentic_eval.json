{
  "version": 2,
  "skill": "ops-streamdeck",
  "trials": 3,
  "proof_scope": "Stream Deck operations command posture and non-mutating workstation display-safety guardrails",
  "claims": {
    "proves": "the skill entrypoint can query live local Stream Deck status, fails closed for malformed button execution requests, audits configured button states, and detects unsafe meeting/display button routes before they mutate workstation display state",
    "does_not_prove": "physical button rendering, USB hardware availability, light behavior, daemon API correctness, command semantics for every executable button, actual meeting button execution, or safe persistent config mutation"
  },
  "cases": [
    {
      "name": "status-json-queries-local-streamdeck-state",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "status",
        "--json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"services\"",
          "\"buttons\""
        ]
      }
    },
    {
      "name": "button-command-requires-id",
      "type": "negative",
      "command": [
        "bash",
        "../run.sh",
        "button"
      ],
      "expected": {
        "exit_code": 1,
        "stderr_contains": [
          "Button ID required"
        ]
      }
    },
    {
      "name": "button-info-exposes-nested-button-state",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "button",
        "button-info",
        "13"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"states\"",
          "\"command\""
        ]
      }
    },
    {
      "name": "all-button-states-are-readable",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "audit-states"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"nonempty_states\"",
          "\"states\"",
          "\"ok\": true"
        ]
      }
    },
    {
      "name": "meeting-display-buttons-do-not-route-to-display-mutation",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "audit-display-safety"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"ok\": true",
          "\"forbidden_hits\": []",
          "\"meeting_button_command\": \"/home/graham/workspace/streamdeck/scripts/meeting-mode.sh\"",
          "\"display_mutation_guard\": true",
          "\"display_mutation_env\": true"
        ]
      }
    }
  ]
}
