{
  "version": 2,
  "skill": "ops-streamdeck",
  "trials": 3,
  "proof_scope": "Stream Deck operations command posture",
  "claims": {
    "proves": "the skill entrypoint can query live local Stream Deck status and fails closed for malformed button execution requests",
    "does_not_prove": "physical button rendering, USB hardware availability, light behavior, daemon API correctness, or safe persistent config mutation"
  },
  "cases": [
    {
      "name": "status-json-queries-local-streamdeck-state",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "status",
        "--json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"services\"",
          "\"buttons\""
        ]
      }
    },
    {
      "name": "button-command-requires-id",
      "type": "negative",
      "command": [
        "bash",
        "../run.sh",
        "button"
      ],
      "expected": {
        "exit_code": 1,
        "stderr_contains": [
          "Button ID required"
        ]
      }
    },
    {
      "name": "button-info-exposes-nested-button-state",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "button",
        "button-info",
        "13"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"states\"",
          "\"command\""
        ]
      }
    },
    {
      "name": "all-button-states-are-readable",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "audit-states"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"nonempty_states\"",
          "\"states\"",
          "\"ok\": true"
        ]
      }
    }
  ]
}
