{
  "version": 2,
  "skill": "ops-streamdeck",
  "trials": 3,
  "proof_scope": "Stream Deck operations command posture, non-mutating workstation display-safety guardrails, semantic dynamic page staging and live deployment, and home date/day widget placement",
  "claims": {
    "proves": "the skill entrypoint can query live local Stream Deck status, fails closed for malformed button execution requests, audits configured button states, detects unsafe meeting/display button routes before they mutate workstation display state, compiles a semantic voice/SPARTA dynamic page request into staged artifacts without hardware effects, deploys a semantic request to the live dynamic page slot with full-page replacement readback, and verifies the home date/day widget is directly under the weather widget through the production renderer without hardware effects",
    "does_not_prove": "physical button rendering, USB hardware availability, light behavior, daemon API correctness, command semantics for every executable button, actual meeting button execution, action-dispatch semantics, or voice/STT/SPARTA transport integration"
  },
  "cases": [
    {
      "name": "status-json-queries-local-streamdeck-state",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "status",
        "--json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"services\"",
          "\"buttons\""
        ]
      }
    },
    {
      "name": "button-command-requires-id",
      "type": "negative",
      "command": [
        "bash",
        "../run.sh",
        "button"
      ],
      "expected": {
        "exit_code": 1,
        "stderr_contains": [
          "Button ID required"
        ]
      }
    },
    {
      "name": "button-info-exposes-nested-button-state",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "button",
        "button-info",
        "13"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"states\"",
          "\"command\""
        ]
      }
    },
    {
      "name": "all-button-states-are-readable",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "audit-states"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"nonempty_states\"",
          "\"states\"",
          "\"ok\": true"
        ]
      }
    },
    {
      "name": "meeting-display-buttons-do-not-route-to-display-mutation",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "audit-display-safety"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"ok\": true",
          "\"forbidden_hits\": []",
          "\"meeting_button_command\": \"/home/graham/workspace/streamdeck/scripts/meeting-mode.sh\"",
          "\"display_mutation_guard\": true",
          "\"display_mutation_env\": true"
        ]
      }
    },
    {
      "name": "semantic-dynamic-page-request-stages-without-hardware-effects",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "dynamic-stage-check"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"ok\": true",
          "\"external_effects\": false",
          "\"recipe_id\": \"sparta_review_controls\"",
          "\"binding_count\": 2",
          "\"manifest_schema\": true",
          "\"dispatcher_bindings\": true"
        ]
      }
    },
    {
      "name": "semantic-dynamic-page-request-deploys-with-live-readback",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "dynamic-deploy-check"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"ok\": true",
          "\"external_effects\": true",
          "\"recipe_id\": \"sparta_review_controls\"",
          "\"binding_count\": 2",
          "\"config_button_0_dispatcher\": true",
          "\"config_button_1_dispatcher\": true",
          "\"config_unused_buttons_empty\": true",
          "\"config_back_button_clean\": true"
        ]
      }
    },
    {
      "name": "home-date-widget-under-weather-readonly-audit",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "audit-date-widget"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"ok\": true",
          "\"weather_position\": 15",
          "\"date_position\": 23",
          "\"renderer\": \"streamdeck.widgets.date_render\"",
          "\"external_effects\": false",
          "\"forbidden_hits\": []"
        ]
      }
    }
  ]
}
