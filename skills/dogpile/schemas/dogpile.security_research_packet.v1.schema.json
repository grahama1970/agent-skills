{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dogpile.security_research_packet.v1.schema.json",
  "title": "Dogpile Security Research Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_version",
    "run_id",
    "mocked",
    "live",
    "requested_query",
    "effective_query",
    "request_context",
    "target_context",
    "started_at",
    "ended_at",
    "provider_statuses",
    "retrieval_evidence",
    "model_synthesis",
    "github_candidates",
    "conflicts",
    "weak_coverage",
    "negative_evidence",
    "rejected_candidates",
    "unresolved_questions",
    "source_bearing_provider_count",
    "source_bearing_evidence_count",
    "adapter_outputs",
    "non_claims",
    "packet_sha256"
  ],
  "properties": {
    "schema": {"const": "dogpile.security_research_packet.v1"},
    "packet_version": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "mocked": {"type": "boolean"},
    "live": {"type": "string", "minLength": 1},
    "requested_query": {"type": "string"},
    "effective_query": {"type": "string"},
    "request_context": {"type": "object"},
    "target_context": {"type": "object"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "provider_statuses": {"type": "array", "items": {"type": "object"}},
    "retrieval_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "provider",
          "source_type",
          "source_bearing",
          "title",
          "retrieved_at",
          "excerpt",
          "content_verdict",
          "retrieval_artifact",
          "content_sha256",
          "classification_reason"
        ],
        "properties": {
          "evidence_id": {"type": "string"},
          "provider": {"type": "string"},
          "source_type": {"type": "string"},
          "source_bearing": {"const": true},
          "url": {"type": ["string", "null"]},
          "repository": {"type": ["string", "null"]},
          "repository_ref": {"type": ["string", "null"]},
          "paper_id": {"type": ["string", "null"]},
          "video_id": {"type": ["string", "null"]},
          "title": {"type": "string"},
          "retrieved_at": {"type": "string"},
          "excerpt": {"type": "string"},
          "content_verdict": {"type": "string"},
          "retrieval_artifact": {"type": "string"},
          "content_sha256": {"type": "string"},
          "classification_reason": {"type": "string"}
        }
      }
    },
    "model_synthesis": {"type": "object"},
    "github_candidates": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array"},
    "weak_coverage": {"type": "array"},
    "negative_evidence": {"type": "array"},
    "rejected_candidates": {"type": "array"},
    "unresolved_questions": {"type": "array"},
    "source_bearing_provider_count": {"type": "integer", "minimum": 0},
    "source_bearing_evidence_count": {"type": "integer", "minimum": 0},
    "adapter_outputs": {"type": "object"},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "packet_sha256": {"type": "string"}
  }
}
