    {
      "regression_id": "runner-fail-open-1430",
      "claim_ids": ["agentic-evals.gate.fail_closed"],
      "seam_ids": ["runner.gate"],
      "incident": {"issue": "grahama1970/agent-skills#1430", "date": "2026-08-11"},
      "failure_code": "gate_exits_zero_on_non_ready",
      "evidence_class": "fault_injected_deterministic",
      "retained_fixture": "runner_selftest.json",
      "retained_case": "a-failed-required-case-makes-run-exit-non-zero",
      "fail_before_fix": {
        "proof_command": [
          "bash", "-c",
          "D=$(mktemp -d); printf '{\"version\":2,\"skill\":\"s\",\"trials\":1,\"eval_kind\":\"runner_selftest\",\"cases\":[{\"name\":\"f\",\"type\":\"positive\",\"command\":[\"bash\",\"-c\",\"exit 3\"],\"expected\":{\"exit_code\":0}}]}' > \"$D/f.json\"; ./run.sh run \"$D/f.json\" >/dev/null 2>&1"
        ],
        "expected_fail": true,
        "proven": true,
        "proven_date": "2026-08-18",
        "rationale": "A required case fails; the guard must make the runner exit non-zero. If the fail-closed guard were removed the runner would exit 0 and this proof would pass, exposing the vacuity."
      },
      "repair_revision": "issue #1430",
      "first_added": "2026-08-18",
      "last_proven": "2026-08-18",
      "status": "ACTIVE"
    },
