{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persona Profile",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {"type": "string"},
    "goals": {"type": "array", "items": {"type": "string"}},
    "stylistic_traits": {"type": "array", "items": {"type": "string"}},
    "rhetorical_preferences": {"type": "array", "items": {"type": "string"}},
    "preferred_markers": {"type": "array", "items": {"type": "string"}},
    "discouraged_markers": {"type": "array", "items": {"type": "string"}},
    "hedging_target": {"type": "string", "enum": ["low", "medium", "high"]},
    "assertiveness_target": {"type": "string", "enum": ["low", "medium", "high"]},
    "section_affinity": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "anti_patterns": {"type": "array", "items": {"type": "string"}}
  }
}
