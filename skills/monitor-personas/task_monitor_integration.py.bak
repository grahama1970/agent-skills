#!/usr/bin/env python3
"""Task Monitor Integration for Monitor-Personas.

Reports progress to ~/.pi/task-monitor/ for centralized monitoring.
"""
import json
import os
import time
from pathlib import Path
from typing import Any, Dict, List, Optional
from loguru import logger

TASK_MONITOR_REGISTRY = Path.home() / ".pi" / "task-monitor" / "registry.json"
STATE_DIR = Path.home() / ".pi" / "monitor-personas"


class PersonaMonitorTracker:
    """Task-monitor compatible tracker for persona monitoring jobs."""

    def __init__(
        self,
        job_type: str = "check",  # check, ingest, learn
        name: str = "persona-monitor",
        register: bool = True,
    ):
        self.job_type = job_type
        self.name = f"{name}-{job_type}"
        self.state_file = STATE_DIR / f"task_state_{job_type}.json"

        STATE_DIR.mkdir(parents=True, exist_ok=True)

        # Progress tracking
        self.personas: List[str] = []
        self.current_persona: str = ""
        self.completed_personas: List[str] = []
        self.persona_status: Dict[str, str] = {}
        self.persona_stats: Dict[str, Dict[str, Any]] = {}

        # Timing
        self.start_time = time.time()
        self.last_update = 0.0

        # Error tracking
        self.errors: List[Dict[str, Any]] = []

        if register:
            self._register_task()

        self._update_state()

    def _register_task(self):
        """Register with task-monitor."""
        try:
            TASK_MONITOR_REGISTRY.parent.mkdir(parents=True, exist_ok=True)

            registry = {}
            if TASK_MONITOR_REGISTRY.exists():
                try:
                    registry = json.loads(TASK_MONITOR_REGISTRY.read_text())
                except Exception:
                    registry = {}

            registry[self.name] = {
                "state_file": str(self.state_file),
                "total": len(self.personas),
                "description": f"Persona Monitor: {self.job_type}",
                "project": "monitor-personas",
                "registered_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            }

            tmp = TASK_MONITOR_REGISTRY.with_suffix(".tmp")
            tmp.write_text(json.dumps(registry, indent=2))
            os.replace(tmp, TASK_MONITOR_REGISTRY)
        except Exception as e:
            logger.debug("value lookup failed: {}", e)

    def _update_state(self, final: bool = False):
        """Update task-monitor state file."""
        now = time.time()

        if not final and (now - self.last_update) < 0.5:
            return
        self.last_update = now

        elapsed = now - self.start_time
        total = len(self.personas) if self.personas else 1
        completed = len(self.completed_personas)
        progress_pct = (completed / total * 100) if total > 0 else 0

        state = {
            "completed": completed,
            "total": total,
            "description": f"Persona Monitor: {self.job_type}",
            "current_item": self.current_persona,
            "stats": {
                "success": sum(1 for s in self.persona_status.values() if s == "success"),
                "failed": sum(1 for s in self.persona_status.values() if s == "failed"),
                "skipped": sum(1 for s in self.persona_status.values() if s == "skipped"),
            },
            "persona_status": self.persona_status,
            "persona_stats": self.persona_stats,
            "errors": self.errors[-10:],
            "elapsed_seconds": round(elapsed, 1),
            "progress_pct": round(progress_pct, 1),
            "last_updated": time.strftime("%Y-%m-%d %H:%M:%S"),
            "status": "completed" if final else "running",
        }

        try:
            tmp = self.state_file.with_suffix(".tmp")
            tmp.write_text(json.dumps(state, indent=2))
            os.replace(tmp, self.state_file)
        except Exception as e:
            logger.debug("tmp failed: {}", e)

    def set_personas(self, personas: List[str]):
        """Set the list of personas to process."""
        self.personas = personas
        self.persona_status = {p: "pending" for p in personas}
        self._update_state()

    def start_persona(self, persona_id: str):
        """Mark a persona as starting."""
        self.current_persona = persona_id
        self.persona_status[persona_id] = "running"
        self._update_state()

    def complete_persona(
        self,
        persona_id: str,
        success: bool = True,
        stats: Optional[Dict[str, Any]] = None,
        error_msg: Optional[str] = None,
    ):
        """Mark a persona as complete."""
        self.persona_status[persona_id] = "success" if success else "failed"
        self.completed_personas.append(persona_id)

        if stats:
            self.persona_stats[persona_id] = stats

        if not success and error_msg:
            self.errors.append({
                "persona": persona_id,
                "message": error_msg,
                "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
            })

        self._update_state()

    def skip_persona(self, persona_id: str, reason: str = "no new content"):
        """Mark a persona as skipped."""
        self.persona_status[persona_id] = "skipped"
        self.completed_personas.append(persona_id)
        self.persona_stats[persona_id] = {"skipped_reason": reason}
        self._update_state()

    def log_error(self, persona_id: str, error_msg: str):
        """Log an error."""
        self.errors.append({
            "persona": persona_id,
            "message": error_msg,
            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        })
        self._update_state()

    def finish(self, success: bool = True):
        """Mark the job as complete."""
        self._update_state(final=True)

    def get_summary(self) -> Dict[str, Any]:
        """Get a summary for reporting."""
        elapsed = time.time() - self.start_time
        return {
            "job_type": self.job_type,
            "elapsed_seconds": round(elapsed, 1),
            "personas": {
                "total": len(self.personas),
                "success": sum(1 for s in self.persona_status.values() if s == "success"),
                "failed": sum(1 for s in self.persona_status.values() if s == "failed"),
                "skipped": sum(1 for s in self.persona_status.values() if s == "skipped"),
            },
            "errors": len(self.errors),
        }


# Global tracker instances
_trackers: Dict[str, PersonaMonitorTracker] = {}


def start_job(job_type: str) -> PersonaMonitorTracker:
    """Start a new monitoring job."""
    tracker = PersonaMonitorTracker(job_type=job_type)
    _trackers[job_type] = tracker
    return tracker


def get_tracker(job_type: str) -> Optional[PersonaMonitorTracker]:
    """Get the tracker for a job type."""
    return _trackers.get(job_type)


def end_job(job_type: str, success: bool = True):
    """End a monitoring job."""
    if job_type in _trackers:
        _trackers[job_type].finish(success)
        del _trackers[job_type]
