  "ink": "#2B2B2B", "muted": "#595959",
  "program_blue": "#275791", "highlight_warm": "#C36518", "alert": "#A14240"
 },
 "type_scale_pt": { "hero": 112, "section": 36, "title": 28, "lead": 24, "body": 20, "support": 16, "caption": 10 },
