{
 "schema": "pitchdeck.theme_template.v1",
 "id": "sparta-house-conference",
 "description": "House style for conference talks (SpartaAI CyberSummit lineage): light canvas, petrol header band, humor + big icon diagrams.",
 "mode": "light",
 "theme_tokens": { "accent": "#065E7C", "heading_font": "Calibri", "body_font": "Calibri" },
 "palette": {
  "primary": "#065E7C", "secondary": "#228099", "canvas": "#FFFFFF",
  "ink": "#292929", "muted": "#595959",
  "highlight_warm": "#D39500", "highlight_green": "#6F8E30", "alert": "#A14240"
 },
 "type_scale_pt": { "hero": 64, "section": 36, "title": 28, "lead": 24, "body": 20, "support": 16, "caption": 12 },
 "code_font": "Consolas",
 "chrome": {
  "header_band": { "fill": "#065E7C", "title_color": "#FFFFFF", "metaphor_badge": "top-right circular line-icon, emotional register of the slide" },
  "footer": { "left": "sponsor logo strip", "right": "distribution statement + page number", "rule": "#065E7C thin" }
 },
 "bullet_grammar": ["teal chevron >", "small square", "em-dash"],
 "density": { "max_takeaways_before_visual": 4, "words_target_median": 16, "words_hard_p90": 122 }
}
