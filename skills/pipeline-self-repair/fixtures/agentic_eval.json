{
  "version": 2,
  "skill": "pipeline-self-repair",
  "trials": 2,
  "live": true,
  "proof_scope": "End-to-end pipeline-self-repair behavior through the public run.sh entrypoint: live triage-error composition, live memory recall, read-only live GitHub issue search, safe ticket preview/binding, provider-effect no-blind-retry gates, checkpoint ledger validation, and agentic-evals remediation projection. External mutations are intentionally not executed.",
  "claims": {
    "proves": "pipeline-self-repair can convert a required pipeline-step failure into a replayable repair branch with triage, memory/GitHub search, stable category, ticket disposition, provider-effect safety, eval-required checkpoint gates, and agentic-evals remediation projection.",
    "does_not_prove": "live GitHub issue creation, live project-watchdog dispatch, paid Kling submission, successful Kling media generation, or mutation of external systems. Those require explicit --apply-ticket, --dispatch-watchdog, and provider authorization outside this fixture."
  },
  "capability_claims": [
    {
      "id": "psr.goal.preflight",
      "description": "record-failure refuses to run without a human-registered immutable goal and records goal_hash/alignment when a goal exists.",
      "criticality": "critical",
      "evidence_required": {
        "live_e2e": true,
        "adversarial_live_e2e": true
      }
    },
    {
      "id": "psr.e2e.full_branch",
      "description": "record-failure drives the complete safe repair branch: triage-error, memory recall, read-only GitHub search, category binding, and ticket disposition.",
      "criticality": "critical",
      "evidence_required": {
        "live_e2e": true
      }
    },
    {
      "id": "psr.provider_effect.no_blind_retry",
      "description": "provider/Kling effect capsules prevent blind retries when spend/effect state is unknown or a provider task already exists.",
      "criticality": "critical",
      "evidence_required": {
        "adversarial_live_e2e": true
      }
    },
    {
      "id": "psr.resume_gate.eval_required",
      "description": "validate-ledger blocks checkpoint resume without retained agentic-evals proof and accepts a ledger only when ticket disposition plus eval proof are present.",
      "criticality": "critical",
      "evidence_required": {
        "live_e2e": true,
        "adversarial_live_e2e": true
      }
    },
    {
      "id": "psr.agentic_eval.remediation_projection",
      "description": "agentic-eval-remediate projects a complete failing agentic-evals report through the real remediation preview path and records it in the replay ledger.",
      "criticality": "important",
      "evidence_required": {
        "live_e2e": true
      }
    },
    {
      "id": "psr.fail_closed.raw_signal",
      "description": "record-failure fails closed instead of inventing a failure when no raw signal or receipt is supplied.",
      "criticality": "critical",
      "evidence_required": {
        "fault_injected_deterministic": true
      }
    }
  ],
  "seams": [
    {
      "seam_id": "goal_drift.immutable_goal",
      "claim_id": "psr.goal.preflight",
      "seam_type": "goal-alignment",
      "criticality": "critical",
      "failure_modes": [
        "self-repair runs without an immutable goal",
        "repair event omits goal_hash",
        "repair work drifts from the human-registered goal"
      ],
      "required_evidence": [
        "live_e2e",
        "adversarial_live_e2e"
      ]
    },
    {
      "seam_id": "self_repair.full_branch",
      "claim_id": "psr.e2e.full_branch",
      "seam_type": "skill-composition",
      "criticality": "critical",
      "failure_modes": [
        "failed step bypasses triage-error",
        "memory recall is skipped silently",
        "GitHub search truncates JSON and misses prior tickets",
        "ticket category is not bound"
      ],
      "required_evidence": [
        "live_e2e"
      ]
    },
    {
      "seam_id": "provider.effect_capsule",
      "claim_id": "psr.provider_effect.no_blind_retry",
      "seam_type": "external-effect-safety",
      "criticality": "critical",
      "failure_modes": [
        "unknown paid-provider effect allows resubmission",
        "existing provider task id allows duplicate submit",
        "request/response/artifact hashes are missing"
      ],
      "required_evidence": [
        "adversarial_live_e2e"
      ]
    },
    {
      "seam_id": "checkpoint.resume_gate",
      "claim_id": "psr.resume_gate.eval_required",
      "seam_type": "state-fold",
      "criticality": "critical",
      "failure_modes": [
        "blocking failure is hidden from resume gate",
        "resume gate passes without retained eval proof",
        "valid ticket+eval repair disposition is rejected"
      ],
      "required_evidence": [
        "live_e2e",
        "adversarial_live_e2e"
      ]
    },
    {
      "seam_id": "agentic_eval.remediation_projection",
      "claim_id": "psr.agentic_eval.remediation_projection",
      "seam_type": "skill-composition",
      "criticality": "important",
      "failure_modes": [
        "complete failing eval report is not categorized",
        "remediation preview is not recorded in the repair ledger"
      ],
      "required_evidence": [
        "live_e2e"
      ]
    },
    {
      "seam_id": "input.validation",
      "claim_id": "psr.fail_closed.raw_signal",
      "seam_type": "cli-contract",
      "criticality": "critical",
      "failure_modes": [
        "missing failure evidence produces a fake category"
      ],
      "required_evidence": [
        "fault_injected_deterministic"
      ]
    }
  ],
