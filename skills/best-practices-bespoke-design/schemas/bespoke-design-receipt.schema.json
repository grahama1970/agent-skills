{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grahama:agent-skills:best-practices-bespoke-design:receipt:v1",
  "title": "Bespoke Design Proof Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "source_provenance",
    "concept_territories",
    "selected_territory_id",
    "visual_grammar",
    "artifacts",
    "blind_tests",
    "gates",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "const": "bespoke-design-receipt.v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "surface",
        "source_revision",
        "implementation_revision",
        "generated_at"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "implementation_revision": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "fixture": {"type": "boolean", "default": false}
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bundle_sha256", "authoritative_source_count"],
      "properties": {
        "source_bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authoritative_source_count": {
          "type": "integer",
          "minimum": 1
        },
        "supporting_source_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "concept_territories": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "semantic_premise",
          "emotional_posture",
          "typography_strategy",
          "composition_model",
          "image_logic",
          "primary_motif",
          "evidence_claim_ids"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "semantic_premise": {"type": "string", "minLength": 20},
          "emotional_posture": {"type": "string", "minLength": 3},
          "typography_strategy": {"type": "string", "minLength": 10},
          "composition_model": {"type": "string", "minLength": 10},
          "image_logic": {"type": "string", "minLength": 10},
          "primary_motif": {"type": "string", "minLength": 3},
          "evidence_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "selected_territory_id": {
      "type": "string",
      "minLength": 1
    },
    "visual_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative_premise",
        "non_color_invariants",
        "motif_mappings",
        "responsive_transformations",
        "controlled_abundance"
      ],
      "properties": {
        "narrative_premise": {"type": "string", "minLength": 20},
        "non_color_invariants": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "motif_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motif", "meaning_or_job", "source_claim_ids"],
            "properties": {
              "motif": {"type": "string", "minLength": 2},
              "meaning_or_job": {"type": "string", "minLength": 8},
              "source_claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "responsive_transformations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 8}
        },
        "controlled_abundance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expressive_zones", "calm_reading_zones", "calm_task_zones"],
          "properties": {
            "expressive_zones": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "calm_reading_zones": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "calm_task_zones": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "source_bundle",
              "evidence_ledger",
              "visual_world_brief",
              "territory_board",
              "selection_record",
              "screenshot",
              "browser_receipt",
              "accessibility_receipt",
              "performance_receipt",
              "rater_input",
              "rater_output",
              "implementation_bundle",
              "other"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "viewport": {"type": "string"},
          "state": {"type": "string"}
        }
      }
    },
    "blind_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logo_off", "competitor_swap", "cross_screen_family", "reference_leakage"],
      "properties": {
        "logo_off": {
          "$ref": "#/$defs/logoOffTest"
        },
        "competitor_swap": {
          "$ref": "#/$defs/competitorSwapTest"
        },
        "cross_screen_family": {
          "$ref": "#/$defs/familyTest"
        },
        "reference_leakage": {
          "$ref": "#/$defs/leakageTest"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9",
        "G10",
        "G11",
        "G12",
        "G13",
        "G14"
      ],
      "properties": {
        "G0": {"$ref": "#/$defs/gate"},
        "G1": {"$ref": "#/$defs/gate"},
        "G2": {"$ref": "#/$defs/gate"},
        "G3": {"$ref": "#/$defs/gate"},
        "G4": {"$ref": "#/$defs/gate"},
        "G5": {"$ref": "#/$defs/gate"},
        "G6": {"$ref": "#/$defs/gate"},
        "G7": {"$ref": "#/$defs/gate"},
        "G8": {"$ref": "#/$defs/gate"},
        "G9": {"$ref": "#/$defs/gate"},
        "G10": {"$ref": "#/$defs/gate"},
        "G11": {"$ref": "#/$defs/gate"},
        "G12": {"$ref": "#/$defs/gate"},
        "G13": {"$ref": "#/$defs/gate"},
        "G14": {"$ref": "#/$defs/gate"}
      }
    },
    "exceptions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "authorized_by", "rationale"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^G(?:[0-9]|1[0-4])$"},
          "authorized_by": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 10}
        }
      }
    },
    "final_status": {
      "enum": ["READY", "NOT_READY", "BLOCKED"]
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "FAIL", "NOT_TESTED", "BLOCKED"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidence_artifact_ids"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "summary": {"type": "string", "minLength": 4},
        "evidence_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "logoOffTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "correct_assignments", "total_assignments", "raw_output_artifact_ids"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "correct_assignments": {"type": "integer", "minimum": 0},
        "total_assignments": {"type": "integer", "minimum": 0},
        "raw_output_artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "competitorSwapTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "conflict_channels", "raw_output_artifact_ids"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "conflict_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["metaphor", "imagery", "voice", "hierarchy", "components", "motion", "spatial_grammar", "other"]
          }
        },
        "raw_output_artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "familyTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "correct_groupings", "total_groupings", "observed_non_color_invariants", "raw_output_artifact_ids"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "correct_groupings": {"type": "integer", "minimum": 0},
        "total_groupings": {"type": "integer", "minimum": 0},
        "observed_non_color_invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "raw_output_artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "leakageTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference_corpus_artifact_ids", "distinctive_combination_copied", "raw_output_artifact_ids"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reference_corpus_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "distinctive_combination_copied": {"type": "boolean"},
        "raw_output_artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
