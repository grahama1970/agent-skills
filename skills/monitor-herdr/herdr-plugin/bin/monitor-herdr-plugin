#!/usr/bin/env bash
set -euo pipefail

plugin_root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
skill_dir="${MONITOR_HERDR_SKILL_DIR:-$(cd "$plugin_root/.." && pwd)}"
run_sh="$skill_dir/run.sh"

if [[ ! -x "$run_sh" ]]; then
  echo "monitor-herdr run.sh not executable at $run_sh" >&2
  exit 2
fi

space="${MONITOR_HERDR_SPACE:-${HERDR_WORKSPACE_ID:-codex}}"
cwd_prefix="${MONITOR_HERDR_CWD_PREFIX:-$HOME/workspace/experiments}"
min_stopped_seconds="${MONITOR_HERDR_MIN_STOPPED_SECONDS:-600}"
max_prompts="${MONITOR_HERDR_MAX_PROMPTS:-1}"

case "${1:-status}" in
  status)
    exec "$run_sh" status
    ;;
  tick-dry-run)
    MONITOR_HERDR_INVOCATION_SOURCE=herdr_plugin exec "$run_sh" tick \
      --space "$space" \
      --cwd-prefix "$cwd_prefix" \
      --min-stopped-seconds "$min_stopped_seconds" \
      --max-prompts "$max_prompts" \
      --json
    ;;
  tick-apply)
    MONITOR_HERDR_INVOCATION_SOURCE=herdr_plugin exec "$run_sh" tick \
      --apply \
      --space "$space" \
      --cwd-prefix "$cwd_prefix" \
      --min-stopped-seconds "$min_stopped_seconds" \
      --max-prompts "$max_prompts" \
      --json
    ;;
  probe-current-pane)
    pane_id="${HERDR_PANE_ID:-}"
    if [[ -z "$pane_id" ]]; then
      echo "HERDR_PANE_ID is required for probe-current-pane" >&2
      exit 2
    fi
    exec "$run_sh" probe-text \
      --pane-id "$pane_id" \
      --agent "${MONITOR_HERDR_AGENT:-agent}" \
      --reason "${MONITOR_HERDR_REASON:-early_stop}" \
      --cwd "${HERDR_WORKSPACE_CWD:-$PWD}" \
      --json
    ;;
  open-file)
    target="${MONITOR_HERDR_OPEN_FILE:-${HERDR_FILE_VIEWER_OPEN:-}}"
    query="${MONITOR_HERDR_OPEN_QUERY:-}"
    root="${MONITOR_HERDR_OPEN_ROOT:-${HERDR_WORKSPACE_CWD:-$PWD}}"
    if [[ -n "$query" ]]; then
      exec "$run_sh" open-file \
        --query "$query" \
        --root "$root" \
        --json
    fi
    if [[ -z "$target" ]]; then
      echo "MONITOR_HERDR_OPEN_FILE, HERDR_FILE_VIEWER_OPEN, or MONITOR_HERDR_OPEN_QUERY is required for open-file" >&2
      exit 2
    fi
    exec "$run_sh" open-file "$target" \
      --root "$root" \
      --json
    ;;
  *)
    echo "unknown monitor-herdr plugin command: $1" >&2
    exit 2
    ;;
esac
