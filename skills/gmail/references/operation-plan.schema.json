{
  "$defs": {
    "OAuthProfile": {
      "description": "Named least-privilege OAuth profiles stored independently.",
      "enum": [
        "readonly",
        "compose",
        "manage"
      ],
      "title": "OAuthProfile",
      "type": "string"
    },
    "Operation": {
      "description": "Closed set of supported Gmail write operations.",
      "enum": [
        "batch_modify",
        "trash",
        "untrash",
        "create_label",
        "create_draft",
        "send_message",
        "send_draft"
      ],
      "title": "Operation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable, account-bound, expiring human-approval plan.",
  "properties": {
    "account": {
      "format": "email",
      "title": "Account",
      "type": "string"
    },
    "approval_code": {
      "maxLength": 80,
      "minLength": 10,
      "title": "Approval Code",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Plan Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/OAuthProfile"
    },
    "schema": {
      "const": "gmail.operation_plan.v1",
      "default": "gmail.operation_plan.v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "operation",
    "profile",
    "account",
    "created_at",
    "expires_at",
    "payload",
    "payload_sha256",
    "approval_code"
  ],
  "title": "OperationPlan",
  "type": "object"
}
