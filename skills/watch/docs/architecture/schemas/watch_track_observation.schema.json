{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watch_track_observation.schema.json",
  "title": "Watch Track Observation",
  "type": "object",
  "required": [
    "schema",
    "track_observation_id",
    "asset_id",
    "segment_id",
    "track_id",
    "media_time_ms",
    "bbox",
    "source_event_id",
    "identity_status"
  ],
  "properties": {
    "schema": {
      "const": "watch.track_observation.v1"
    },
    "track_observation_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "segment_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "media_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "bbox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height",
        "coordinate_space"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "coordinate_space": {
          "enum": [
            "source_frame_pixels",
            "normalized_percent"
          ]
        }
      }
    },
    "source_event_id": {
      "type": "string"
    },
    "crop_sha256": {
      "type": "string"
    },
    "identity_status": {
      "enum": [
        "UNVERIFIED",
        "IDENTITY_CANDIDATE",
        "IDENTITY_SUPPORTED",
        "IDENTITY_INCONCLUSIVE",
        "IDENTITY_REFUTED"
      ]
    }
  },
  "additionalProperties": true
}
