{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watch_crop_reference_similarity_receipt_plan.schema.json",
  "title": "Watch Crop Reference Similarity Receipt Plan",
  "type": "object",
  "required": [
    "schema",
    "status",
    "asset",
    "entity_similarity_plans",
    "planned_similarity_comparisons",
    "receipt_requirements",
    "promotion_policy",
    "memory_requirements",
    "counts",
    "proof_scope",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "watch.crop_reference_similarity_receipt_plan.v1"
    },
    "status": {
      "const": "PLANNED_NOT_RUN"
    },
    "asset": {
      "type": "object",
      "required": ["asset_id", "asset_kind"]
    },
    "entity_similarity_plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_name",
          "status",
          "candidate_crop_count",
          "positive_reference_slot_count",
          "negative_reference_slot_count",
          "planned_comparison_count",
          "positive_control_comparison_count",
          "negative_control_comparison_count",
          "promotion_blockers"
        ],
        "properties": {
          "status": {
            "const": "BLOCKED_PENDING_EMBEDDINGS"
          },
          "promotion_blockers": {
            "type": "array",
            "contains": {
              "enum": [
                "CROP_EMBEDDING_RECEIPTS_MISSING",
                "REFERENCE_IMAGE_EMBEDDING_RECEIPTS_MISSING",
                "SIMILARITY_RECEIPTS_MISSING",
                "NEGATIVE_CONTROL_RECEIPTS_MISSING",
                "MEMORY_RECALL_NOT_VERIFIED"
              ]
            }
          }
        }
      }
    },
    "planned_similarity_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "comparison_id",
          "entity_id",
          "overlay_id",
          "track_id",
          "crop_embedding_point",
          "reference_slot_id",
          "reference_slot_kind",
          "reference_embedding_point",
          "similarity_receipt_status",
          "scene_truth_allowed",
          "promotion_allowed",
          "required_before_identity_support"
        ],
        "properties": {
          "reference_slot_kind": {
            "enum": ["positive", "negative"]
          },
          "similarity_receipt_status": {
            "const": "BLOCKED_PENDING_EMBEDDINGS"
          },
          "scene_truth_allowed": {
            "const": false
          },
          "promotion_allowed": {
            "const": false
          },
          "required_before_identity_support": {
            "const": true
          }
        }
      }
    },
    "receipt_requirements": {
      "type": "object",
      "required": [
        "crop_embedding_receipts_required",
        "reference_embedding_receipts_required",
        "positive_control_similarity_receipts_required",
        "negative_control_similarity_receipts_required",
        "memory_recall_receipt_required"
      ],
      "properties": {
        "crop_embedding_receipts_required": {
          "const": true
        },
        "reference_embedding_receipts_required": {
          "const": true
        },
        "positive_control_similarity_receipts_required": {
          "const": true
        },
        "negative_control_similarity_receipts_required": {
          "const": true
        },
        "memory_recall_receipt_required": {
          "const": true
        }
      }
    },
    "promotion_policy": {
      "type": "object",
      "required": [
        "similarity_without_text_scene_corroboration_can_promote_identity",
        "similarity_without_memory_recall_can_promote_identity",
        "domain_reference_seed_can_promote_identity",
        "supported_identity_requires"
      ],
      "properties": {
        "similarity_without_text_scene_corroboration_can_promote_identity": {
          "const": false
        },
        "similarity_without_memory_recall_can_promote_identity": {
          "const": false
        },
        "domain_reference_seed_can_promote_identity": {
          "const": false
        },
        "supported_identity_requires": {
          "type": "array",
          "contains": {
            "const": "negative_similarity_below_threshold"
          }
        }
      }
    },
    "memory_requirements": {
      "type": "object",
      "required": [
        "allowed_answer_path",
        "requires_intent_before_recall",
        "requires_items_key",
        "forbidden_results_key_dependency",
        "direct_qdrant_or_arango_answer_allowed"
      ],
      "properties": {
        "allowed_answer_path": {
          "const": "$memory recall"
        },
        "requires_items_key": {
          "const": true
        },
        "forbidden_results_key_dependency": {
          "const": true
        },
        "direct_qdrant_or_arango_answer_allowed": {
          "const": false
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "entity_plan_count",
        "candidate_crop_count",
        "planned_similarity_comparison_count",
        "positive_control_comparison_count",
        "negative_control_comparison_count"
      ]
    },
    "proof_scope": {
      "type": "array",
      "contains": {
        "const": "planned_not_run"
      }
    },
    "claims": {
      "type": "object",
      "required": ["proves", "does_not_prove"]
    }
  },
  "additionalProperties": true
}
