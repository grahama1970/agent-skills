{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "watch.recall_receipt.v1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "watch.recall_receipt.v1"
    },
    "query": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "extracted_entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "memory_recall_used": {
      "const": true
    },
    "trace_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answer_mode": {
      "enum": [
        "answer",
        "clarify",
        "deflect"
      ]
    },
    "evidence_case_created": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "query",
    "intent",
    "extracted_entities",
    "memory_recall_used",
    "trace_observation_ids",
    "source_refs",
    "answer_mode",
    "evidence_case_created"
  ]
}
