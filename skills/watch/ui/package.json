{
  "name": "watch-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build",
    "start": "node server/prod.js",
    "test": "tsx scripts/watchAnnotationSession.smoke.ts && tsx scripts/watchYoloLabelReceiptReplay.smoke.ts && tsx scripts/watchYoloReceiptConcurrency.smoke.ts && tsx scripts/watchDetectorCandidateIsolation.smoke.ts",
    "test:memory-suggestion-live": "tsx scripts/watchMemorySuggestionLive.smoke.ts",
    "test:yolo-label-receipt": "tsx scripts/watchYoloLabelReceiptReplay.smoke.ts",
    "test:receipt-concurrency": "tsx scripts/watchYoloReceiptConcurrency.smoke.ts",
    "test:detector-isolation": "tsx scripts/watchDetectorCandidateIsolation.smoke.ts",
    "test:backend-immutable": "npm run test:yolo-label-receipt && npm run test:receipt-concurrency && npm run test:detector-isolation",
    "playwright:install": "playwright install chromium",
    "test:immutable-browser-live": "tsx scripts/watchImmutableGoalBrowserLive.smoke.ts",
    "test:immutable-goal-live": "tsx scripts/watchImmutableGoalLive.smoke.ts",
    "prove:immutable-goal": "tsx scripts/watchImmutableGoalLive.smoke.ts --persist-proof",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "express": "^4.19.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "playwright": "^1.61.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
