{
  "name": "@agent-skills/ux-lab-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical shared chat UI components for the agent-skills ecosystem.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./memory-turn": {
      "types": "./memory-turn/index.ts",
      "default": "./memory-turn/index.ts"
    },
    "./memory-turn/SpartaComplianceAdapter": {
      "types": "./memory-turn/SpartaComplianceAdapter.ts",
      "default": "./memory-turn/SpartaComplianceAdapter.ts"
    },
    "./LeftPane": {
      "types": "./LeftPane.tsx",
      "default": "./LeftPane.tsx"
    }
  },
  "files": [
    "*.ts",
    "*.tsx",
    "memory-turn/*.ts",
    "PERSONAPLEX_CHATWELL_DEPRECATION.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "dagre": "^0.8.5",
    "framer-motion": "^12.42.1",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "katex": "^0.18.1"
  },
  "peerDependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.6.3"
  }
}
