{
  "version": 2,
  "skill": "ops-terraform",
  "trials": 3,
  "proof_scope": "live terraform doctor/validate against a real cloned module, saved-plan summary math, and fail-closed outcomes without the binary or module",
  "claims": {
    "proves": "the skill detects real terraform posture through its CLI, summarizes a saved plan deterministically, and fails closed with typed failure_codes",
    "does_not_prove": "plan against live state, apply, backend/state health, or provider authentication"
  },
  "cases": [
    {
      "name": "live-check-real-module",
      "type": "positive",
      "real_world": true,
      "command": ["bash", "-c", "export PATH=$HOME/.local/bin:$PATH; ../run.sh doctor && ../run.sh check $HOME/workspace/experiments/dwt-terraform-aws-helm-release"],
      "expected": {"exit_code": 0, "stdout_contains": ["\"valid\": true"]}
    },
    {
      "name": "plan-summary-counts",
      "type": "positive",
      "command": ["bash", "-c", "../run.sh plan-summary ../fixtures/sample_plan.json"],
      "expected": {"exit_code": 0, "stdout_contains": ["\"destroys\": 1", "\"destructive\": true"]}
    },
    {
      "name": "missing-module-fails-closed",
      "type": "negative",
      "command": ["bash", "-c", "export PATH=$HOME/.local/bin:$PATH; ../run.sh check /tmp/definitely-not-a-module-xyz; test $? -eq 1"],
      "expected": {"exit_code": 0, "stdout_contains": ["no_terraform_module"]}
    }
  ],
  "eval_kind": "skill_behavior"
}
