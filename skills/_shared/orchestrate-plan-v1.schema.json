{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrate-plan-v1",
  "title": "Orchestrate Plan v1",
  "description": "YAML/JSON schema for task files consumed by /orchestrate via structured_execute.py. Source of truth for plan.py Task/PlanFile dataclasses and structured_plan.py validation.",
  "type": "object",
  "required": ["version", "kind", "metadata", "repo_root", "tasks"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "orchestrate-plan"
    },
    "repo_root": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to the repository root. Tasks without explicit cwd inherit this. Required — no guessing from Path.cwd()."
    },
    "metadata": {
      "type": "object",
      "required": ["title", "goal"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "plan_type": { "type": "string", "enum": ["code", "design", "hybrid"] },
        "created": { "type": "string" },
        "primary_persona": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "role": { "type": "string" },
            "source": { "type": "string" }
          }
        },
        "context": { "type": "string", "description": "Conversation context — the WHY behind the plan" }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "max_concurrency": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "capability_overlap": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Phase 0 evidence: what /memory recall returned, which skills were checked"
    },
    "questions_blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "runner", "definition_of_done"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "lane": { "type": "string", "description": "Parallel group. Same lane = sequential, different lane = concurrent." },
          "runner": {
            "type": "string",
            "enum": ["local", "scillm", "code-runner"],
            "description": "How the task executes. subagent-service is deprecated — use code-runner or scillm."
          },
          "backend": {
            "type": "string",
            "description": "Which LLM model (sonnet, opus, codex, gemini). Empty for local tasks.",
            "examples": ["sonnet", "opus", "codex", "gemini"]
          },
          "mode": {
            "type": "string",
            "enum": ["iterative", "one_shot", "review", ""],
            "description": "Execution style. Empty for local tasks."
          },
          "agent": {
            "type": "string",
            "default": "general-purpose",
            "description": "Agent type or persona name"
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Task IDs this task depends on (DAG edges)"
          },
          "implementation": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Step-by-step instructions for the agent"
          },
          "tests": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Test commands including test-lab blind tests"
          },
          "definition_of_done": {
            "type": "object",
            "required": ["command", "assertion"],
            "properties": {
              "command": { "type": "string", "description": "Runnable verification command" },
              "assertion": { "type": "string", "description": "Concrete success criteria" }
            }
          },
          "read_context": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Files the LLM should READ for interface context but NOT write. Reduces unseen dependency failures."
          },
          "blind_tests": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Hidden test assertions the coding agent never sees. Run by /test-lab Docker service after visible DoD passes. Project agent writes these at plan time."
          },
          "max_rounds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "Max self-improvement rounds for code-runner tasks"
          },
          "command": {
            "type": "string",
            "description": "Shell command for local runner tasks"
          },
          "prompt": {
            "type": "string",
            "description": "Explicit prompt for scillm tasks (alternative to implementation)"
          },
          "context_boundary": {
            "type": "string",
            "description": "Context isolation hint for task dispatch"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "runner": { "const": "local" } } },
            "then": { "required": ["command"] }
          },
          {
            "if": { "properties": { "runner": { "const": "scillm" } } },
            "then": { "required": ["backend"] }
          },
          {
            "if": { "properties": { "runner": { "const": "code-runner" } } },
            "then": { "required": ["backend"] }
          }
        ]
      }
    }
  }
}
