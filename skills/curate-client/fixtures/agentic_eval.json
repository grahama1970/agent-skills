{
 "version": 2,
 "skill": "curate-client",
 "trials": 3,
 "proof_scope": "deterministic chunk extraction from a bundled mini OpenAPI spec, fail-closed interview gating, live-evidence prep-pack emission/regeneration, and a live memory-daemon ingest+recall round-trip when the daemon is reachable",
 "claims": {
  "proves": "the skill extracts Q-A chunks through its real CLI, fails closed with a NEEDS_INTERVIEW packet on missing required config, emits or regenerates the live_evidence.prep_pack.v1 handoff, and can ingest a fixture KB into /memory and recall it through the live daemon",
  "does_not_prove": "arbitrary client corpora, docs fetching (delegated to fetcher/brave-search), Qdrant semantic ranking quality, or live-evidence UI rendering of the cards"
 },
 "cases": [
  {
   "name": "real-chunks-extract-drivewealth-spec",
   "type": "positive",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "../run.sh chunks --config ../configs/drivewealth.yaml && test $(find /home/graham/workspace/experiments/dw-openapi/knowledge -name '*.md' | wc -l) -ge 400"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "chunks_written"
    ]
   }
  },
  {
   "name": "missing-config-fails-closed-needs-interview",
   "type": "negative",
   "command": [
    "bash",
    "-c",
    "printf 'kb_root: /tmp/x\\n' > /tmp/curate-client-bad.yaml && ../run.sh plan --config /tmp/curate-client-bad.yaml; test $? -eq 3"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "NEEDS_INTERVIEW",
     "missing_fields"
    ]
   }
  },
  {
   "name": "drivewealth-prep-pack-emits-live-evidence-contract",
   "type": "positive",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "../run.sh prep-pack --config ../configs/drivewealth.yaml"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "\"schema\": \"curate_client.prep_pack_receipt.v1\"",
     "\"status\": \"PASS\"",
     "\"schema\": \"live_evidence.prep_pack.v1\"",
     "\"question_oracles\"",
     "\"briefing_pack\"",
     "\"live_evidence_load\"",
     "\"load-prep-pack\""
    ]
   }
  },
  {
   "name": "drivewealth-prep-pack-regenerates-missing-output",
   "type": "adversarial",
   "real_world": true,
   "evidence_class": "live_e2e",
   "readback": true,
   "command": [
    "bash",
    "-c",
    "O=\"${TMPDIR:-/tmp}/curate-client-regenerate-current.json\"; rm -f \"$O\"; python3 ../scripts/eval_regenerate_prep_pack.py --output \"$O\" --memory-url http://127.0.0.1:8601"
   ],
   "timeout_seconds": 420,
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "missing prep-pack path regenerated: PASS",
     "generated prep pack validates through live-evidence: PASS",
     "generated prep pack oracle recall loads: PASS",
     "curate-client regenerate prep-pack: PASS"
    ],
    "artifacts": [
     {
      "path": "/tmp/curate-client-regenerate-current.json",
      "json_pointer": "/status",
      "equals": "PASS"
     },
     {
      "path": "/tmp/curate-client-regenerate-current.json",
      "json_pointer": "/checks/missing prep-pack path regenerated",
      "equals": true
     },
     {
      "path": "/tmp/curate-client-regenerate-current.json",
      "json_pointer": "/checks/generated prep pack validates through live-evidence",
      "equals": true
     },
     {
      "path": "/tmp/curate-client-regenerate-current.json",
      "json_pointer": "/checks/generated prep pack oracle recall loads",
      "equals": true
     },
     {
      "path": "/tmp/curate-client-regenerate-current.json",
      "json_pointer": "/pack_summary/producer/generated",
      "equals": true
     }
    ]
   },
   "notes": "Regression for curate-client pipeline regeneration: prep-pack must create a missing configured live_evidence_prep_pack from config + KB + live Memory recall, then pass Live Evidence validation and oracle-recall loading. Failures route through triage-error and pipeline-self-repair."
  },
  {
   "name": "live-verify-recall-drivewealth-e2e",
   "type": "positive",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "if ! curl -s -m 5 http://127.0.0.1:8601/health >/dev/null; then echo 'probes SKIP daemon-unreachable'; exit 0; fi; ../run.sh verify --config ../configs/drivewealth.yaml"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "probes"
    ]
   }
  },
  {
   "name": "research-plan-derives-collaboration-points",
   "type": "positive",
   "real_world": true,
   "command": [
    "bash",
    "-c",
    "../run.sh research-plan --config ../configs/drivewealth.yaml"
   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "collaboration_points",
     "identity team",
     "coverage_question",
     "interview_packet"
    ]
   }
  }
 ],
 "eval_kind": "skill_behavior"
}