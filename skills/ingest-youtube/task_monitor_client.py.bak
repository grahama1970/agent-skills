#!/usr/bin/env python3
"""Task Monitor Client for ingest-youtube skill.

Integrates with the centralized task-monitor skill by:
1. Registering tasks in ~/.pi/task-monitor/registry.json
2. Writing state files that task-monitor TUI can display
3. Updating progress per video (not just on completion)

Usage:
    monitor = IngestYoutubeTaskClient("batch-100", total_videos=100)
    for video in videos:
        result = process_video(video)
        monitor.update(video_id, result)
    monitor.finish()
"""

import json
import os
import time
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Any, Optional
from loguru import logger

# Task monitor registry location
TASK_MONITOR_REGISTRY = Path.home() / ".pi" / "task-monitor" / "registry.json"
SKILL_DIR = Path(__file__).parent
STATE_FILE = SKILL_DIR / "ingest_youtube_task_state.json"
ERROR_LOG = SKILL_DIR / "ingest_youtube_errors.json"


@dataclass
class MethodMetrics:
    """Track success/fail counts per extraction method."""
    attempts: int = 0
    successes: int = 0

    @property
    def rate(self) -> float:
        return self.successes / self.attempts if self.attempts > 0 else 0.0

    def to_dict(self) -> Dict[str, Any]:
        return {
            "attempts": self.attempts,
            "successes": self.successes,
            "rate": round(self.rate, 4),
        }


@dataclass
class FailureRecord:
    """Record of a video processing failure."""
    video_id: str
    error: str
    method_tried: str
    is_rate_limit: bool = False
    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())

    def to_dict(self) -> Dict[str, Any]:
        return {
            "video_id": self.video_id,
            "error": self.error[:100],
            "method_tried": self.method_tried,
            "is_rate_limit": self.is_rate_limit,
            "timestamp": self.timestamp,
        }


class IngestYoutubeTaskClient:
    """Task-monitor compatible progress tracker for ingest-youtube.

    Writes state to ingest_youtube_task_state.json which task-monitor TUI can display.
    """

    def __init__(
        self,
        task_name: str,
        total_videos: int,
        description: Optional[str] = None,
        register: bool = True,
    ):
        self.task_name = task_name
        self.total_videos = total_videos
        self.description = description or f"Ingest-YouTube: {task_name}"

        # Progress tracking
        self.completed = 0
        self.start_time = time.time()
        self.last_update = 0.0

        # Method metrics
        self.methods: Dict[str, MethodMetrics] = {}

        # Failure tracking
        self.failures: List[FailureRecord] = []
        self.success_count = 0
        self.skipped_count = 0
        self.rate_limit_count = 0

        # Register with task-monitor
        if register:
            self._register_task()

        # Initial state write
        self._write_state()

    def _register_task(self):
        """Register this task with task-monitor registry."""
        try:
            TASK_MONITOR_REGISTRY.parent.mkdir(parents=True, exist_ok=True)

            registry = {}
            if TASK_MONITOR_REGISTRY.exists():
                try:
                    registry = json.loads(TASK_MONITOR_REGISTRY.read_text())
                except Exception:
                    registry = {}

            registry[f"ingest-youtube:{self.task_name}"] = {
                "state_file": str(STATE_FILE),
                "total": self.total_videos,
                "description": self.description,
                "project": "ingest-youtube",
                "registered_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            }

            tmp = TASK_MONITOR_REGISTRY.with_suffix(".tmp")
            tmp.write_text(json.dumps(registry, indent=2))
            os.replace(tmp, TASK_MONITOR_REGISTRY)
        except Exception as e:
            logger.debug("value lookup failed: {}", e)

    def _write_state(self, final: bool = False):
        """Update task-monitor state file."""
        now = time.time()

        if not final and (now - self.last_update) < 0.3:
            return
        self.last_update = now

        elapsed = now - self.start_time
        progress_pct = (self.completed / self.total_videos * 100) if self.total_videos > 0 else 0

        eta_seconds = None
        if self.completed > 0 and self.completed < self.total_videos:
            rate = self.completed / elapsed
            remaining = self.total_videos - self.completed
            eta_seconds = remaining / rate if rate > 0 else None

        success_rate = self.success_count / self.completed if self.completed > 0 else 0.0

        state = {
            "completed": self.completed,
            "total": self.total_videos,
            "description": self.description,
            "current_item": f"video {self.completed + 1}/{self.total_videos}",
            "progress_pct": round(progress_pct, 1),
            "elapsed_seconds": round(elapsed, 1),
            "eta_seconds": round(eta_seconds, 1) if eta_seconds else None,
            "methods": {name: metrics.to_dict() for name, metrics in self.methods.items()},
            "stats": {
                "success_count": self.success_count,
                "failure_count": len(self.failures),
                "skipped_count": self.skipped_count,
                "rate_limit_count": self.rate_limit_count,
                "success_rate": round(success_rate, 4),
            },
            "failures": [f.to_dict() for f in self.failures[-20:]],
            "last_updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "status": "completed" if final else "running",
        }

        try:
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(state, indent=2))
            os.replace(tmp, STATE_FILE)
        except Exception as e:
            logger.debug("tmp failed: {}", e)

    def update(
        self,
        video_id: str,
        success: bool,
        method: Optional[str] = None,
        error: Optional[str] = None,
        is_rate_limit: bool = False,
        skipped: bool = False,
    ):
        """Update progress after processing a video."""
        self.completed += 1

        if skipped:
            self.skipped_count += 1
        elif success:
            self.success_count += 1
            if method:
                if method not in self.methods:
                    self.methods[method] = MethodMetrics()
                self.methods[method].attempts += 1
                self.methods[method].successes += 1
        else:
            if is_rate_limit:
                self.rate_limit_count += 1
            if method:
                if method not in self.methods:
                    self.methods[method] = MethodMetrics()
                self.methods[method].attempts += 1
            self.failures.append(FailureRecord(
                video_id=video_id,
                error=error or "Unknown error",
                method_tried=method or "unknown",
                is_rate_limit=is_rate_limit,
            ))

        self._write_state()

    def finish(self, success: bool = True):
        """Mark the task as complete."""
        self._write_state(final=True)

        if self.failures:
            try:
                error_data = {
                    "task_name": self.task_name,
                    "completed_at": datetime.now().isoformat(),
                    "success": success,
                    "total_videos": self.total_videos,
                    "total_failures": len(self.failures),
                    "methods": {name: metrics.to_dict() for name, metrics in self.methods.items()},
                    "failures": [f.to_dict() for f in self.failures],
                }
                tmp = ERROR_LOG.with_suffix(".tmp")
                tmp.write_text(json.dumps(error_data, indent=2))
                os.replace(tmp, ERROR_LOG)
            except Exception as e:
                logger.debug("value lookup failed: {}", e)

    def get_summary(self) -> Dict[str, Any]:
        """Get a summary for logging/reporting."""
        elapsed = time.time() - self.start_time
        return {
            "task_name": self.task_name,
            "completed": self.completed,
            "total": self.total_videos,
            "elapsed_seconds": round(elapsed, 1),
            "success_rate": self.success_count / self.completed if self.completed > 0 else 0,
            "failures": len(self.failures),
            "rate_limits": self.rate_limit_count,
        }


# Convenience functions
_current_client: Optional[IngestYoutubeTaskClient] = None


def start_monitoring(task_name: str, total_videos: int) -> IngestYoutubeTaskClient:
    """Start monitoring a new ingest-youtube task."""
    global _current_client
    _current_client = IngestYoutubeTaskClient(task_name, total_videos)
    return _current_client


def get_monitor() -> Optional[IngestYoutubeTaskClient]:
    """Get the current task monitor."""
    return _current_client


def end_monitoring(success: bool = True):
    """End the current task monitoring."""
    global _current_client
    if _current_client:
        _current_client.finish(success)
        _current_client = None
