{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/battle/schemas/battle.snapshot.v1.schema.json",
  "title": "Battle Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "battle_id",
    "run_id",
    "last_seq",
    "generated_at",
    "mode",
    "clock",
    "battle_clock",
    "round_config",
    "battle_timeline_control",
    "events",
    "segments",
    "lanes",
    "lineage",
    "semantic_replay",
    "scoreboard",
    "claims",
    "validation",
    "replay_compression_policy"
  ],
  "properties": {
    "schema": {
      "const": "battle.snapshot.v1"
    },
    "battle_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "live",
        "receipt_replay",
        "paused_replay",
        "design_fixture"
      ]
    },
    "clock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "battle_clock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "round_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "battle_timeline_control": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "lineage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "semantic_replay": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "scoreboard": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "claims": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "validation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "replay_compression_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "owner",
        "source_time_authority",
        "long_gap_handling",
        "backend_emits_cinematic_speed"
      ],
      "properties": {
        "owner": {
          "const": "ux"
        },
        "source_time_authority": {
          "const": "receipt_elapsed_seconds"
        },
        "long_gap_handling": {
          "const": "ux_may_compress_presentation_time"
        },
        "backend_emits_cinematic_speed": {
          "const": false
        }
      }
    }
  }
}
