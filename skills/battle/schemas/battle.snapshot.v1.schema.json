{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/battle/schemas/battle.snapshot.v1.schema.json",
  "title": "Battle Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "battle_id",
    "run_id",
    "last_seq",
    "generated_at",
    "mode",
    "clock",
    "battle_clock",
    "round_config",
    "battle_timeline_control",
    "events",
    "segments",
    "lanes",
    "lineage",
    "semantic_replay",
    "scoreboard",
    "claims",
    "validation",
    "replay_compression_policy",
    "source_time_window"
  ],
  "properties": {
    "schema": {
      "const": "battle.snapshot.v1"
    },
    "battle_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "live",
        "receipt_replay",
        "paused_replay",
        "design_fixture"
      ]
    },
    "clock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "battle_clock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "round_config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "battle_timeline_control": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "lineage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "semantic_replay": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "scoreboard": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "claims": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "validation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "replay_compression_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "owner",
        "source_time_authority",
        "source_time_window_schema",
        "source_duration_seconds",
        "long_gap_handling",
        "long_gap_threshold_seconds",
        "long_gap_count",
        "backend_emits_cinematic_speed"
      ],
      "properties": {
        "owner": {
          "const": "ux"
        },
        "source_time_authority": {
          "const": "receipt_elapsed_seconds"
        },
        "source_time_window_schema": {
          "const": "battle.source_time_window.v1"
        },
        "source_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "long_gap_handling": {
          "const": "ux_may_compress_presentation_time"
        },
        "long_gap_threshold_seconds": {
          "type": "number",
          "minimum": 0
        },
        "long_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "backend_emits_cinematic_speed": {
          "const": false
        }
      }
    },
    "source_time_window": {
      "$ref": "#/$defs/source_time_window"
    }
  },
  "$defs": {
    "source_time_window": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "source_time_authority",
        "start_seconds",
        "end_seconds",
        "source_duration_seconds",
        "event_count",
        "long_gap_threshold_seconds",
        "max_gap_seconds",
        "long_gap_count",
        "long_gap_segments",
        "presentation_owner",
        "proof_mode"
      ],
      "properties": {
        "schema": {
          "const": "battle.source_time_window.v1"
        },
        "source_time_authority": {
          "const": "receipt_elapsed_seconds"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "source_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "long_gap_threshold_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_gap_seconds": {
          "type": "number",
          "minimum": 0
        },
        "long_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "long_gap_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "from_source_seconds",
              "to_source_seconds",
              "gap_seconds",
              "compression_allowed",
              "presentation_owner"
            ],
            "properties": {
              "compression_allowed": {
                "const": true
              },
              "presentation_owner": {
                "const": "ux"
              }
            }
          }
        },
        "presentation_owner": {
          "const": "ux"
        },
        "proof_mode": {
          "const": "receipt_backed_fixture"
        }
      }
    }
  }
}
