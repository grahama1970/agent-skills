{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "battle.normalized_music_fixture.v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "fixture_id", "battle_id", "generated_at", "status", "mocked", "proof_mode", "context_summary", "promotions", "schedule", "events_present", "events_not_emitted", "playback_contract", "claim_boundary", "receipt_refs", "provenance", "frontend_handoff"],
  "properties": {
    "schema": {"const": "battle.normalized_music_fixture.v1"}, "fixture_id": {"type": "string"}, "battle_id": {"type": "string"}, "generated_at": {"type": "string"}, "status": {"const": "PASS"}, "mocked": {"const": false}, "proof_mode": {"const": "receipt_backed_promotion_schedule"},
    "context_summary": {"type": "object", "required": ["phase", "intensity", "playhead_elapsed_seconds"], "properties": {"phase": {"type": "string"}, "intensity": {"type": "number", "minimum": 0, "maximum": 1}, "playhead_elapsed_seconds": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "promotions": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["promotion_id", "status", "score_id", "canonical_music_id", "validation", "assets", "eligibility", "promotion_receipt_sha256"], "properties": {"promotion_id": {"type": "string"}, "status": {"const": "PASS"}, "score_id": {"type": "string"}, "canonical_music_id": {"type": "string"}, "validation": {"type": "object"}, "assets": {"type": "array"}, "eligibility": {"type": "object"}, "promotion_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "schedule": {"type": "object"},
    "events_present": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "events_not_emitted": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "playback_contract": {"type": "object", "required": ["time_domain", "browser_format", "midi_is_source_material", "local_actor_focus_is_preview_only", "music_never_authorizes_battle_truth"], "properties": {"time_domain": {"const": "elapsed_seconds"}, "browser_format": {"const": "audio/ogg"}, "midi_is_source_material": {"const": true}, "local_actor_focus_is_preview_only": {"const": true}, "music_never_authorizes_battle_truth": {"const": true}}, "additionalProperties": false},
    "claim_boundary": {"$ref": "#/$defs/boundary"}, "receipt_refs": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "provenance": {"type": "object", "required": ["raw_paths_redacted", "composer_paths_exposed", "create_midi_paths_exposed", "credentials_exposed", "source_fixture_sha256"], "properties": {"raw_paths_redacted": {"const": true}, "composer_paths_exposed": {"const": false}, "create_midi_paths_exposed": {"const": false}, "credentials_exposed": {"const": false}, "source_fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "frontend_handoff": {"type": "object", "required": ["route", "schedule_field", "promotion_field", "claim_boundary_field"], "properties": {"route": {"type": "string"}, "schedule_field": {"const": "schedule.entries"}, "promotion_field": {"const": "promotions"}, "claim_boundary_field": {"const": "claim_boundary"}}, "additionalProperties": false}
  },
  "$defs": {"boundary": {"type": "object", "required": ["may_claim", "must_not_claim"], "properties": {"may_claim": {"type": "array", "items": {"type": "string"}}, "must_not_claim": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}
}
