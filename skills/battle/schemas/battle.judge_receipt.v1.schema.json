{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battle.judge_receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "battle_id",
    "round_number",
    "judge_number",
    "status",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "battle.judge_receipt.v1"
    },
    "battle_id": {
      "type": "string"
    },
    "round_number": {
      "type": "integer",
      "minimum": 1
    },
    "judge_number": {
      "enum": [
        1,
        2
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "verdict": {
      "enum": [
        "CONFIRMED",
        "REJECTED",
        "BLUE_SUCCESS",
        "RED_SUCCESS",
        "FAKE_DEFENSE",
        "REPLAY_ERROR",
        "HASH_MISMATCH",
        "INSUFFICIENT_EVIDENCE",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": true
}
