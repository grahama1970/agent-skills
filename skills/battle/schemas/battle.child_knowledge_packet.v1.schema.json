{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/battle/schemas/battle.child_knowledge_packet.v1.schema.json",
  "title": "Battle Child Knowledge Packet",
  "type": "object",
  "required": ["schema", "battle_id", "parent_lane_id", "child_lane_id", "arena_public_context_refs", "forbidden_context_refs", "inherited_methods", "parent_specimens", "observations", "hypotheses", "blocked_ideas", "next_research_questions", "claims"],
  "properties": {
    "schema": { "const": "battle.child_knowledge_packet.v1" },
    "battle_id": { "type": "string", "minLength": 1 },
    "parent_lane_id": { "type": "string", "minLength": 1 },
    "child_lane_id": { "type": "string", "minLength": 1 },
    "arena_public_context_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_context_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "inherited_methods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "parent_specimens": { "type": "array", "items": { "type": "object" } },
    "observations": { "type": "object" },
    "hypotheses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "blocked_ideas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "next_research_questions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "claims": {
      "type": "object",
      "required": ["proves", "does_not_prove"],
      "properties": {
        "proves": { "type": "array", "items": { "type": "string" } },
        "does_not_prove": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": true
}
