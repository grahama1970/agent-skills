{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battle.round_receipt.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "mocked",
    "live",
    "agentic",
    "event_ledger",
    "scorekeeper_receipt",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "battle.reactive_judge_round.v1"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "verdict": {
      "type": "string"
    },
    "mocked": {
      "const": false
    },
    "live": {
      "const": "local_docker_fixture"
    },
    "agentic": {
      "const": false
    },
    "event_ledger": {
      "type": "string"
    },
    "scorekeeper_receipt": {
      "type": "string"
    },
    "claims": {
      "type": "object",
      "required": [
        "proves",
        "does_not_prove"
      ],
      "properties": {
        "proves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_prove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
