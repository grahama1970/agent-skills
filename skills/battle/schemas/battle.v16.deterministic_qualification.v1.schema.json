{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battle.v16.deterministic_qualification.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "battle.v16.deterministic_qualification.v1"},
    "status": {"const": "BLOCKED"},
    "target_id": {"const": "battle-v16-relayforge-a"},
    "target_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freeze_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "judge_outcome_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pass_emitted": {"const": false},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "may_claim": {"type": "array", "items": {"type": "string"}},
        "must_not_claim": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      },
      "required": ["may_claim", "must_not_claim"]
    }
  },
  "required": ["schema", "status", "target_id", "target_identity_sha256", "freeze_manifest_sha256", "judge_outcome_sha256", "blockers", "pass_emitted", "claims"]
}
