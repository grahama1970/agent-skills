{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/battle/schemas/battle.child_candidate_methods.v1.schema.json",
  "title": "Battle Child Candidate Methods",
  "type": "object",
  "required": [
    "schema",
    "battle_id",
    "child_lane_id",
    "status",
    "mocked",
    "live",
    "provider_live",
    "fixture_fallback_used",
    "source_receipts",
    "methods",
    "claims"
  ],
  "properties": {
    "schema": { "const": "battle.child_candidate_methods.v1" },
    "battle_id": { "type": "string", "minLength": 1 },
    "child_lane_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "mocked": { "const": false },
    "live": { "const": "tau_command_spec_node" },
    "provider_live": { "const": false },
    "fixture_fallback_used": { "const": false },
    "source_receipts": { "type": "array", "items": { "type": "string" } },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method_id", "name", "source", "complexity", "technique_class", "evidence_refs", "rationale"],
        "properties": {
          "method_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "complexity": { "type": "string", "minLength": 1 },
          "technique_class": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "object",
      "required": ["proves", "does_not_prove"],
      "properties": {
        "proves": { "type": "array", "items": { "type": "string" } },
        "does_not_prove": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": true
}
