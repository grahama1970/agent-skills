        },
        {
          "name": "lsusb",
          "version_command": "lsusb --version"
        },
        {
          "name": "iw",
          "version_command": "iw --version"
        },
        {
          "name": "iwconfig",
          "version_command": "iwconfig --version 2>&1 | head -n 1"
        },
        {
          "name": "hostapd",
          "version_command": "hostapd -v 2>&1 | head -n 1"
        },
        {
          "name": "wpa_supplicant",
          "version_command": "wpa_supplicant -v 2>&1 | head -n 1"
