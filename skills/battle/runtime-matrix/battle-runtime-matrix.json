        {
          "name": "mtools",
          "version_command": "mtools -V 2>&1 | head -n 1"
        },
        {
          "name": "parted",
          "version_command": "parted --version | head -n 1"
        },
        {
          "name": "battle-http-junk",
          "version_command": "battle-http-junk --help | head -n 1"
        },
        {
          "name": "tini",
          "version_command": "tini --version"
        }
      ],
      "package_managers": [],
      "capabilities": [
        "receipt",
        "filesystem",
        "archive",
        "process-control",
        "entry-point-driving",
        "bounded-http-junk-requests",
        "local-service-networking",
        "dns-spoof-simulation",
        "rogue-service-simulation",
        "route-and-firewall-inspection",
        "packet-capture",
        "packet-crafting",
        "port-and-service-discovery",
        "wifi-radio-tooling",
        "usb-removable-media-tooling"
      ],
      "scenario_classes": [
        "http-entry-point",
        "http-junk-requests",
        "local-service-fuzzing",
        "request-rate-resilience",
        "dns-spoofing-simulation",
        "wifi-spoofing-simulation",
        "arp-route-simulation",
        "rogue-service",
        "packet-capture-analysis",
        "port-scan-resilience",
        "wifi-radio-entry-point",
        "usb-removable-media-entry-point"
      ],
      "cwe_targets": ["CWE-200", "CWE-287", "CWE-300", "CWE-319", "CWE-400", "CWE-770"],
      "allowed_tool_overlays": [],
      "receipt_commands": [
        "id",
        "uname -a",
        "cat /etc/os-release",
        "bash --version | head -n 1",
        "jq --version",
        "file --version | head -n 1",
        "curl --version | head -n 1",
        "ab -V 2>&1 | head -n 1",
        "command -v nc",
        "socat -V 2>&1 | head -n 1",
        "ip -Version",
        "dig -v",
        "dnsmasq --version | head -n 1",
        "nmap --version | head -n 1",
        "hping3 --version 2>&1 | head -n 1",
        "tcpdump --version | head -n 1",
        "nft --version",
        "iptables --version",
        "traceroute --version 2>&1 | head -n 1",
        "lsusb --version",
        "iw --version",
        "iwconfig --version 2>&1 | head -n 1",
        "hostapd -v 2>&1 | head -n 1",
        "wpa_supplicant -v 2>&1 | head -n 1",
        "rfkill --version",
        "udevadm --version",
        "mkfs.vfat -V 2>&1 | head -n 1",
        "fsck.exfat -V 2>&1 | head -n 1",
        "mtools -V 2>&1 | head -n 1",
        "parted --version | head -n 1",
        "battle-http-junk --help | head -n 1",
        "tini --version",
        "battle-runtime-info"
      ],
      "run_contract": {
        "docker_args": [
          "--network",
          "none",
          "--cap-drop",
          "ALL",
          "--security-opt",
          "no-new-privileges",
          "--user",
          "1000:1000"
        ],
        "workdir": "/workspace",
        "timeout_seconds_default": 30,
        "memory_limit": "512m",
        "pids_limit": 256,
        "entry_point_driver": {
          "default_target_scope": "container_local_only",
          "http_junk_receipt_schema": "battle.http_junk_receipt.v1",
          "max_requests_without_explicit_override": 10000,
          "max_concurrency_without_explicit_override": 100,
          "network_simulation_scope": [
            "container_local_dns",
            "container_local_rogue_service",
            "loopback_packet_capture",
            "local_port_scan",
            "route_and_firewall_inspection",
            "wifi_radio_tool_presence",
            "usb_media_tool_presence"
          ],
          "requires_elevated_runtime_for": [
            "raw_packet_transmit",
            "iptables_mutation",
            "nftables_mutation",
            "non-loopback_packet_capture",
            "real_wifi_radio_control",
            "host_usb_device_access"
          ],
          "default_denies": [
            "host_wifi_device_mounts"
          ],
          "observed_default_host_usb_metadata_visible": true,
          "topology_orchestration_location": "arena_host_harness_not_battle_base",
          "arena_profile_must_declare": [
            "device_mounts",
            "cap_add",
            "network_mode",
            "host_mutation_risk"
          ]
        }
      }
    }
  ],
  "selection_policy": {
    "arena_selects_by": ["language_families", "scenario_classes", "cwe_targets"],
    "red_tools_require_explicit_overlay": true,
    "blue_tools_require_explicit_overlay": true
  }
}
