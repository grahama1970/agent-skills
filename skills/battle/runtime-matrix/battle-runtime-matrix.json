{
  "$schema": "https://battle.local/schemas/battle-runtime-matrix.v1.json",
  "matrix_version": "2026.06.30",
  "default_policy": {
    "network": "none",
    "user": "1000:1000",
    "cap_drop": ["ALL"],
    "security_opt": ["no-new-privileges"],
    "allow_host_mutation": false,
    "runtime_dependency_installs": "deny_unless_adapter_declared",
    "architectures": ["linux/amd64"],
    "receipt_required": true
  },
  "team_language_policy": {
    "arena_selects": [
      "project_context",
      "target_language",
      "entry_point_type",
      "hidden_bug_class",
      "runtime_image",
      "allowed_language_sets"
    ],
    "red_selects": [
      "red_selected_language",
      "red_selected_tools",
      "exploit_driver_strategy"
    ],
    "blue_selects": [
      "blue_selected_language",
      "blue_selected_tools",
      "defense_strategy"
    ],
    "selection_rule": "teams_choose_from_allowed_languages_declared_by_arena_or_runtime_profile",
    "runtime_installs_during_round": "deny_unless_adapter_declared",
    "receipt_required_fields": [
      "target_language",
      "red_allowed_languages",
      "blue_allowed_languages",
      "red_selected_language",
      "blue_selected_language",
      "image_digest",
      "tool_versions"
    ]
  },
  "images": [
    {
      "id": "battle-base",
      "phase": "v1",
      "role": "foundation",
      "language_families": [],
      "team_language_selection": {
        "target_language": "scenario_declared",
        "red_allowed_languages": [
          "shell",
          "curl",
          "raw-http",
          "network-cli",
          "wifi-cli",
          "usb-media-cli"
        ],
        "blue_allowed_languages": [
          "shell",
          "config",
          "network-cli",
          "wifi-cli",
          "usb-media-cli"
        ],
        "red_selected_language": "receipt_declared",
        "blue_selected_language": "receipt_declared",
        "missing_language_policy": "request_runtime_profile_for_future_round"
      },
      "base": {
        "image": "debian",
        "tag": "bookworm-slim",
        "digest": "sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df"
      },
      "battle_image": {
        "name": "battle-base",
        "tag": "2026.06.30",
        "digest": "sha256:903ef87dccba257fd7d7c0e4a4746780df5a582a7f354d66048e2bde57b5a731",
        "digest_kind": "local_image_id_until_pushed"
      },
      "os": {
        "family": "debian",
        "version": "bookworm"
      },
      "toolchain": [
        {
          "name": "bash",
          "version_command": "bash --version | head -n 1"
        },
        {
          "name": "jq",
          "version_command": "jq --version"
        },
        {
          "name": "file",
