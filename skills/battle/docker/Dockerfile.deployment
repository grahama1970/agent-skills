FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        python3-pip \
        python3-venv \
    && python3 -m pip install --break-system-packages uv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY skills /app/skills

WORKDIR /app/skills/battle/spectator
RUN npm ci --prefer-offline \
    && npm run build

WORKDIR /app/skills/battle
ENV BATTLE_STORAGE_ROOT=/tmp/battle-storage
ENV UV_PROJECT_ENVIRONMENT=/tmp/battle-storage/.venv
ENV PYTHONPATH=/app/skills:/app:/app/skills/battle/src

EXPOSE 33707 50111 57711

ENTRYPOINT ["bash", "/app/skills/battle/docker/deployment-entrypoint.sh"]
