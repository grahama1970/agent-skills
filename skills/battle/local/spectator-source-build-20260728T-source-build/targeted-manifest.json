{
  "version": 1,
  "app": "Battle Spectator",
  "base_url": "http://127.0.0.1:3015/#battle",
  "surfaces": [
    {
      "name": "battle-receipt-controls",
      "path": "/",
      "wait_ready": "[data-qid='battle:roster:search']",
      "wait_ready_timeout_ms": 20000,
      "qid_compliance": false,
      "elements": [
        {
          "name": "agent-search-and-selection",
          "interactions": [
            {
              "action": "type",
              "target": "[data-qid='battle:roster:search']",
              "value": "red",
              "description": "Filter Battle agents",
              "assert_value": {
                "selector": "[data-qid='battle:roster:search']",
                "value": "red"
              },
              "assert_title": "[data-qid='battle:roster:search']",
              "assert_qs_action": "[data-qid='battle:roster:search']",
              "assert_min_size": {
                "selector": "[data-qid='battle:roster:search']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:leaderboard:item:payload-857-red-1']",
              "description": "Select red child lane from roster",
              "assert_selector": "[data-qid='battle:agent-pane:payload-857-red-1']",
              "assert_title": "[data-qid='battle:leaderboard:item:payload-857-red-1']",
              "assert_qs_action": "[data-qid='battle:leaderboard:item:payload-857-red-1']",
              "assert_min_size": {
                "selector": "[data-qid='battle:leaderboard:item:payload-857-red-1']",
                "min_width": 44,
                "min_height": 44
              }
            }
          ]
        },
        {
          "name": "timeline-zoom",
          "interactions": [
            {
              "action": "click",
              "target": "[data-qid='battle:timeline:zoom:in']",
              "description": "Zoom Battle timeline in",
              "assert_title": "[data-qid='battle:timeline:zoom:in']",
              "assert_qs_action": "[data-qid='battle:timeline:zoom:in']",
              "assert_min_size": {
                "selector": "[data-qid='battle:timeline:zoom:in']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:timeline:zoom:out']",
              "description": "Zoom Battle timeline out",
              "assert_title": "[data-qid='battle:timeline:zoom:out']",
              "assert_qs_action": "[data-qid='battle:timeline:zoom:out']",
              "assert_min_size": {
                "selector": "[data-qid='battle:timeline:zoom:out']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:timeline:zoom:fit']",
              "description": "Reset Battle timeline zoom",
              "assert_title": "[data-qid='battle:timeline:zoom:fit']",
              "assert_qs_action": "[data-qid='battle:timeline:zoom:fit']",
              "assert_min_size": {
                "selector": "[data-qid='battle:timeline:zoom:fit']",
                "min_width": 44,
                "min_height": 44
              }
            }
          ]
        },
        {
          "name": "agent-detail-tabs",
          "interactions": [
            {
              "action": "click",
              "target": "[data-qid='battle:agent-pane:tab:live']",
              "description": "Open Live tab",
              "assert_attribute": {
                "selector": "[data-qid='battle:agent-pane:tab:live']",
                "attribute": "data-state",
                "value": "active"
              },
              "assert_title": "[data-qid='battle:agent-pane:tab:live']",
              "assert_qs_action": "[data-qid='battle:agent-pane:tab:live']",
              "assert_min_size": {
                "selector": "[data-qid='battle:agent-pane:tab:live']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:agent-pane:tab:logs']",
              "description": "Open Logs tab",
              "assert_attribute": {
                "selector": "[data-qid='battle:agent-pane:tab:logs']",
                "attribute": "data-state",
                "value": "active"
              },
              "assert_title": "[data-qid='battle:agent-pane:tab:logs']",
              "assert_qs_action": "[data-qid='battle:agent-pane:tab:logs']",
              "assert_min_size": {
                "selector": "[data-qid='battle:agent-pane:tab:logs']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:agent-pane:tab:summary']",
              "description": "Return to Summary tab",
              "assert_attribute": {
                "selector": "[data-qid='battle:agent-pane:tab:summary']",
                "attribute": "data-state",
                "value": "active"
              },
              "assert_title": "[data-qid='battle:agent-pane:tab:summary']",
              "assert_qs_action": "[data-qid='battle:agent-pane:tab:summary']",
              "assert_min_size": {
                "selector": "[data-qid='battle:agent-pane:tab:summary']",
                "min_width": 44,
                "min_height": 44
              }
            }
          ]
        },
        {
          "name": "pane-controls",
          "interactions": [
            {
              "action": "click",
              "target": "[data-qid='battle:agent-pane:lifecycle-toggle']",
              "description": "Toggle lifecycle evidence",
              "assert_title": "[data-qid='battle:agent-pane:lifecycle-toggle']",
              "assert_qs_action": "[data-qid='battle:agent-pane:lifecycle-toggle']",
              "assert_min_size": {
                "selector": "[data-qid='battle:agent-pane:lifecycle-toggle']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:pane:right-toggle']",
              "description": "Collapse right detail pane",
              "assert_title": "[data-qid='battle:pane:right-toggle']",
              "assert_qs_action": "[data-qid='battle:pane:right-toggle']",
              "assert_min_size": {
                "selector": "[data-qid='battle:pane:right-toggle']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "click",
              "target": "[data-qid='battle:pane:left-toggle']",
              "description": "Collapse left evidence pane",
              "assert_title": "[data-qid='battle:pane:left-toggle']",
              "assert_qs_action": "[data-qid='battle:pane:left-toggle']",
              "assert_min_size": {
                "selector": "[data-qid='battle:pane:left-toggle']",
                "min_width": 44,
                "min_height": 44
              }
            },
            {
              "action": "screenshot",
              "description": "Battle spectator after targeted control interactions"
            }
          ]
        }
      ]
    }
  ]
}
