{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/battle/schemas/battle.normalized_population_fixture.v1.schema.json",
  "title": "Battle Normalized Population Fixture",
  "type": "object",
  "required": [
    "schema",
    "fixture_kind",
    "battle_id",
    "run_id",
    "generated_at",
    "status",
    "mocked",
    "live",
    "proof_mode",
    "campaign",
    "generation_axis",
    "specimen_cards",
    "lineage_edges",
    "claim_boundary",
    "receipt_refs",
    "provenance",
    "copy"
  ],
  "properties": {
    "schema": { "const": "battle.normalized_population_fixture.v1" },
    "fixture_kind": { "const": "pr5_population" },
    "battle_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "const": "PASS" },
    "mocked": { "const": false },
    "live": { "const": "local_docker_specimen_fixture" },
    "proof_mode": { "const": "local_docker_specimen_population_fixture" },
    "campaign": {
      "type": "object",
      "required": ["campaign_id", "generation_count", "specimen_count", "full_population_engine_proven"],
      "properties": {
        "campaign_id": { "type": "string", "minLength": 1 },
        "generation_count": { "type": "integer", "minimum": 2 },
        "specimen_count": { "type": "integer", "minimum": 2 },
        "full_population_engine_proven": { "const": false }
      },
      "additionalProperties": true
    },
    "generation_axis": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["generation", "specimen_ids", "specimen_count"],
        "properties": {
          "generation": { "type": "integer", "minimum": 0 },
          "specimen_ids": { "type": "array", "items": { "type": "string" } },
          "specimen_count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "specimen_cards": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "specimen_id",
          "generation",
          "parent_specimen_id",
          "selected_methods",
          "provider_authorship",
          "compile_status",
          "runtime_status",
          "target_contact",
          "judge_status",
          "judge_verified_exploits",
          "fitness",
          "selection"
        ],
        "properties": {
          "specimen_id": { "type": "string", "minLength": 1 },
          "generation": { "type": "integer", "minimum": 0 },
          "parent_specimen_id": { "type": ["string", "null"] },
          "selected_methods": { "type": "array", "items": { "type": "object" } },
          "inherited_methods": { "type": "array", "items": { "type": "string" } },
          "provider_authorship": {
            "type": "object",
            "required": ["authored_by", "agentic", "provider_live"],
            "properties": {
              "authored_by": { "type": "string" },
              "agentic": { "type": "boolean" },
              "provider_live": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "compile_status": {
            "enum": ["COMPILE_FAILED", "COMPILE_PASSED", "NOT_RUN"]
          },
          "runtime_status": {
            "enum": [
              "COMPILE_FAILED",
              "RUNTIME_FAILED",
              "RUNNABLE_UNPROVEN",
              "TARGET_CONTACT_UNPROVEN",
              "POLICY_BLOCKED",
              "NOT_RUN"
            ]
          },
          "target_contact": {
            "type": "object",
            "required": ["observed", "status"],
            "properties": {
              "observed": { "type": "boolean" },
              "status": { "enum": ["NOT_OBSERVED", "TARGET_CONTACT_UNPROVEN", "NOT_RUN"] }
            },
            "additionalProperties": true
          },
          "judge_status": { "const": "NOT_RUN" },
          "judge_verified_exploits": { "const": 0 },
          "fitness": { "type": "object" },
          "selection": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "lineage_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "edge_type", "from_specimen_id", "to_specimen_id"],
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "edge_type": { "enum": ["parent_child", "recombination"] },
          "from_specimen_id": { "type": "string", "minLength": 1 },
          "to_specimen_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": ["may_claim", "must_not_claim"],
      "properties": {
        "may_claim": { "type": "array", "items": { "type": "string" } },
        "must_not_claim": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "receipt_refs": { "type": "array" },
    "provenance": { "type": "object" },
    "copy": {
      "type": "object",
      "required": ["headline", "subhead", "status_label", "boundary_notice"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "subhead": { "type": "string", "minLength": 1 },
        "status_label": { "type": "string", "minLength": 1 },
        "boundary_notice": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
