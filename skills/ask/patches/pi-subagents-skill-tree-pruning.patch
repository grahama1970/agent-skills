@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { test } from "node:test";
+import { inspectAgentDefinitionDirectory } from "../../src/agents/agents.ts";
+
+test("prunes skill and provider trees before traversing or fingerprinting their artifacts", () => {
+	const temp = fs.mkdtempSync(path.join(os.tmpdir(), "agent-skill-prune-"));
+	const root = path.join(temp, ".agents");
+	const readDirs: string[] = [];
+	try {
+		for (const dir of ["team", "skills/demo/local/deep", ".opencode/skills/demo/local", ".claude/skills/demo", ".codex/skills/demo", ".Codex/skills/demo"]) {
+			fs.mkdirSync(path.join(root, dir), { recursive: true });
+			fs.writeFileSync(path.join(root, dir, "reviewer.md"), "---\nname: reviewer\ndescription: Example\n---\nRead only.");
+		}
+		const result = inspectAgentDefinitionDirectory(root, {
+			existsSync: fs.existsSync,
+			realpathSync: fs.realpathSync,
+			statSync: fs.statSync,
+			readdirSync(dir) { readDirs.push(path.relative(root, dir)); return fs.readdirSync(dir, { withFileTypes: true }); },
+		});
+		assert.deepEqual(readDirs.sort(), ["", "team"]);
+		assert.deepEqual(result.files, [path.join(root, "team/reviewer.md")]);
+		// Explicitly selected roots remain supported, even inside provider trees.
+		assert.equal(inspectAgentDefinitionDirectory(path.join(root, ".opencode/skills/demo/local")).files.length, 1);
+	} finally {
+		fs.rmSync(temp, { recursive: true, force: true });
+	}
+});
