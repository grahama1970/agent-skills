#!/usr/bin/env python3
"""Task Monitor Client for debug-pdf skill.

Integrates with the centralized task-monitor skill by:
1. Registering tasks in ~/.pi/task-monitor/registry.json
2. Writing state files that task-monitor TUI can display
3. Updating progress per PDF (not just on completion)

Usage:
    monitor = DebugPdfTaskClient("batch-analyze-50", total_pdfs=50)
    for url in urls:
        report = analyze_pdf(url)
        monitor.update(url, report)
    monitor.finish()

View progress:
    # Via task-monitor TUI
    cd ~/.pi/skills/task-monitor
    uv run python monitor.py tui --filter debug-pdf
"""

import json
import os
import time
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Any, Optional
from loguru import logger

# Task monitor registry location
TASK_MONITOR_REGISTRY = Path.home() / ".pi" / "task-monitor" / "registry.json"
SKILL_DIR = Path(__file__).parent
STATE_FILE = SKILL_DIR / "debug_pdf_task_state.json"
ERROR_LOG = SKILL_DIR / "debug_pdf_errors.json"


@dataclass
class PatternMetrics:
    """Track detection counts per pattern."""
    detected: int = 0

    def to_dict(self) -> Dict[str, Any]:
        return {"detected": self.detected}


@dataclass
class FailureRecord:
    """Record of a PDF analysis failure."""
    url: str
    error: str
    patterns_detected: List[str]
    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())

    def to_dict(self) -> Dict[str, Any]:
        return {
            "url": self.url[:100],  # Truncate for display
            "error": self.error[:100],
            "patterns": self.patterns_detected[:5],  # Limit patterns
            "timestamp": self.timestamp,
        }


class DebugPdfTaskClient:
    """Task-monitor compatible progress tracker for debug-pdf.

    Writes state to debug_pdf_task_state.json which task-monitor TUI can display.
    """

    def __init__(
        self,
        task_name: str,
        total_pdfs: int,
        description: Optional[str] = None,
        register: bool = True,
    ):
        self.task_name = task_name
        self.total_pdfs = total_pdfs
        self.description = description or f"Debug-PDF: {task_name}"

        # Progress tracking
        self.completed = 0
        self.start_time = time.time()
        self.last_update = 0.0

        # Pattern metrics
        self.patterns: Dict[str, PatternMetrics] = {}

        # Analysis tracking
        self.download_success = 0
        self.download_failed = 0
        self.fixtures_generated = 0
        self.total_pages_analyzed = 0

        # Failure tracking
        self.failures: List[FailureRecord] = []

        # Register with task-monitor
        if register:
            self._register_task()

        # Initial state write
        self._write_state()

    def _register_task(self):
        """Register this task with task-monitor registry."""
        try:
            TASK_MONITOR_REGISTRY.parent.mkdir(parents=True, exist_ok=True)

            # Load existing registry
            registry = {}
            if TASK_MONITOR_REGISTRY.exists():
                try:
                    registry = json.loads(TASK_MONITOR_REGISTRY.read_text())
                except Exception:
                    registry = {}

            # Add/update our task
            registry[f"debug-pdf:{self.task_name}"] = {
                "state_file": str(STATE_FILE),
                "total": self.total_pdfs,
                "description": self.description,
                "project": "debug-pdf",
                "registered_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            }

            # Write atomically
            tmp = TASK_MONITOR_REGISTRY.with_suffix(".tmp")
            tmp.write_text(json.dumps(registry, indent=2))
            os.replace(tmp, TASK_MONITOR_REGISTRY)
        except Exception as e:
            logger.debug("debug-pdf task monitor registry write failed: {}", e)

    def _write_state(self, final: bool = False):
        """Update task-monitor state file."""
        now = time.time()

        # Throttle updates (max every 0.3s unless final)
        if not final and (now - self.last_update) < 0.3:
            return
        self.last_update = now

        elapsed = now - self.start_time
        progress_pct = (self.completed / self.total_pdfs * 100) if self.total_pdfs > 0 else 0

        # Calculate ETA
        eta_seconds = None
        if self.completed > 0 and self.completed < self.total_pdfs:
            rate = self.completed / elapsed
            remaining = self.total_pdfs - self.completed
            eta_seconds = remaining / rate if rate > 0 else None

        # Calculate download success rate
        total_downloads = self.download_success + self.download_failed
        download_rate = self.download_success / total_downloads if total_downloads > 0 else 0.0

        state = {
            "completed": self.completed,
            "total": self.total_pdfs,
            "description": self.description,
            "current_item": f"PDF {self.completed + 1}/{self.total_pdfs}",
            "progress_pct": round(progress_pct, 1),
            "elapsed_seconds": round(elapsed, 1),
            "eta_seconds": round(eta_seconds, 1) if eta_seconds else None,
            "patterns": {name: metrics.to_dict() for name, metrics in self.patterns.items()},
            "stats": {
                "download_success": self.download_success,
                "download_failed": self.download_failed,
                "download_rate": round(download_rate, 4),
                "fixtures_generated": self.fixtures_generated,
                "total_pages": self.total_pages_analyzed,
                "unique_patterns": len(self.patterns),
            },
            "failures": [f.to_dict() for f in self.failures[-20:]],  # Last 20
            "last_updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "status": "completed" if final else "running",
        }

        # Write atomically
        try:
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(state, indent=2))
            os.replace(tmp, STATE_FILE)
        except Exception as e:
            logger.debug("tmp failed: {}", e)

    def update(
        self,
        url: str,
        download_success: bool,
        patterns_detected: List[str],
        pages: int = 0,
        fixture_generated: bool = False,
        error: Optional[str] = None,
    ):
        """Update progress after analyzing a PDF.

        Args:
            url: The URL that was analyzed
            download_success: Whether the PDF was downloaded successfully
            patterns_detected: List of pattern names detected
            pages: Number of pages in the PDF
            fixture_generated: Whether a fixture was generated
            error: Error message if failed
        """
        self.completed += 1

        if download_success:
            self.download_success += 1
        else:
            self.download_failed += 1

        if fixture_generated:
            self.fixtures_generated += 1

        self.total_pages_analyzed += pages

        # Update pattern metrics
        for pattern in patterns_detected:
            if pattern not in self.patterns:
                self.patterns[pattern] = PatternMetrics()
            self.patterns[pattern].detected += 1

        # Record failures
        if not download_success or error:
            self.failures.append(FailureRecord(
                url=url,
                error=error or "Download failed",
                patterns_detected=patterns_detected,
            ))

        self._write_state()

    def finish(self, success: bool = True):
        """Mark the task as complete."""
        self._write_state(final=True)

        # Persist errors to log file
        if self.failures:
            try:
                error_data = {
                    "task_name": self.task_name,
                    "completed_at": datetime.now().isoformat(),
                    "success": success,
                    "total_pdfs": self.total_pdfs,
                    "total_failures": len(self.failures),
                    "patterns": {name: metrics.to_dict() for name, metrics in self.patterns.items()},
                    "failures": [f.to_dict() for f in self.failures],
                }
                tmp = ERROR_LOG.with_suffix(".tmp")
                tmp.write_text(json.dumps(error_data, indent=2))
                os.replace(tmp, ERROR_LOG)
            except Exception as e:
                logger.debug("value lookup failed: {}", e)

    def get_summary(self) -> Dict[str, Any]:
        """Get a summary for logging/reporting."""
        elapsed = time.time() - self.start_time
        total_downloads = self.download_success + self.download_failed
        return {
            "task_name": self.task_name,
            "completed": self.completed,
            "total": self.total_pdfs,
            "elapsed_seconds": round(elapsed, 1),
            "download_rate": self.download_success / total_downloads if total_downloads > 0 else 0,
            "fixtures_generated": self.fixtures_generated,
            "unique_patterns": len(self.patterns),
        }


# Convenience functions for simple usage
_current_client: Optional[DebugPdfTaskClient] = None


def start_monitoring(task_name: str, total_pdfs: int) -> DebugPdfTaskClient:
    """Start monitoring a new debug-pdf task."""
    global _current_client
    _current_client = DebugPdfTaskClient(task_name, total_pdfs)
    return _current_client


def get_monitor() -> Optional[DebugPdfTaskClient]:
    """Get the current task monitor."""
    return _current_client


def end_monitoring(success: bool = True):
    """End the current task monitoring."""
    global _current_client
    if _current_client:
        _current_client.finish(success)
        _current_client = None
