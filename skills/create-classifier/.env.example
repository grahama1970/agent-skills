# Environment Configuration for Create Classifier Skill

# Data Collection
CORPUS_PATH=/path/to/extractor/corpus
LABELS_OUTPUT_DIR=data/labels

# Training
TRAINING_DEVICE=cuda  # or 'cpu'
BATCH_SIZE=16
LEARNING_RATE=0.001
EPOCHS=20

# Model Paths
MODELS_DIR=models
CACHE_DIR=.cache

# Confidence Routing
CONFIDENCE_THRESHOLD=0.8

# Shadow Deployment
SHADOW_DEPLOY_DURATION_DAYS=7
SHADOW_LOG_PATH=logs/shadow_deploy.jsonl

# GRPO Training (Execution Feedback)
GRPO_ENABLED=false
GRPO_NUM_ITERATIONS=100
GRPO_REWARD_FN=validate_pipeline_success

# Chutes API (for potential LLM-assisted labeling)
CHUTES_API_KEY=your_key_here
CHUTES_API_BASE=https://llm.chutes.ai/v1
