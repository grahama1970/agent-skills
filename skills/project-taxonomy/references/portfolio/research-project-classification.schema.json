{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grahama.co/schemas/research-project-classification.v1.json",
  "title": "Research Project Classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "portfolio_class",
    "system_roles",
    "methods",
    "domains",
    "lifecycle_stage",
    "origin",
    "counting_status",
    "boundary_to_preserve",
    "classification_confidence"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^grahama1970/[A-Za-z0-9_.-]+$"
    },
    "recent_activity_theme": {
      "type": "string",
      "minLength": 1
    },
    "program_family": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "autonomous-systems",
        "evidence-assurance",
        "human-centered-ai",
        null
      ]
    },
    "primary_area": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "agent-systems",
        "memory-knowledge",
        "extraction-document-intelligence",
        "research-intelligence",
        "security-adaptive-defense",
        "governance-compliance",
        "verification-formal-methods",
        "model-systems-learning",
        "multimodal-persona-interaction",
        "creative-media-design",
        null
      ]
    },
    "secondary_area": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "agent-systems",
        "memory-knowledge",
        "extraction-document-intelligence",
        "research-intelligence",
        "security-adaptive-defense",
        "governance-compliance",
        "verification-formal-methods",
        "model-systems-learning",
        "multimodal-persona-interaction",
        "creative-media-design",
        null
      ]
    },
    "portfolio_class": {
      "type": "string",
      "enum": [
        "adapted-platform",
        "adapted-research-component",
        "application-workbench",
        "evaluation-fixture",
        "portfolio-collateral",
        "public-projection",
        "research-component",
        "research-infrastructure",
        "research-platform",
        "research-system"
      ]
    },
    "system_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "collateral",
        "fixture",
        "operational",
        "projection",
        "prototype"
      ]
    },
    "origin": {
      "type": "string"
    },
    "counting_status": {
      "type": "string",
      "enum": [
        "count",
        "count-local-delta-only",
        "exclude-adapted-platform",
        "exclude-evaluation-fixture",
        "exclude-portfolio-collateral",
        "exclude-public-projection"
      ]
    },
    "boundary_to_preserve": {
      "type": "string",
      "minLength": 20
    },
    "classification_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "suggested_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "counting_status": {
            "enum": [
              "count",
              "count-local-delta-only"
            ]
          }
        }
      },
      "then": {
        "required": [
          "primary_area",
          "program_family"
        ],
        "properties": {
          "primary_area": {
            "type": "string"
          },
          "program_family": {
            "type": "string"
          }
        }
      }
    }
  ]
}
