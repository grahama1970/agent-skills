      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "leak-test PASS: client path in, resource_class+count out, no path segments"
        ]
      },
      "readback": true,
      "evidence_class": "live_e2e",
      "supports_claims": [
        "service_privacy.owner_confidentiality"
      ]
    }
  ],
