{
  "version": 2,
  "skill": "ubuntu-service-privacy",
  "trials": 3,
  "proof_scope": "Deterministic mechanism tests and native userspace parsers; no live kernel confinement or actual Kolide qualification.",
  "claims": {
    "proves": "Strict inputs, deterministic generation, tamper handling, owner approval, and failure-state transaction behavior.",
    "does_not_prove": "Unrelated proprietary/controlled information is inaccessible in every representation; actual Kolide compatibility; runtime confinement; ITAR compliance."
  },
  "capability_claims": [
    {
      "id": "service_privacy.owner_confidentiality",
      "description": "Employer Device Trust must not obtain unrelated proprietary or controlled work in any representation or access path.",
      "criticality": "critical",
      "evidence_required": {
        "deterministic": true,
        "live_e2e": true,
        "human_evaluation": true
      }
    },
    {
      "id": "service_privacy.policy_mechanisms",
      "description": "Typed rejection, deterministic rendering, and explicit owner-approved transaction controls.",
      "criticality": "important",
      "evidence_required": {
        "deterministic": true
      }
    }
  ],
  "cases": [
    {
      "name": "policy-delta-adversarial-corpus",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../scripts/policy_delta_corpus_driver.sh"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "corpus 8/8 rejected + good accepted=yes"
        ]
      },
      "readback": false,
      "evidence_class": "live_e2e",
      "supports_claims": [
        "service_privacy.owner_confidentiality"
      ]
    },
    {
      "name": "live-doctor-entrypoint",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "doctor"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"status\":\"PASS\""
        ]
      },
      "readback": true,
      "evidence_class": "live_e2e",
      "supports_claims": [
        "service_privacy.policy_mechanisms"
      ]
    },
    {
      "name": "policy-and-artifact-positive",
      "type": "positive",
      "command": [
        "bash",
        "../sanity.sh",
        "-k",
        "test_private_artifact_roundtrip or test_render_is_deterministic_and_profile_inherits or test_real_apparmor_parser"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "passed"
        ]
      },
      "readback": true,
      "evidence_class": "deterministic",
      "supports_claims": [
        "service_privacy.policy_mechanisms"
      ]
    },
    {
      "name": "unconfined-probe-negative",
      "type": "negative",
      "command": [
        "bash",
        "../sanity.sh",
        "-k",
        "test_real_probe_does_not_pass_unconfined"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "passed"
        ]
      },
      "readback": true,
      "evidence_class": "deterministic",
      "supports_claims": [
        "service_privacy.policy_mechanisms"
      ]
    },
    {
      "name": "live-change-snapshot-entrypoint",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "../run.sh",
        "change-snapshot",
        "--unit",
        "launcher.kolide-k2.service"
      ],
      "expected": {
        "exit_code": 2,
