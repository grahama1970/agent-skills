{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotated-lyrics.schema.json",
  "title": "Annotated Lyrics",
  "description": "Per-syllable annotated lyrics for music generation with timing, emotion, and vocal direction",
  "type": "object",
  "required": ["title", "bpm", "time_signature", "key", "phrases"],
  "properties": {
    "title": { "type": "string" },
    "artist": { "type": "string" },
    "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
    "time_signature": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
    "key": { "type": "string", "pattern": "^[A-G][#b]?\\s*(major|minor|maj|min|m)?$" },
    "genre_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "section", "bar", "beat"],
        "properties": {
          "text": { "type": "string" },
          "section": {
            "type": "string",
            "enum": ["verse", "chorus", "bridge", "intro", "outro", "pre-chorus", "hook", "interlude", "ad-lib"]
          },
          "bar": { "type": "integer", "minimum": 1 },
          "beat": { "type": "number", "minimum": 1 },
          "duration_beats": { "type": "number", "minimum": 0.25 },
          "emotion": {
            "type": "string",
            "enum": ["anger", "fear", "joy", "neutral", "sadness", "trust"]
          },
          "dynamics": {
            "type": "string",
            "enum": ["pp", "p", "mp", "mf", "f", "ff"]
          },
          "vocal_direction": {
            "type": "string",
            "enum": ["whisper", "speak", "sing", "belt", "falsetto", "growl", "rap"]
          },
          "syllables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "beat"],
              "properties": {
                "text": { "type": "string" },
                "beat": { "type": "number", "minimum": 1 },
                "hold_beats": { "type": "number", "minimum": 0.125 },
                "stress": { "type": "boolean" },
                "pitch_hint": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
