{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piano-roll-spec.schema.json",
  "title": "Piano Roll Spec",
  "description": "Ground truth specification for what a song SHOULD sound like — the agent's sheet music",
  "type": "object",
  "required": ["bpm", "time_signature", "key", "total_bars", "sections"],
  "properties": {
    "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
    "time_signature": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
    "key": { "type": "string" },
    "total_bars": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_name", "start_bar", "end_bar"],
        "properties": {
          "section_name": { "type": "string" },
          "start_bar": { "type": "integer", "minimum": 1 },
          "end_bar": { "type": "integer", "minimum": 1 },
          "chord_progression": {
            "type": "array",
            "items": { "type": "string" }
          },
          "energy_curve": {
            "type": "array",
            "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pitch", "start_beat", "duration_beats", "instrument"],
        "properties": {
          "pitch": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 127 },
              { "type": "string", "pattern": "^[A-G][#b]?[0-9]$" }
            ]
          },
          "start_beat": { "type": "number", "minimum": 0 },
          "duration_beats": { "type": "number", "minimum": 0.0625 },
          "velocity": { "type": "integer", "minimum": 0, "maximum": 127 },
          "instrument": {
            "type": "string",
            "enum": ["vocal", "guitar", "bass", "drums", "keys", "synth", "strings", "brass", "pad"]
          }
        }
      }
    }
  }
}
