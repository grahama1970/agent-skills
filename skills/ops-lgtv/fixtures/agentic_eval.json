{
  "version": 2,
  "skill": "ops-lgtv",
  "trials": 2,
  "proof_scope": "fail-closed and mutation-gating boundaries plus ops-wiim composition wiring; live TV cases require human pairing",
  "claims": {
    "proves": "unreachable TVs fail closed with exit 2; sound-output mutation is refused without --execute; gain-staging composes the real ops-wiim entrypoint",
    "does_not_prove": "paired live TV control, Digital Sound Out/Auto Volume state, or firmware-specific SSAP behavior"
  },
  "cases": [
    {
      "name": "unreachable-tv-fails-closed",
      "type": "negative",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh sound --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 2,
        "stderr_contains": [
          "\"status\": \"down\""
        ]
      }
    },
    {
      "name": "mutation-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh set-sound-output external_arc --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "gain-staging-composes-live-ops-wiim",
      "type": "positive",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh gain-staging --ip 127.0.0.1 --wiim-ip \"${WIIM_IP:-192.168.86.111}\" 2>&1; test $? -eq 2"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "\"status\": \"down\""
        ]
      }
    },
    {
      "name": "power-off-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh power-off --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "pair-refused-localhost-fails-closed",
      "type": "negative",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh pair --ip 127.0.0.1 --attempts 1"
      ],
      "expected": {
        "exit_code": 2,
        "stderr_contains": [
          "\"paired\": false"
        ]
      }
    },
    {
      "name": "power-on-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh power-on --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "tv-set-volume-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh set-volume 50 --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "open-youtube-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh open-youtube dQw4w9WgXcQ --ip 127.0.0.1"
      ],
      "expected": {
        "exit_code": 3,
        "stderr_contains": [
          "--execute"
        ]
      }
    },
    {
      "name": "press-refused-without-execute",
      "type": "adversarial",
