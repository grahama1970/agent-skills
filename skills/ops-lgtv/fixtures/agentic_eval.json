        ]
      }
    },
    {
      "name": "set-mute-refused-without-execute",
      "type": "adversarial",
      "real_world": true,
      "command": [
        "bash",
        "-c",
        "../run.sh set-mute on --ip 127.0.0.1"
      ],
      "expected": {
