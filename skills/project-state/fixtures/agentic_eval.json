   ],
   "expected": {
    "exit_code": 0,
    "stdout_contains": [
     "SCOPE_OK"
    ],
    "stderr_contains": []
   }
  },
  {
   "name": "global-skills-count-for-skill-target-is-refused",
   "type": "adversarial",
