   "timeout_seconds": 900,
   "command": [
    "bash",
    "-c",
    "cd /home/graham/workspace/experiments/agent-skills/skills/project-state && uv run python scripts/assert_report_scope.py --target /home/graham/workspace/experiments/agent-skills/skills/pitchdeck --min-skills 100"
   ],
