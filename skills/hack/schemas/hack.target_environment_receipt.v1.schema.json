{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hack.target_environment_receipt.v1.schema.json",
  "title": "Hack Target Environment Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment_version",
    "status",
    "authorization_manifest_sha256",
    "sanitized_compose_path",
    "sanitized_compose_sha256",
    "compose_source_path",
    "compose_source_sha256",
    "allowlisted_variable_names",
    "generated_value_hashes",
    "rejected_variable_references",
    "redaction_count",
    "inherited_operator_environment",
    "mocked",
    "live",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "hack.target_environment_receipt.v1"},
    "environment_version": {"const": "hack.target-environment.v1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "authorization_manifest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "sanitized_compose_path": {"type": "string", "minLength": 1},
    "sanitized_compose_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "compose_source_path": {"type": "string", "minLength": 1},
    "compose_source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "allowlisted_variable_names": {"type": "array", "items": {"type": "string"}},
    "generated_value_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
    "rejected_variable_references": {"type": "array", "items": {"type": "string"}},
    "redaction_count": {"type": "integer", "minimum": 0},
    "inherited_operator_environment": {"const": false},
    "mocked": {"const": false},
    "live": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
