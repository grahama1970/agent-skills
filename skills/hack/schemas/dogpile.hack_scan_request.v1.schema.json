{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dogpile.hack_scan_request.v1.schema.json",
  "title": "Dogpile Hack Scan Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "created_at",
    "expires_at",
    "target",
    "source_packet",
    "selected_source_evidence",
    "requested_scan",
    "execution_mode",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "dogpile.hack_scan_request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonical_id", "immutable_ref"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1
        },
        "immutable_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_url": {
          "type": "string"
        }
      }
    },
    "source_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_path", "sha256"],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "selected_source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "provider",
          "source_type",
          "retrieval_artifact",
          "content_sha256",
          "retrieved_at",
          "source_bearing"
        ],
        "anyOf": [
          {
            "required": ["url"]
          },
          {
            "required": ["repository"]
          }
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "repository_ref": {
            "type": "string"
          },
          "retrieval_artifact": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_bearing": {
            "type": "boolean"
          }
        }
      }
    },
    "requested_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lanes", "profile"],
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "sast",
              "sca",
              "dast",
              "dependency_review",
              "repository_static_review",
              "config_review"
            ]
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_mode": {
      "const": "no_docker_validation_only"
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "research_design_input_only"
      }
    }
  }
}
