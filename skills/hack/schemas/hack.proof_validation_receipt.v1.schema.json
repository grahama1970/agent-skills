{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hack.proof_validation_receipt.v1.schema.json",
  "title": "Hack Proof Validation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "validation_id",
    "created_at",
    "validator_identity",
    "validator_authority",
    "validator_independent",
    "status",
    "observation_id",
    "observation_artifact_sha256",
    "target_identity",
    "target_runtime_sha256",
    "authorization_manifest_sha256",
    "scan_request_sha256",
    "probe_spec_sha256",
    "replay_spec_sha256",
    "replay_spec_artifact",
    "replay_receipt_sha256",
    "replay_receipt_artifact",
    "replay_command",
    "confirms_exploit",
    "mocked",
    "live",
    "errors",
    "non_claims"
  ],
  "properties": {
    "schema": {"const": "hack.proof_validation_receipt.v1"},
    "validation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "validator_identity": {"type": "string", "minLength": 1},
    "validator_authority": {"type": "string", "minLength": 1},
    "validator_independent": {"const": true},
    "status": {"enum": ["CONFIRMED", "REJECTED", "VALIDATION_ERROR"]},
    "observation_id": {"type": "string", "minLength": 1},
    "observation_artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "target_identity": {"type": "string", "minLength": 1},
    "target_runtime_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "authorization_manifest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "scan_request_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "probe_spec_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "replay_spec_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "replay_spec_artifact": {"type": "string", "minLength": 1},
    "replay_receipt_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "replay_receipt_artifact": {"type": "string", "minLength": 1},
    "replay_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confirms_exploit": {"type": "boolean"},
    "mocked": {"const": false},
    "live": {"type": "string", "minLength": 1},
    "errors": {"type": "array", "items": {"type": "string"}},
    "non_claims": {
      "type": "array",
      "items": {"type": "string"},
      "contains": {"const": "validation_receipt_is_not_patch_proof"}
    }
  }
}
