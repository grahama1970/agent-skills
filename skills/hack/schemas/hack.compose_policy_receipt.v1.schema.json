{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hack.compose_policy_receipt.v1.schema.json",
  "title": "Hack Compose Policy Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "status",
    "source_compose_path",
    "source_compose_sha256",
    "normalized_model_sha256",
    "sanitized_compose_path",
    "sanitized_compose_sha256",
    "authorization_manifest_path",
    "authorization_manifest_sha256",
    "allowed_features",
    "rejected_features",
    "execution_started",
    "mocked",
    "live",
    "non_claims",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "hack.compose_policy_receipt.v1"},
    "policy_version": {"const": "hack.compose-policy.v1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "source_compose_path": {"type": "string", "minLength": 1},
    "source_compose_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "normalized_model_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "sanitized_compose_path": {"type": ["string", "null"]},
    "sanitized_compose_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "authorization_manifest_path": {"type": "string", "minLength": 1},
    "authorization_manifest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "allowed_features": {"type": "array", "items": {"type": "string"}},
    "rejected_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "field", "code", "message"],
        "properties": {
          "service": {"type": "string"},
          "field": {"type": "string"},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "execution_started": {"type": "boolean"},
    "execution_started_at": {"type": "string"},
    "mocked": {"const": false},
    "live": {"type": "string", "minLength": 1},
    "non_claims": {
      "type": "array",
      "items": {"type": "string"},
      "contains": {"const": "compose_policy_does_not_start_target"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
