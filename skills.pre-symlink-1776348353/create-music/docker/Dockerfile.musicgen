# MusicGen CLI - uses pre-built audiocraft image
# Based on ashleykza/audiocraft which has audiocraft pre-installed
FROM mrloldev/musicgen:latest

# Install typer + rich for CLI
RUN pip install --no-cache-dir typer rich

WORKDIR /app

# Copy the musicgen wrapper script
COPY musicgen_wrapper.py /app/

# Override the default entrypoint (web UI) with our CLI
ENTRYPOINT ["python", "/app/musicgen_wrapper.py"]
